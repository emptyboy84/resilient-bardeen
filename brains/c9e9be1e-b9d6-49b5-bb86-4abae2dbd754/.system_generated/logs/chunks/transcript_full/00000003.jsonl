tPhone(phone) {\n  if (!phone || typeof phone !== 'string') return '';\n  phone = phone.replace(/[^0-9]/g, '');\n  if (!phone || phone.length < 8) return '';\n  \n  if (phone.startsWith('02')) {\n    if (phone.length === 9) return phone.replace(/(\\d{2})(\\d{3})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 10) return phone.replace(/(\\d{2})(\\d{4})(\\d{4})/, '$1-$2-$3');\n  } else if (phone.startsWith('0507') || phone.startsWith('0504') || phone.startsWith('0505') || phone.startsWith('0502') || phone.startsWith('070') || phone.startsWith('010')) {\n    if (phone.length === 11) return phone.replace(/(\\d{4})(\\d{3,4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 12) return phone.replace(/(\\d{4})(\\d{4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 10) return phone.replace(/(\\d{3})(\\d{3})(\\d{4})/, '$1-$2-$3');\n  } else {\n    if (phone.length === 10) return phone.replace(/(\\d{3})(\\d{3})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 11) return phone.replace(/(\\d{3})(\\d{4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 8) return phone.replace(/(\\d{4})(\\d{4})/, '$1-$2');\n  }\n  return phone;\n}\n\nfunction isValidCorpNo(corpNo) {\n  if (!corpNo) return false;\n  const clean = corpNo.replace(/[^0-9]/g, '');\n  if (clean.length !== 13) return false;\n  const weights = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2];\n  let sum = 0;\n  for (let i = 0; i < 12; i++) {\n    sum += Number(clean[i]) * weights[i];\n  }\n  const remainder = sum % 10;\n  const checkDigit = (10 - remainder) % 10;\n  return Number(clean[12]) === checkDigit;\n}\n\n// Category fallback dictionary\nconst categoryMap = {\n  '전자상거래': { large: '도매 및 소매업', mid: '소매업; 자동차 제외', small: '무점포 소매업' },\n  '통신판매': { large: '도매 및 소매업', mid: '소매업; 자동차 제외', small: '무점포 소매업' },\n  '쇼핑몰': { large: '도매 및 소매업', mid: '소매업; 자동차 제외', small: '무점포 소매업' },\n  '공동물류': { large: '도매 및 소매업', mid: '소매업; 자동차 제외', small: '무점포 소매업' },\n  '자사몰': { large: '도매 및 소매업', mid: '소매업; 자동차 제외', small: '무점포 소매업' },\n  '금형': { l