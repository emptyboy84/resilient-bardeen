{"step_index":93,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-30T01:52:02Z","content":"Created At: 2026-09-30T10:52:02+09:00\nCompleted At: 2026-09-30T10:52:03+09:00\n\nThe command exited with code 0.\nOutput:\nnode -e \"\nconst fs = require('fs');\nconst ExcelJS = require('exceljs');\n\nasync function updateFactCheckedExcel() {\n  const filePath = 'C:\\\\\\\\Users\\\\\\\\lg\\\\\\\\Desktop\\\\\\\\오늘\\\\\\\\(데이터검증팀)실사 DB 취합_전달용_260720_배현명.xlsx';\n  const backupSrc = 'C:\\\\\\\\Users\\\\\\\\lg\\\\\\\\Desktop\\\\\\\\오늘\\\\\\\\(데이터검증팀)실사 DB 취합_전달용_260720_배현명_backup_11847_12346.xlsx';\n  \n  console.log('Reading fact-checked TSV...');\n  const tsvLines = fs.readFileSync('all_500_factchecked.tsv', 'utf-8').split('\\n').filter(l => l.trim().length > 0);\n  \n  console.log('Loading workbook...');\n  const workbook = new ExcelJS.Workbook();\n  await workbook.xlsx.readFile(filePath);\n  const sheet = workbook.getWorksheet('기업 정보');\n  \n  const orangeFill = {\n    type: 'pattern',\n    pattern: 'solid',\n    fgColor: { argb: 'FFFFA500' } // Standard Orange\n  };\n  \n  let modifiedCellCount = 0;\n  \n  for (let i = 0; i < tsvLines.length; i++) {\n    const rowNum = 11847 + i;\n    const row = sheet.getRow(rowNum);\n    const p = tsvLines[i].split('\\t');\n    \n    // p[0]: 담당자, p[1]: 상태, p[2]: 회사명, p[3]: 사업자번호, p[4]: 대표자, p[5]: 우편번호, p[6]: 주소, p[7]: 전화번호, p[8]: 팩스번호, p[9]: 홈페이지, p[10]: 이메일, p[11]: 종업원수, p[12]: 업종, p[13]: 법인번호, p[14]: 결산월, p[15]: 대, p[16]: 중, p[17]: 소\n    \n    const biznoClean = p[3] ? p[3].replace(/[^0-9]/g, '') : '';\n    const biznoUrl = biznoClean ? 'https://bizno.net/article/' + biznoClean : '';\n    \n    const newValues = {\n      1: p[0] || '배현명',\n      2: p[1] || null,\n      3: p[2] || null,\n      4: p[3] ? (biznoUrl ? { text: p[3], hyperlink: biznoUrl } : (isNaN(p[3]) ? p[3] : Number(p[3]))) : null,\n      5: p[4] || null,\n      6: p[5] ? (isNaN(p[5]) ? p[5] : Number(p[5])) : null,\n      7: p[6] || null,\n      8: p[7] || null,\n      9: p[8] || null,\n      10: p[9] || null,\n      11: p[10] || null,\n      15: p[11] ? (isNaN(p[11]) ? p[11] : Number(p[11])) : null,\n      18: p[12] || null,\n      25: p[13] || null,\n      31: p[14] || null,\n      48: p[15] || null,\n      49: p[16] || null,\n      50: p[17] || null\n    };\n    \n    for (const [colStr, newVal] of Object.entries(newValues)) {\n      const col = Number(colStr);\n      const origCell = row.getCell(col);\n      const origVal = origCell.value;\n      \n      const normOrig = origVal === null || origVal === undefined ? '' : String(typeof origVal === 'object' && origVal.text ? origVal.text : origVal).trim();\n      const normNew = newVal === null || newVal === undefined ? '' : String(typeof newVal === 'object' && newVal.text ? newVal.text : newVal).trim();\n      \n      origCell.value = newVal;\n      \n      // If cell is populated or modified from original, ensure orange fill\n      if (normNew !== '') {\n        origCell.fill = orangeFill;\n        modifiedCellCount++;\n      }\n    }\n    \n    row.commit();\n  }\n  \n  console.log('Total cells formatted & styled orange across 500 rows:', modifiedCellCount);\n  console.log('Writing file to temp...');\n  const tempPath = filePath + '.tmp';\n  await workbook.xlsx.writeFile(tempPath);\n  \n  console.log('Overwriting target file...');\n  if (fs.existsSync(filePath)) {\n    fs.unlinkSync(filePath);\n  }\n  fs.renameSync(tempPath, filePath);\n  \n  console.log('Fact check Excel save complete! File size:', fs.statSync(filePath).size);\n}\n\nupdateFactCheckedExcel().catch(console.error);\n\"\n\n"}
