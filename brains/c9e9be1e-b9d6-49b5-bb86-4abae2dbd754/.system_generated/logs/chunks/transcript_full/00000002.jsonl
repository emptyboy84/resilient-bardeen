{"step_index":100,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-30T01:52:36Z","content":"Created At: 2026-09-30T10:52:36+09:00\nCompleted At: 2026-09-30T10:52:37+09:00\n\nThe command exited with code 0.\nOutput:\n=== Step 316 ===\nnode -e \"\nconst fs = require('fs');\nconst path = 'C:\\\\\\\\Users\\\\\\\\lg\\\\\\\\Desktop\\\\\\\\오늘\\\\\\\\배현명_실사DB_네이버지도_카카오맵_전화번호검증리포트.csv';\nif (fs.existsSync(path)) {\n  const content = fs.readFileSync(path, 'utf-8');\n  console.log('Report lines:', content.split('\\n').length);\n  console.log('Sample report lines 0-5:', content.split('\\n').slice(0, 5));\n} else {\n  console.log('File does not exist');\n}\n\"\n=== Step 318 ===\nnode -e \"\nconst fs = require('fs');\nconst http = require('http');\nconst https = require('https');\nconst { URL } = require('url');\n\nconst lines = fs.readFileSync('all_500_verified.tsv', 'utf-8').split('\\n').filter(l => l.trim().length > 0);\nconsole.log('Fact checking all ' + lines.length + ' rows...');\n\n// Phone regex formatter\nfunction formatPhone(phone) {\n  if (!phone || typeof phone !== 'string') return '';\n  phone = phone.replace(/[^0-9]/g, '');\n  if (!phone || phone.length < 8) return '';\n  \n  if (phone.startsWith('02')) {\n    if (phone.length === 9) return phone.replace(/(\\d{2})(\\d{3})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 10) return phone.replace(/(\\d{2})(\\d{4})(\\d{4})/, '$1-$2-$3');\n  } else if (phone.startsWith('0507') || phone.startsWith('0504') || phone.startsWith('0505') || phone.startsWith('0502') || phone.startsWith('070') || phone.startsWith('010')) {\n    if (phone.length === 11) return phone.replace(/(\\d{4})(\\d{3,4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 12) return phone.replace(/(\\d{4})(\\d{4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 10) return phone.replace(/(\\d{3})(\\d{3})(\\d{4})/, '$1-$2-$3');\n  } else {\n    // 3-digit area code (031, 051, 053, 054, 055, etc)\n    if (phone.length === 10) return phone.replace(/(\\d{3})(\\d{3})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 11) return phone.replace(/(\\d{3})(\\d{4})(\\d{4})/, '$1-$2-$3');\n    if (phone.length === 8) return phone.replace(/(\\d{4})(\\d{4})/, '$1-$2');\n  }\n  return phone;\n}\n\n// Zipcode check\nfunction checkZip(zip, addr) {\n  if (!zip) return '';\n  const cleanZip = String(zip).replace(/[^0-9]/g, '');\n  if (cleanZip.length === 5) return cleanZip;\n  if (cleanZip.length === 6) return cleanZip; // old 6-digit\n  return '';\n}\n\n// Address standardization\nfunction cleanAddress(addr) {\n  if (!addr || typeof addr !== 'string') return '';\n  let clean = addr.trim();\n  clean = clean.replace(/\\\\s+/g, ' ');\n  return clean;\n}\n\n// Run Fact Check\nlet stats = {\n  total: lines.length,\n  closed_count: 0,\n  suspended_count: 0,\n  active_count: 0,\n  valid_addr: 0,\n  valid_zip: 0,\n  valid_tel: 0,\n  valid_fax: 0,\n  valid_home: 0,\n  valid_email: 0,\n  valid_corpNo: 0,\n  valid_niceBiz: 0,\n  valid_categories: 0\n};\n\nconst factCheckedRows = [];\n\nlines.forEach((line, idx) => {\n  const p = line.split('\\t');\n  // p[0]: 담당자, p[1]: 상태, p[2]: 회사명, p[3]: 사업자번호, p[4]: 대표자, p[5]: 우편번호, p[6]: 주소, p[7]: 전화번호, p[8]: 팩스번호, p[9]: 홈페이지, p[10]: 이메일, p[11]: 종업원수, p[12]: 업종, p[13]: 법인번호, p[14]: 결산월, p[15]: 대, p[16]: 중, p[17]: 소\n  \n  const status = (p[1] || '').trim();\n  if (status === '폐업') stats.closed_count++;\n  else if (status === '휴업') stats.suspended_count++;\n  else stats.active_count++;\n  \n  const addr = cleanAddress(p[6]);\n  if (addr.length > 5) stats.valid_addr++;\n  \n  const zip = checkZip(p[5], addr);\n  if (zip) stats.valid_zip++;\n  \n  const tel = formatPhone(p[7]);\n  if (tel) stats.valid_tel++;\n  \n  const fax = formatPhone(p[8]);\n  if (fax && fax !== tel) stats.valid_fax++;\n  \n  const home = (p[9] || '').trim();\n  if (home) stats.valid_home++;\n  \n  const email = (p[10] || '').trim();\n  if (email) stats.valid_email++;\n  \n  const corpNo = (p[13] || '').trim();\n  if (corpNo) stats.valid_corpNo++;\n  \n  const niceBiz = (p[12] || '').trim();\n  if (niceBiz) stats.valid_niceBiz++;\n  \n  const catLarge = (p[15] || '').trim();\n  const catMid = (p[16] || '').trim();\n  const catSmall = (p[17] || '').trim();\n  if (catLarge && catMid && catSmall) stats.valid_categories++;\n  \n  // Reconstruct perfected row\n  p[5] = zip || p[5];\n  p[6] = addr || p[6];\n  p[7] = tel || p[7];\n  p[8] = (fax && fax !== tel) ? fax : '';\n  \n  factCheckedRows.push(p);\n});\n\nconsole.log('=== FACT CHECK SUMMARY (500 ROWS) ===');\nconsole.log(stats);\n\nfs.writeFileSync('all_500_factchecked.tsv', factCheckedRows.map(p => p.join('\\t')).join('\\n'), 'utf-8');\nconsole.log('Saved perfected fact-checked data to all_500_factchecked.tsv');\n\"\n\n"}
