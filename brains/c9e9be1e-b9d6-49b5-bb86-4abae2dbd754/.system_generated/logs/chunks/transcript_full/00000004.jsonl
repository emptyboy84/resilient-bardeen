축 기술, 엔지니어링 및 기타 과학기술 서비스업', small: '건축 기술, 엔지니어링 및 관련 기술 서비스업' },\n  '토목설계': { large: '전문, 과학 및 기술 서비스업', mid: '건축 기술, 엔지니어링 및 기타 과학기술 서비스업', small: '건축 기술, 엔지니어링 및 관련 기술 서비스업' },\n  '연구개발': { large: '전문, 과학 및 기술 서비스업', mid: '연구개발업', small: '자연과학 및 공학 연구개발업' },\n  '디자인': { large: '전문, 과학 및 기술 서비스업', mid: '전문 서비스업', small: '전문 디자인업' },\n  '건설': { large: '건설업', mid: '종합 건설업', small: '건물 건설업' },\n  '신문': { large: '정보통신업', mid: '출판업', small: '신문, 잡지 및 정기간행물 출판업' },\n  '게임': { large: '정보통신업', mid: '출판업', small: '소프트웨어 개발 및 공급업' },\n  '제본': { large: '제조업', mid: '인쇄 및 기록매체 복제업', small: '인쇄 및 인쇄관련 산업' },\n  '나무제품': { large: '제조업', mid: '목재 및 나무제품 제조업; 가구 제외', small: '기타 목재 및 나무제품 제조업' },\n  '조경': { large: '건설업', mid: '전문직별 공사업', small: '기반조성 및 시설물 축조관련 전문공사업' },\n  '음식': { large: '숙박 및 음식점업', mid: '음식점 및 주점업', small: '음식점업' },\n  '운송': { large: '운수 및 창고업', mid: '육상 운송 및 파이프라인 운송업', small: '화물자동차 운송업' },\n  '사업 지원': { large: '사업시설 관리, 사업 지원 및 임대 서비스업', mid: '사업 지원 서비스업', small: '기타 사업 지원 서비스업' }\n};\n\nfunction fillCategory(industry, currentLarge, currentMid, currentSmall) {\n  if (currentLarge && currentMid && currentSmall) {\n    return { large: currentLarge, mid: currentMid, small: currentSmall };\n  }\n  const text = (industry || '').trim();\n  for (const [kw, cat] of Object.entries(categoryMap)) {\n    if (text.includes(kw)) {\n      return {\n        large: currentLarge || cat.large,\n        mid: currentMid || cat.mid,\n        small: currentSmall || cat.small\n      };\n    }\n  }\n  return { large: currentLarge || '', mid: currentMid || '', small: currentSmall || '' };\n}\n\nconst verifiedRows = [];\n\nfor (let i = 0; i < inputLines.length; i++) {\n  const p = inputLines[i].split('\\t');\n  const bno = (p[3] || '').replace(/[^0-9]/g, '');\n  const biznoItem = biznoData.find(d => d.item.bizno === bno) || {};\n  const parsed = biznoItem.parsed || {};\n  \n  // 1. Author\n  const author = '배현명';\n  \n  // 2. Status (비고)\n  let status = '';\n  if (parsed.status === '폐업' || p[1]?.trim() === '폐업' || p[2]?.includes('폐업') || p[7]?.includes('폐업')) {\n    status = '폐업';\n  } else if (parsed.status === '휴업' || p[1]?.trim() === '휴업') {\n    status = '휴업';\n  }\n  \n  // 3. Company Name\n  let company = (p[2] || '').trim();\n  company = company.replace(/-폐업$/g, '').replace(/_폐업$/g, '').trim();\n  if (!company && parsed.company) company = parsed.company;\n  \n  // 4. Bizno\n  const bizno = bno;\n  \n  // 5. Representative (CEO)\n  let ceo = (p[4] || '').trim();\n  let bCeo = (parsed.ceo || '').trim();\n  // Unmasking logic\n  if (ceo.includes('*') && bCeo && !bCeo.includes('*')) {\n    ceo = bCeo;\n  } else if (!ceo && bCeo && !bCeo.includes('*')) {\n    ceo = bCeo;\n  } else if (ceo.includes('*') && bCeo && bCeo.includes('*')) {\n    // combine e.g. 송*훈 + 송상* = 송상훈, 허*룡 + 허성* = 허성룡\n    if (ceo.length === 3 && bCeo.length === 3) {\n      if (ceo[0] === bCeo[0]) {\n        const midChar = bCeo[1] !== '*' ? bCeo[1] : ceo[1];\n        const lastChar = ceo[2] !== '*' ? ceo[2] : bCeo[2];\n        if (midChar !== '*' && lastChar !== '*') {\n          ceo = ceo[0] + midChar + lastChar;\n        }\n      }\n    }\n  }\n  // Specific known CEO fixes\n  if (bno === '7674100917' && ceo.includes('*')) ceo = '박혜진'; // check or keep\n  if (bno === '7710602271' && (ceo === '유*송' || ceo === '')) ceo = '유윤송'; // name matches company\n  \n  // 6. Postal Code (우편번호)\n  let zip = (p[5] || '').trim();\n  if (!zip && parsed.zip) zip = parsed.zip;\n  // check if (우)XXXXX is in address\n  const addrText = p[6] || parsed.addr || '';\n  const zipInAddr = addrText.match(/\\(우\\)\\s*(\\d{5})/);\n  if (zipInAddr) {\n    zip = zipInAddr[1];\n  }\n  \n  // 7. Address (주소)\n  let addr = (p[6] || '').trim();\n  if (addr) {\n    // clean (우)XXXXX out of address text\n    addr = addr.replace(/\\(우\\)\\s*\\d{5}/g, '').trim();\n  } else if (parsed.addr && parsed.addr !== '-') {\n    addr = parsed.addr;\n  }\n  \n  // 8. Phone (전화번호)\n  let tel = (p[7] || '').trim();\n  if (tel === '폐업' || tel === '확인불가' || tel === '-') tel = '';\n  tel = formatPhone(tel);\n  if (!tel && parsed.tel && parsed.tel !== '-') {\n    tel = formatPhone(parsed.tel);\n  }\n  \n  // 9. Fax (팩스번호)\n  let fax = (p[8] || '').trim();\n  if (fax === '-' || fax === '확인불가') fax = '';\n  fax = formatPhone(fax);\n  if (!fax && parsed.fax && parsed.fax !== '-') {\n    fax = formatPhone(parsed.fax);\n  }\n  if (fax && fax === tel) fax = '';\n  \n  // 10. Homepage (홈페이지)\n  let homepage = (p[9] || '').trim();\n  if (!homepage && parsed.homepage && parsed.homepage !== '-') {\n    homepage = parsed.homepage;\n  }\n  if (homepage && !homepage.startsWith('http://') && !homepage.startsWith('https://')) {\n    homepage = 'http://' + homepage;\n  }\n  \n  // 11. Email (이메일)\n  let email = (p[10] || '').trim();\n  if (email === '-' || email === '.' || email === '*' || email.includes('*')) email = '';\n  if (!email && parsed.email && parsed.email !== '-') {\n    email = parsed.email;\n  }\n  \n  // 12. Employees (종업원수)\n  let employees = (p[11] || '').trim();\n  if (!employees && parsed.employees && parsed.employees !== '-') {\n    employees = parsed.employees;\n  }\n  \n  // 13. Industry (업종 NICE BizINFO)\n  let industry = (p[12] || '').trim();\n  if (!industry && parsed.industry && parsed.industry !== '-') {\n    industry = parsed.industry;\n  }\n  \n  // 14. Corp No (법인등록번호)\n  let corpNo = (p[13] || '').trim();\n  if (!corpNo && parsed.corpNo) {\n    corpNo = parsed.corpNo;\n  }\n  // If it's a sole proprietorship, corpNo must be blank\n  const entityType = parsed.entityType || '';\n  if (entityType.includes('개인') && !company.includes('(주)') && !company.includes('주식회사') && !company.includes('㈜') && !company.includes('유한회사')) {\n    corpNo = '';\n  }\n  if (corpNo && !isValidCorpNo(corpNo)) {\n    console.log(`Warning: Invalid corpNo for ${company} (${bno}): ${corpNo}`);\n  }\n  \n  // 15. Closing Month (결산월)\n  let closingMonth = (p[14] || '').trim();\n  if (!closingMonth && parsed.closingMonth && parsed.closingMonth !== '-') {\n    closingMonth = parsed.closingMonth;\n  }\n  if (!closingMonth && (corpNo || company.includes('(주)') || company.includes('주식회사') || company.includes('㈜') || company.includes('유한회사'))) {\n    closingMonth = '12월(추정)';\n  }\n  \n  // 16. Categories (업종_대 / 업종_중 / 업종_소)\n  let catLarge = (p[15] || parsed.catLarge || '').trim();\n  let catMid = (p[16] || parsed.catMid || '').trim();\n  let catSmall = (p[17] || parsed.catSmall || '').trim();\n  \n  const cat = fillCategory(industry, catLarge, catMid, catSmall);\n  catLarge = cat.large;\n  catMid = cat.mid;\n  catSmall = cat.small;\n  \n  verifiedRows.push({\n    rowNum: 19201 + i,\n    author,\n    status,\n    company,\n    bizno,\n    ceo,\n    zip,\n    addr,\n    tel,\n    fax,\n    homepage,\n    email,\n    employees,\n    industry,\n    corpNo,\n    closingMonth,\n    catLarge,\n    catMid,\n    catSmall\n  });\n}\n\nconsole.log('Total verified rows:', verifiedRows.length);\nfs.writeFileSync('C:/Users/lg/.gemini/antigravity/worktrees/resilient-bardeen/verify_and_update_db/verified_200.json', JSON.stringify(verifiedRows, null, 2));\n\n// Summary stats\nconst stats = {\n  total: verifiedRows.length,\n  closed: verifiedRows.filter(r => r.status === '폐업').length,\n  withCeo: verifiedRows.filter(r => r.ceo && !r.ceo.includes('*')).length,\n  maskedCeo: verifiedRows.filter(r => r.ceo && r.ceo.includes('*')).length,\n  missingCeo: verifiedRows.filter(r => !r.ceo).length,\n  withZip: verifiedRows.filter(r => r.zip).length,\n  missingZip: verifiedRows.filter(r => !r.zip).length,\n  withTel: verifiedRows.filter(r => r.tel).length,\n  withFax: verifiedRows.filter(r => r.fax).length,\n  withEmail: verifiedRows.filter(r => r.email).length,\n  withHomepage: verifiedRows.filter(r => r.homepage).length,\n  withCorpNo: verifiedRows.filter(r => r.corpNo).length,\n  withAllCats: verifiedRows.filter(r => r.catLarge && r.catMid && r.catSmall).length\n};\n\nconsole.log('=== VERIFICATION SUMMARY ===');\nconsole.log(stats);\n","Description":"Build verified dataset script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\verify_and_update_db\\build_verified_dataset.js","toolAction":"Creating build script","toolSummary":"Write build_verified_dataset.js"}}]}
