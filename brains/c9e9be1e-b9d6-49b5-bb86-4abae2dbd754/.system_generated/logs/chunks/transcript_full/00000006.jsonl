ap = new Map();\n35:   inputItems.forEach(item => {\n36:     if (item.bizno) {\n37:       biznoMap.set(item.bizno, item);\n38:     }\n39:   });\n40: \n41:   console.log('Unique biznos in input:', biznoMap.size);\n42: \n43:   const excelPath = 'C:/Users/lg/resilient-bardeen/data/(데이터검증팀)실사 DB 취합_전달용_260720_배현명.xlsx';\n44:   const wb = new ExcelJS.Workbook();\n45:   console.log('Loading excel...');\n46:   await wb.xlsx.readFile(excelPath);\n47:   const ws = wb.getWorksheet('기업 정보');\n48:   console.log('Excel loaded. Rows:', ws.rowCount);\n49: \n50:   // Search where biznos appear in Excel\n51:   // Column 4 is \"사업자번호\"\n52:   const foundInExcel = [];\n53:   const notFoundInExcel = [];\n54: \n55:   // Let's also check all rows where author is '배현명'\n56:   let baeMinRow = Infinity;\n57:   let baeMaxRow = -1;\n58:   let baeCount = 0;\n59: \n60:   for (let r = 2; r <= ws.rowCount; r++) {\n61:     const row = ws.getRow(r);\n62:     const author = (row.getCell(1).value || '').toString().trim();\n63:     const bnoRaw = (row.getCell(4).value || '').toString().replace(/[^0-9]/g, '');\n64:     const comp = (row.getCell(3).value || '').toString().trim();\n65: \n66:     if (author === '배현명') {\n67:       baeCount++;\n68:       if (r < baeMinRow) baeMinRow = r;\n69:       if (r > baeMaxRow) baeMaxRow = r;\n70:     }\n71: \n72:     if (biznoMap.has(bnoRaw)) {\n73:       foundInExcel.push({\n74:         rowNum: r,\n75:         authorInExcel: author,\n76:         excelCompany: comp,\n77:         bizno: bnoRaw,\n78:         inputItem: biznoMap.get(bnoRaw)\n79:       });\n80:     }\n81:   }\n82: \n83:   console.log(`배현명 rows in Excel: count=${baeCount}, range=[${baeMinRow}, ${baeMaxRow}]`);\n84:   console.log(`Found in Excel: ${foundInExcel.length} / ${biznoMap.size}`);\n85: \n86:   if (foundInExcel.length > 0) {\n87:     console.log('First 5 found:', foundInExcel.slice(0, 5).map(f => ({\n88:       rowNum: f.rowNum,\n89:       author: f.authorInExcel,\n90:       company: f.excelCompan