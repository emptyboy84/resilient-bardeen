\\n  }\\n});\\n\\nconsole.log(`Updated records with NICE BizINFO official 산업명: ${niceSanupApplied} / ${list.length}`);\\nconsole.log(`Additional CorpNos from NICE: ${corpNoFromNice}`);\\nconsole.log(`Additional unmasked CEOs from NICE: ${repFromNice}`);\\n\\nfs.writeFileSync('verified_200_final.json', JSON.stringify(list, null, 2), 'utf-8');\\n\\n// Also regenerate TSV and CSV\\nconst header18 = ['작성자', '상태', '회사명', '사업자번호', '대표자', '우편번호', '주소', '전화번호', '팩스번호\n<truncated 2506 bytes>","Description":"\"Apply accurate KSIC categories and regenerate TSV/CSV\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\worktrees\\\\resilient-bardeen\\\\verify_and_update_db\\\\apply_nice_to_verified.js\"","toolAction":"\"Updating apply_nice_to_verified.js\"","toolSummary":"\"Update apply_nice_to_verified.js\""}}],"truncated_fields":["tool_calls"]}
