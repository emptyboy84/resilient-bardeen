tClass) != -1) {\n529: \t\t\t\t\t\t\t$('.contentView')\n530: \t\t\t\t\t\t\t\t.removeClass('ctl-font-ty1 ctl-font-ty2 ctl-font-ty3 ctl-font-ty4')\n531: \t\t\t\t\t\t\t\t.addClass(currentFontClass);\n532: \t\t\t\t\t}\n533: \n534: \t\t\t\t\t// 폰트 크기 지정\n535: \t\t\t\t\t$('.eveFontChangeWrap .btnc').on('click', function() {\n536: \t\t\t\t\t\tvar className = $(this).data('class');\n537: \t\t\t\t\t\t$('.contentView')\n538: \t\t\t\t\t\t\t.removeClass('ctl-font-ty1 ctl-font-ty2 ctl-font-ty3 ctl-font-ty4')\n539: \t\t\t\t\t\t\t.addClass(className);\n540: \n541:                         localStorage.setItem('viewFontClassName', className);\n542: \t\t\t\t\t});\n543: \t\t\t\t});\n544: \t\t\t</script>\n545: \t\t</div><!-- // subjectDiv -->\n546: \t</div>\n547: \t<!-- // .subjectWrap -->\n548: \n549: \n550: \n551: \n552: \t<div class=\"mainSection\">\n553: \t\t\n554: \n555: \t\t<div class=\"articleView\">\n556: \t\t\t\n557: \n558: \t\t\t\n559: \n560: \t\t\t<div id=\"CmAdContent\">\n561: \t\t\t\t<div id=\"talklink_contents\">\n562: \n563: \n564: \t\t\t\t\t<div class=\"contentView ctl-font-ty2 editorType1\" itemprop=\"articleBody\">\n565: \n566: \n567: \t\t\t\t\t\t<div style=\"text-align:center\"><div class=\"actPhoto\">\n568: \t<div class=\"photo\"  style=\"width:550px;margin:0 auto;\">\n569: \t\t<img src=\"https://storage1.ilyo.co.kr/contents/article/images/2018/0913/1536774727352206.jpg\"  style=\"width:550px;margin:0 auto;\">\n570: \t\t<p class=\"photoAlt\">‘2018 경상남도 중부권 채용박람회’에서 김경수 도지사가 채용 설명을 듣고 있다.  </p>\n571: \t</div>\n572: </div></div>\r\n573: <br />\r\n574: [경남=일요신문] 조정기 기자 = &nbsp;&lsquo;2018 경상남도 중부권 채용박람회&rsquo;가 12일 창원컨벤션센터에서구직자들의