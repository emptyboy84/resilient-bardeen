          print(\\\"  Bizno: 0 results\\\")\\n        else:\\n            matches = re.findall(r'<a[^>]+href=\\\"(/article/(\\\\d+))\\\"[^>]*>(.*?)</a>', html)\\n            for link, bno, title in matches:\\n                if \\\"족보\\\" in title:\\n                    print(\\\"  Bizno Match:\\\", bno, title)\\nexcept Exception as e:\\n    print(\\\"Bizno Error:\\\", e)\\n\"","Description":"\"Search 족보관\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\228844c1-7cf3-4d15-8f56-9f1d0de8a851\\\\scratch\\\\search_jokbo.py\"","toolAction":"\"Write search_jokbo.py\"","toolSummary":"\"Writing search jokbo script\""}}]}
