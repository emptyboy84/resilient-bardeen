{"step_index":574,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T02:52:18Z","tool_calls":[{"name":"call_mcp_tool","args":{"Arguments":"{\"function\":\"() => {\\n  const elements = Array.from(document.querySelectorAll('a, button, span'));\\n  const corpBtn = elements.find(el => el.innerText.trim() === '법인 열람·발급' || el.innerText.trim() === '법인등기 열람/발급');\\n  if (corpBtn) {\\n    corpBtn.click();\\n    return 'Clicked ' + corpBtn.innerText;\\n  