{"step_index":226,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T00:57:34Z","input_tokens":4127,"cache_read_tokens":194718,"output_tokens":2357,"thinking":"Observed that the sidebar ads/query listings still appear even with zero search results on Bizno, like \"개별화물\", \"마리아주과자점\", and \"히팅앤쿨\". This happens because Bizno's \"0 results found\" message might reside outside the `post-list` or have slightly different tagging. This suggests a need to refine the result filtering logic to specifically exclude these side-bar elements.\n\n\nEnhanced the filtering logic. Now, a `single-post` is only considered a valid candidate if its title includes the search term's name. This should eliminate the false positives stemming from sidebar content and unrelated search results. This filtering ensures the title includes the search term either directly or conversely.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const fs = require('fs');\n\nconst targets = JSON.parse(fs.readFileSync('target_companies.json', 'utf8'));\n\nfunction cleanCompanyName(name) {\n  return name\n    .replace(/\\(주\\)|\\(유한\\)|\\(유책\\)|\\(합자\\)|\\(사\\)/g, '')\n    .replace(/주식회사|유한회사/g, '')\n    .trim();\n}\n\nasync function searchBiznoStrict(c) {\n  const cName = cleanCompanyName(c.name);\n  if (!cName) return null;\n\n  const url = `https://bizno.net/?query=${encodeURIComponent(cName)}`;\n  try {\n    const res = await fetch(url, {\n      headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }\n    });\n    const html = await res.text();\n\n    const postListMatch = html.match(/<div class=\"col-lg-8 post-list\">([\\s\\S]*?)<\\/div>\\s*<div class=\"col-lg-4 sidebar\">/);\n    if (!postListMatch) return null;\n\n    const content = postListMatch[1];\n    // Check if 0 results\n    if (html.includes('0</span></strong> 개의 결과를 찾았습니다') || html.includes('0 개의 결과를 찾았습니다')) {\n      return null;\n    }\n\n    const items = content.split('class=\"single-post');\n    const validCandidates = [];\n\n    for (let i = 1; i < items.length; i++) {\n      const item = items[i];\n      const art = item.match(/\\/article\\/(\\d{10})/)?.[1];\n      const title = item.match(/<h4>([^<]+)<\\/h4>/)?.[1]?.trim() || '';\n      const p = item.match(/<p>([\\s\\S]*?)<\\/p>/)?.[1]?.replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim() || '';\n      const h5s = [...item.matchAll(/<h5>([^<]+)<\\/h5>/g)].map(m => m[1].trim());\n\n      if (!art || !title) continue;\n\n      const cleanTitle = cleanCompanyName(title);\n\n      // STRICT FILTER: Title MUST contain cName or cName contain Title\n      if (!cleanTitle.includes(cName) && !cName.includes(cleanTitle)) {\n        continue;\n      }\n\n      // Check CEO\n      const ceoCandidate = h5s.find(h => h.length <= 4 && !h.includes('업') && !h.includes('소매') && !h.includes('제조') && !h.includes('서비스'));\n      let ceoScore = 0;\n      let ceoText = ceoCandidate || '';\n      if (ceoCandidate) {\n        const raw = ceoCandidate.replace(/\\*/g, '');\n        if (raw && c.ceo.startsWith(raw[0])) {\n          ceoScore = 50;\n        }\n      }\n\n      // Check Address\n      let addrScore = 0;\n      if (p.includes('부산')) {\n        addrScore = 30;\n        const targetGu = c.address.split(' ')[1]; // \"해운대구\", \"기장군\", etc.\n        if (targetGu && p.includes(targetGu)) {\n          addrScore += 30;\n        }\n      }\n\n      // Title exactness score\n      let titleScore = (cleanTitle === cName) ? 40 : 20;\n\n      const totalScore = titleScore + ceoScore + addrScore;\n\n      validCandidates.push({\n        bizNo: art,\n        formattedBizNo: art.replace(/(\\d{3})(\\d{2})(\\d{5})/, '$1-$2-$3'),\n        title,\n        address: p,\n        ceo: ceoText,\n        info: h5s.join(', '),\n        totalScore,\n        addrScore,\n        ceoScore\n      });\n    }\n\n    if (validCandidates.length === 0) return null;\n\n    validCandidates.sort((a, b) => b.totalScore - a.totalScore);\n    return validCandidates[0];\n  } catch (e) {\n    return null;\n  }\n}\n\nasync function run() {\n  console.log(`Starting strict bizno search for ${targets.length} companies...`);\n  const results = [];\n\n  for (let i = 0; i < targets.length; i++) {\n    const c = targets[i];\n    // Special handling for 1254 (주)더플로우 where user already found 899-37-01327\n    if (c.seq === '1254') {\n      results.push({\n        ...c,\n        bizNo: '899-37-01327',\n        matchedTitle: '더플로우',\n        matchedAddress: '부산 해운대구 (통신판매)',\n        matchedCeo: '정연택 (대표변경/개인사업자 등)',\n        note: '사용자 확인 완료 (머니핀)',\n        found: true\n      });\n      console.log(`[${i+1}/${targets.length}] 1254 (주)더플로우 => 899-37-01327 (사용자 확인)`);\n      continue;\n    }\n\n    const match = await searchBiznoStrict(c);\n    if (match) {\n      console.log(`[${i+1}/${targets.length}] ${c.seq} ${c.name} (${c.ceo}) => ${match.formattedBizNo} [${match.title} | ${match.address || '주소미표기'} | CEO:${match.ceo || '미표기'} | 점수:${match.totalScore}]`);\n      results.push({\n        ...c,\n        bizNo: match.formattedBizNo,\n        matchedTitle: match.title,\n        matchedAddress: match.address,\n        matchedCeo: match.ceo,\n        totalScore: match.totalScore,\n        found: true\n      });\n    } else {\n      console.log(`[${i+1}/${targets.length}] ${c.seq} ${c.name} (${c.ceo}) => [비즈노 미등록]`);\n      results.push({\n        ...c,\n        bizNo: null,\n        found: false\n      });\n    }\n    await new Promise(r => setTimeout(r, 120));\n  }\n\n  fs.writeFileSync('strict_bizno_results.json', JSON.stringify(results, null, 2), 'utf8');\n  console.log('Complete strict search!');\n}\n\nrun();\n","Description":"Strict bizno search script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\strict_bizno_search.js","toolAction":"Writing strict_bizno_search.js","toolSummary":"Write strict search script"}}]}
