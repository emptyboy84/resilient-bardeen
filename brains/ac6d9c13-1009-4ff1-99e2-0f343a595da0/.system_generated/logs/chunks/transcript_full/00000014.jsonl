      const art = item.match(/\\/article\\/(\\d{10})/)?.[1];\n134:           const title = item.match(/<h4>([^<]+)<\\/h4>/)?.[1]?.trim() || '';\n135:           const p = item.match(/<p>([\\s\\S]*?)<\\/p>/)?.[1]?.replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim() || '';\n136:           const h5s = [...item.matchAll(/<h5>([^<]+)<\\/h5>/g)].map(m => m[1].trim());\n137: \n138:           const cleanTitle = title.replace(/\\(주\\)|\\(유한\\)|\\(유책\\)/g, '').replace(/주식회사|유한회사/g, '').trim();\n139:           if (art && (cleanTitle.includes(cName) || cName.includes(cleanTitle))) {\n140:             const ceoCand = h5s.find(h => h.length <= 4 && !h.includes('업') && !h.includes('소매') && !h.includes('제조') && !h.includes('서비스')) || '';\n141:             list.push({ bizNo: art, title, address: p, ceo: ceoCand });\n142:           }\n143:         }\n144: \n145:         // Rank list\n146:         // Priority 1: Address contains \"부산\" AND (address contains gu OR ceo matches first letter)\n147:         const targetGu = c.address.split(' ')[1]; // \"해운대구\", \"사상구\", etc.\n148:         const busanSameGu = list.find(item => item.address.includes('부산') && (item.address.includes(targetGu) || (item.ceo && c.ceo.startsWith(item.ceo[0]))));\n149:         const busanAny = list.find(item => item.address.includes('부산'));\n150:         const ceoMatchAnywhere = list.find(item => item.ceo && c.ceo.startsWith(item.ceo[0]) && cleanCompanyName(item.title) === cName);\n151: \n152:         if (busanSameGu) {\n153:           matched = { item: busanSameGu, type: '부산 동일구/대표자 일치' };\n154:         } else if (busanAny) {\n155:           matched = { item: busanAny, type: '부산 관내 상호일치' };\n156:         } else if (ceoMatchAnywhere) {\n157:           matched = { item: ceoMatchAnywhere, type: '상호 및 대표자 성명 일치' };\n158:         }\n159:       }\n160: \n161:       if (matched) {\n162:         matchReport.push({\n163:           seq: c.seq,\n164:           name: c.name,\n165:           ceo: c.ceo,\n166:           address: c.address,\n167:           matchedBizNo: matched.item.bizNo.replace(/(\\d{3})(\\d{2})(\\d{5})/, '$1-$2-$3'),\n168:           matchedTitle: matched.item.title,\n169:           matchedAddress: matched.item.address,\n170:           matchedCeo: matched.item.ceo,\n171:           confidence: matched.type,\n172:           status: '매칭성공'\n173:         });\n174:       } else {\n175:         matchReport.push({\n176:           seq: c.seq,\n177:           name: c.name,\n178:           ceo: c.ceo,\n179:           address: c.address,\n180:           matchedBizNo: '미등록(조회불가)',\n181:           confidence: '비즈노/머니핀 공공DB 사업자등록 미확인',\n182:           status: '미등록'\n183:         });\n184:       }\n185:     } catch (e) {\n186:       matchReport.push({\n187:         seq: c.seq,\n188:         name: c.name,\n189:         ceo: c.ceo,\n190:         address: c.address,\n191:         matchedBizNo: '미등록(조회불가)',\n192:         status: '에러'\n193:       });\n194:     }\n195: \n196:     await new Promise(r => setTimeout(r, 120));\n197:   }\n198: \n199:   fs.writeFileSync('final_matched_report.json', JSON.stringify(matchReport, null, 2), 'utf8');\n200:   console.log('Saved final_matched_report.json');\n201: }\n202: \n203: function cleanCompanyName(name) {\n204:   return name.replace(/\\(주\\)|\\(유한\\)|\\(유책\\)|\\(합자\\)|\\(사\\)/g, '').replace(/주식회사|유한회사/g, '').trim();\n205: }\n206: \n207: inspectCandidates();\n208: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
