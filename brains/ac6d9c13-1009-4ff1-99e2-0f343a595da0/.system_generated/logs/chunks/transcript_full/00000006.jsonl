{"step_index":295,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T01:10:15Z","content":"Created At: 2026-10-13T10:10:15+09:00\nCompleted At: 2026-10-13T10:10:15+09:00\nFile Path: `file:///C:/Users/lg/.gemini/antigravity/worktrees/resilient-bardeen/parse_company_data/deep_search_bizno.js`\nTotal Lines: 214\nTotal Bytes: 6890\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const fs = require('fs');\n2: \n3: const targets = JSON.parse(fs.readFileSync('target_companies.json', 'utf8'));\n4: \n5: function cleanCompanyName(name) {\n6:   return name\n7:     .replace(/\\(주\\)|\\(유한\\)|\\(유책\\)|\\(합자\\)|\\(사\\)/g, '')\n8:     .replace(/주식회사|유한회사/g, '')\n9:     .trim();\n10: }\n11: \n12: async function fetchBiznoList(url) {\n13:   try {\n14:     const res = await fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' } });\n15:     const html = await res.text();\n16:     const postListMatch = html.match(/<div class=\"col-lg-8 post-list\">([\\s\\S]*?)<\\/div>\\s*<div class=\"col-lg-4 sidebar\">/);\n17:     if (!postListMatch) return [];\n18:     if (html.includes('0 개의 결과를 찾았습니다')) return [];\n19: \n20:     const items = postListMatch[1].split('class=\"single-post');\n21:     const results = [];\n22:     for (let i = 1; i < items.length; i++) {\n23:       const item = items[i];\n24:       const art = item.match(/\\/article\\/(\\d{10})/)?.[1];\n25:       const title = item.match(/<h4>([^<]+)<\\/h4>/)?.[1]?.trim() || '';\n26:       const p = item.match(/<p>([\\s\\S]*?)<\\/p>/)?.[1]?.replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim() || '';\n27:       const h5s = [...item.matchAll(/<h5>([^<]+)<\\/h5>/g)].map(m => m[1].trim());\n28: \n29:       if (art && title) {\n30:         results.push({\n31:           bizNo: art,\n32:           formattedBizNo: art.replace(/(\\d{3})(\\d{2})(\\d{5})/, '$1-$2-$3'),\n33:           title,\n34:           address: p,\n35:           h5s\n36:         });\n37:       }\n38:     }\n39:     return results;\n40:   } catch (e) {\n41:     return [];\n42:   }\n43: }\n44: \n45: async function deepSearchCompany(c) {\n46:   const cName = cleanCompanyName(c.name);\n47:   const targetGu = c.address.split(' ')[1] || '';\n48:   const streetName = c.address.match(/([가-힣\\d]+(?:로|길)\\s*[\\d-]+)/)?.[1] || '';\n49: \n50:   // 1. Search by Name\n51:   const byNameUrl = `https://bizno.net/?query=${encodeURIComponent(cName)}`;\n52:   const byNameList = await fetchBiznoList(byNameUrl);\n53:   await new Promise(r => setTimeout(r, 100));\n54: \n55:   // 2. Search by CEO\n56:   const byCeoUrl = `https://bizno.net/%EB%8C%80%ED%91%9C%EC%9E%90%EC%A1%B0%ED%9A%8C/?query=${encodeURIComponent(c.ceo)}`;\n57:   const byCeoList = await fetchBiznoList(byCeoUrl);\n58:   await new Promise(r => setTimeout(r, 100));\n59: \n60:   // 3. Search by Street Name if available\n61:   let byStreetList = [];\n62:   if (streetName && streetName.length >= 4) {\n63:     const byStreetUrl = `https://bizno.net/?query=${encodeURIComponent(streetName)}`;\n64:     byStreetList = await fetchBiznoList(byStreetUrl);\n65:     await new Promise(r => setTimeout(r, 100));\n66:   }\n67: \n68:   // Combine and score candidates\n69:   const allCandidates = new Map();\n70: \n71:   function addCandidate(cand, source) {\n72:     if (!allCandidates.has(cand.bizNo)) {\n73:       allCandidates.set(cand.bizNo, { ...cand, sources: [source], score: 0 });\n74:     } else {\n75:       const existing = allCandidates.get(cand.bizNo);\n76:       if (!existing.sources.includes(source)) existing.sources.push(source);\n77:     }\n78:   }\n79: \n80:   byNameList.forEach(cand => addCandidate(cand, 'name'));\n81:   byCeoList.forEach(cand => addCandidate(cand, 'ceo'));\n82:   byStreetList.forEach(cand => addCandidate(cand, 'street'));\n83: \n84:   const scored = [];\n85:   for (const cand of allCandidates.values()) {\n86:     let score = 0;\n87:     const cleanCandTitle = cleanCompanyName(cand.title);\n88: \n89:     // Title match\n90:     if (cleanCandTitle === cName) score += 60;\n91:     else if (cleanCandTitle.includes(cName) || cName.includes(cleanCandTitle)) score += 35;\n92: \n93:     // CEO match\n94:     const candCeo = cand.h5s.find(h => h.length <= 4 && !h.includes('업') && !h.includes('소매') && !h.includes('제조') && !h.includes('서비스')) || '';\n95:     if (cand.sources.includes('ceo')) {\n96:       score += 50;\n97:     } else if (candCeo && c.ceo.startsWith(candCeo.replace(/\\*/g, '')[0])) {\n98:       score += 30;\n99:     }\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
