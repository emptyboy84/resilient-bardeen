{"step_index":289,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T01:09:29Z","input_tokens":3021,"cache_read_tokens":266290,"output_tokens":2626,"thinking":"Representative searches yield similar results. A comprehensive investigation across all 70 entities is required. The process will involve systematically querying Bizno by company name, representative name, and address (including road name), then supplementing with web searches. A script will automate this deep dive to identify precise and related candidates and their validated source URLs.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const fs = require('fs');\n\nconst targets = JSON.parse(fs.readFileSync('target_companies.json', 'utf8'));\n\nfunction cleanCompanyName(name) {\n  return name\n    .replace(/\\(주\\)|\\(유한\\)|\\(유책\\)|\\(합자\\)|\\(사\\)/g, '')\n    .replace(/주식회사|유한회사/g, '')\n    .trim();\n}\n\nasync function fetchBiznoList(url) {\n  try {\n    const res = await fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' } });\n    const html = await res.text();\n    const postListMatch = html.match(/<div class=\"col-lg-8 post-list\">([\\s\\S]*?)<\\/div>\\s*<div class=\"col-lg-4 sidebar\">/);\n    if (!postListMatch) return [];\n    if (html.includes('0 개의 결과를 찾았습니다')) return [];\n\n    const items = postListMatch[1].split('class=\"single-post');\n    const results = [];\n    for (let i = 1; i < items.length; i++) {\n      const item = items[i];\n      const art = item.match(/\\/article\\/(\\d{10})/)?.[1];\n      const title = item.match(/<h4>([^<]+)<\\/h4>/)?.[1]?.trim() || '';\n      const p = item.match(/<p>([\\s\\S]*?)<\\/p>/)?.[1]?.replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim() || '';\n      const h5s = [...item.matchAll(/<h5>([^<]+)<\\/h5>/g)].map(m => m[1].trim());\n\n      if (art && title) {\n        results.push({\n          bizNo: art,\n          formattedBizNo: art.replace(/(\\d{3})(\\d{2})(\\d{5})/, '$1-$2-$3'),\n          title,\n          address: p,\n          h5s\n        });\n      }\n    }\n    return results;\n  } catch (e) {\n    return [];\n  }\n}\n\nasync function deepSearchCompany(c) {\n  const cName = cleanCompanyName(c.name);\n  const targetGu = c.address.split(' ')[1] || '';\n  const streetName = c.address.match(/([가-힣\\d]+(?:로|길)\\s*[\\d-]+)/)?.[1] || '';\n\n  // 1. Search by Name\n  const byNameUrl = `https://bizno.net/?query=${encodeURIComponent(cName)}`;\n  const byNameList = await fetchBiznoList(byNameUrl);\n  await new Promise(r => setTimeout(r, 100));\n\n  // 2. Search by CEO\n  const byCeoUrl = `https://bizno.net/%EB%8C%80%ED%91%9C%EC%9E%90%EC%A1%B0%ED%9A%8C/?query=${encodeURIComponent(c.ceo)}`;\n  const byCeoList = await fetchBiznoList(byCeoUrl);\n  await new Promise(r => setTimeout(r, 100));\n\n  // 3. Search by Street Name if available\n  let byStreetList = [];\n  if (streetName && streetName.length >= 4) {\n    const byStreetUrl = `https://bizno.net/?query=${encodeURIComponent(streetName)}`;\n    byStreetList = await fetchBiznoList(byStreetUrl);\n    await new Promise(r => setTimeout(r, 100));\n  }\n\n  // Combine and score candidates\n  const allCandidates = new Map();\n\n  function addCandidate(cand, source) {\n    if (!allCandidates.has(cand.bizNo)) {\n      allCandidates.set(cand.bizNo, { ...cand, sources: [source], score: 0 });\n    } else {\n      const existing = allCandidates.get(cand.bizNo);\n      if (!existing.sources.includes(source)) existing.sources.push(source);\n    }\n  }\n\n  byNameList.forEach(cand => addCandidate(cand, 'name'));\n  byCeoList.forEach(cand => addCandidate(cand, 'ceo'));\n  byStreetList.forEach(cand => addCandidate(cand, 'street'));\n\n  const scored = [];\n  for (const cand of allCandidates.values()) {\n    let score = 0;\n    const cleanCandTitle = cleanCompanyName(cand.title);\n\n    // Title match\n    if (cleanCandTitle === cName) score += 60;\n    else if (cleanCandTitle.includes(cName) || cName.includes(cleanCandTitle)) score += 35;\n\n    // CEO match\n    const candCeo = cand.h5s.find(h => h.length <= 4 && !h.includes('업') && !h.includes('소매') && !h.includes('제조') && !h.includes('서비스')) || '';\n    if (cand.sources.includes('ceo')) {\n      score += 50;\n    } else if (candCeo && c.ceo.startsWith(candCeo.replace(/\\*/g, '')[0])) {\n      score += 30;\n    }\n\n    // Address match\n    if (cand.address.includes('부산')) {\n      score += 25;\n      if (targetGu && cand.address.includes(targetGu)) score += 25;\n      if (streetName && cand.address.includes(streetName)) score += 40;\n    }\n\n    scored.push({ ...cand, score, candCeo });\n  }\n\n  scored.sort((a, b) => b.score - a.score);\n\n  // Filter those with reasonable score\n  // At minimum: score >= 40 (must have either strong title+busan OR title+ceo OR ceo+busan)\n  const best = scored.find(s => s.score >= 50);\n\n  if (best) {\n    return {\n      found: true,\n      bizNo: best.formattedBizNo,\n      title: best.title,\n      address: best.address,\n      ceo: best.candCeo,\n      score: best.score,\n      sources: best.sources.join('+'),\n      url: `https://bizno.net/article/${best.bizNo}`\n    };\n  }\n\n  return { found: false };\n}\n\nasync function run() {\n  console.log(`Starting deep multi-angle search for ${targets.length} companies...`);\n  const results = [];\n\n  for (let i = 0; i < targets.length; i++) {\n    const c = targets[i];\n\n    // Priority for 1254 (더플로우)\n    if (c.seq === '1254') {\n      results.push({\n        ...c,\n        bizNo: '899-37-01327',\n        matchedTitle: '더플로우',\n        matchedAddress: '부산광역시 해운대구 (통신판매)',\n        matchedCeo: '정연택',\n        url: 'https://bizno.net/article/8993701327',\n        sourceType: '머니핀/비즈노 통신판매(해운대구)',\n        found: true\n      });\n      continue;\n    }\n\n    // Priority for 1288 (센텀빅토리아호텔)\n    if (c.seq === '1288') {\n      results.push({\n        ...c,\n        bizNo: '364-10-02139',\n        matchedTitle: '센텀빅토리아호텔',\n        matchedAddress: '부산광역시 해운대구 센텀3로 20, 823호',\n        matchedCeo: '신유진',\n        url: 'https://centumvictoriahotel.com',\n        sourceType: '호텔 공식 웹사이트 및 비즈노',\n        found: true\n      });\n      continue;\n    }\n\n    // Priority for 1274 (해운대스위트호텔)\n    if (c.seq === '1274') {\n      results.push({\n        ...c,\n        bizNo: '838-88-02473',\n        matchedTitle: '(주)센텀스위트호텔',\n        matchedAddress: '부산광역시 해운대구',\n        matchedCeo: '신유진',\n        url: 'https://bizno.net/article/8388802473',\n        sourceType: '비즈노 및 신용평가DB',\n        found: true\n      });\n      continue;\n    }\n\n    const res = await deepSearchCompany(c);\n    if (res.found) {\n      console.log(`[${i+1}/${targets.length}] FOUND: ${c.seq} ${c.name} (${c.ceo}) => ${res.bizNo} [${res.title} | 점수:${res.score}]`);\n      results.push({\n        ...c,\n        bizNo: res.bizNo,\n        matchedTitle: res.title,\n        matchedAddress: res.address,\n        matchedCeo: res.ceo,\n        url: res.url,\n        sourceType: `비즈노 (${res.sources})`,\n        score: res.score,\n        found: true\n      });\n    } else {\n      console.log(`[${i+1}/${targets.length}] NOT FOUND: ${c.seq} ${c.name} (${c.ceo})`);\n      results.push({\n        ...c,\n        bizNo: null,\n        found: false\n      });\n    }\n  }\n\n  fs.writeFileSync('deep_search_results.json', JSON.stringify(results, null, 2), 'utf8');\n  console.log('Complete deep search!');\n}\n\nrun();\n","Description":"Deep multi-angle search script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\deep_search_bizno.js","toolAction":"Writing deep search script","toolSummary":"Write deep search script"}}]}
