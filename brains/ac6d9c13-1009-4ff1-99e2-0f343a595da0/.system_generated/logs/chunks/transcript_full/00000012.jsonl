Event('keyup', { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }));\n    await new Promise(r => setTimeout(r, 1600));\n\n    const text = document.body.innerText;\n    const countMatch = text.match(/(\\d+)건의 기업 검색 결과가 있습니다/);\n    const count = countMatch ? countMatch[1] : '0';\n\n    // Parse bizNo\n    let bizNo = '-';\n    const bzMatch = text.match(/(\\d{3}-\\d{2}-\\d{1}\\*{4})/);\n    if (bzMatch) bizNo = bzMatch[1];\n\n    // Check CEO\n    const ceoMatch = text.match(/대표자명\\s*\\n\\s*([^\\n\\r]+)/);\n    const ceo = ceoMatch ? ceoMatch[1].trim() : '';\n\n    results.push({\n      seq: item.seq,\n      name: item.name,\n      corpNo: item.corpNo,\n      targetCeo: item.ceo,\n      count,\n      bizNo,\n      foundCeo: ceo\n    });\n  }\n  return JSON.stringify(results);\n}"},"ServerName":"playwright","ToolName":"browser_evaluate","toolAction":"Running Batch 1 scan in browser","toolSummary":"Run Batch 1 nicebiz scan"}}]}
