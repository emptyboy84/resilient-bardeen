ure. This approach will involve thoroughly examining the specified Excel file.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const ExcelJS = require('exceljs');\nconst path = require('path');\nconst fs = require('fs');\n\nasync function runQA() {\n  const filePath = 'C:/Users/lg/Desktop/Today/크레탑_부산CT산업현황_261012_전략팀 전달/크레탑_부산CT산업현황_261012_전략팀 전달.xlsx';\n  console.log('=== QA INSPECTOR: Excel File Audit ===');\n  console.log('Target:', filePath);\n\n  const workbook = new ExcelJS.Workbook();\n  await workbook.xlsx.readFile(filePath);\n\n  console.log('Sheets found:', workbook.worksheets.map(w => w.name));\n\n  const results = {\n    sheets: [],\n    targetRowsAudit: [],\n    keyCheck1274: null,\n    keyCheck1482: null,\n    totalTargetCount: 0,\n    matchedCount: 0,\n    emptyCount: 0,\n    columnShiftDetected: false\n  };\n\n  for (const sheet of workbook.worksheets) {\n    console.log(`\\n--- Auditing Sheet: [${sheet.name}] (RowCount: ${sheet.rowCount}, ColCount: ${sheet.columnCount}) ---`);\n\n    // Find header row\n    let headerRowIdx = -1;\n    let headers = [];\n    sheet.eachRow((row, rowNumber) => {\n      const vals = row.values;\n      const strRow = JSON.stringify(vals);\n      if (strRow.includes('순번') && strRow.includes('기업명')) {\n        headerRowIdx = rowNumber;\n        headers = vals;\n      }\n    });\n\n    console.log(`Header Row Index: ${headerRowIdx}`);\n    if (headerRowIdx !== -1) {\n      console.log('Headers:', headers.slice(1, 18));\n    }\n\n    // Targets to inspect\n    const foundMap = {\n      '1254': '899-37-01327',\n      '1288': '364-10-02139',\n      '1346': '243-13-01682',\n      '1465': '783-02-01243',\n      '1482': '781-88-01386',\n      '1697': '173-46-00441',\n      '1852': '760-20-01657',\n      '2320': '224-22-55423',\n      '3504': '121-88-03957'\n    };\n\n    let targetRowsFound = 0;\n    const targetsAudit = [];\n\n    sheet.eachRow((row, rowNumber) => {\n      if (rowNumber <= headerRowIdx) return;\n      const col1 = row.getCell(1).value; // 순번\n      if (!col1) return;\n\n      const seqStr = String(col1).trim();\n      const numSeq = parseInt(seqStr, 10);\n\n      // Check if it's within 1200 ~ 3661\n      if (!isNaN(numSeq) && numSeq >= 1200 && numSeq <= 3661) {\n        targetRowsFound++;\n        const name = row.getCell(2).value;\n        const ceo = row.getCell(3).value;\n        const status = row.getCell(4).value;\n        const corpType = row.getCell(5).value;\n        const bizNo = row.getCell(6).value ? String(row.getCell(6).value).trim() : '';\n        const corpNo = row.getCell(7).value ? String(row.getCell(7).value).trim() : '';\n        const ind = row.getCell(8).value;\n        const addr = row.getCell(9).value;\n\n        // Check 1274\n        if (seqStr === '1274') {\n          results.keyCheck1274 = {\n            row: rowNumber,\n            seq: seqStr,\n            name,\n            ceo,\n            bizNo,\n            corpNo,\n            addr,\n            isCorrect: bizNo === '' || bizNo === '-'\n          };\n        }\n\n        // Check 1482\n        if (seqStr === '1482') {\n          results.keyCheck1482 = {\n            row: rowNumber,\n            seq: seqStr,\n            name,\n            ceo,\n            bizNo,\n            corpNo,\n            addr,\n            isCorrect: bizNo === '781-88-01386'\n          };\n        }\n\n        targetsAudit.push({\n          row: rowNumber,\n          seq: seqStr,\n          name,\n          ceo,\n          bizNo,\n          corpNo,\n          ind,\n          addr,\n          expectedBizNo: foundMap[seqStr] || ''\n        });\n      }\n    });\n\n    console.log(`Found ${targetRowsFound} target rows in this sheet.`);\n    if (targetRowsFound > 0) {\n      results.totalTargetCount = targetRowsFound;\n      results.targetRowsAudit = targetsAudit;\n    }\n  }\n\n  // Summary analysis\n  console.log('\\n=== QA AUDIT FINDINGS ===');\n  console.log(`Total target rows inspected: ${results.totalTargetCount}`);\n  \n  if (results.keyCheck1274) {\n    console.log('\\n[Key Check 1: 1274 (주)해운대스위트호텔]');\n    console.log('  Row:', results.keyCheck1274.row);\n    console.log('  BizNo in Excel:', `\"${results.keyCheck1274.bizNo}\"`);\n    console.log('  CorpNo in Excel:', results.keyCheck1274.corpNo);\n    console.log('  Audit Result:', results.keyCheck1274.isCorrect ? 'PASS (정상 공란/미등록 확인)' : 'FAIL (오매칭 잔존)');\n  } else {\n    console.log('\\n[Key Check 1: 1274 not found in target range]');\n  }\n\n  if (results.keyCheck1482) {\n    console.log('\\n[Key Check 2: 1482 (주)에스티에스]');\n    console.log('  Row:', results.keyCheck1482.row);\n    console.log('  BizNo in Excel:', `\"${results.keyCheck1482.bizNo}\"`);\n    console.log('  CorpNo in Excel:', results.keyCheck1482.corpNo);\n    console.log('  Audit Result:', results.keyCheck1482.isCorrect ? 'PASS (781-88-01386 정확히 반영)' : 'CHECK REQUIRED (실제 값: ' + results.keyCheck1482.bizNo + ')');\n  } else {\n    console.log('\\n[Key Check 2: 1482 not found in target range]');\n  }\n\n  // Print all rows with BizNo\n  console.log('\\n[All Populated Business Numbers in Target Range]');\n  const populated = results.targetRowsAudit.filter(t => t.bizNo !== '');\n  console.log(`Total populated rows: ${populated.length}`);\n  populated.forEach(p => {\n    console.log(`  Row ${p.row} [연번 ${p.seq}] ${p.name} (${p.ceo}): 사업자번호=\"${p.bizNo}\" | 기대값=\"${p.expectedBizNo}\" | 일치여부=${p.bizNo === p.expectedBizNo ? 'PASS' : 'FAIL'}`);\n  });\n\n  // Check column shifts: check if corpNo starts with 1801\n  const shiftedRows = results.targetRowsAudit.filter(t => t.corpNo && !t.corpNo.startsWith('1801'));\n  console.log(`\\n[Column Alignment Check]`);\n  console.log(`Rows with misaligned corpNo: ${shiftedRows.length}`);\n  if (shiftedRows.length > 0) {\n    shiftedRows.slice(0, 5).forEach(s => {\n      console.log(`  Row ${s.row} [연번 ${s.seq}]: corpNo=\"${s.corpNo}\", ind=\"${s.ind}\"`);\n    });\n  } else {\n    console.log('  PASS: All 77 target rows have perfectly aligned columns (no column shift)!');\n  }\n}\n\nrunQA().catch(err => console.error('QA Error:', err));\n","Description":"Run comprehensive QA audit on target Excel file","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\run_excel_qa.js","toolAction":"Creating Excel QA script","toolSummary":"Create run_excel_qa.js"}}]}
