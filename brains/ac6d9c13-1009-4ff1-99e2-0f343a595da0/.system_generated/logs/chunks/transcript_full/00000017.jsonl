{"step_index":898,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T03:35:32Z","input_tokens":2517,"cache_read_tokens":206651,"output_tokens":1943,"tool_calls":[{"name":"write_to_file","args":{"CodeContent":"const ExcelJS = require('exceljs');\nconst fs = require('fs');\n\nasync function audit77TargetsInMasterExcel() {\n  const filePath = 'C:/Users/lg/Desktop/Today/크레탑_부산CT산업현황_261012_전략팀 전달/크레탑_부산CT산업현황_261012_전략팀 전달.xlsx';\n  const targets = JSON.parse(fs.readFileSync('target_companies.json', 'utf8'));\n\n  console.log(`=== QA AUDIT: 77 TARGETS IN MASTER EXCEL ===`);\n  console.log('Master Excel File:', filePath);\n  console.log('Target Count:', targets.length);\n\n  const workbook = new ExcelJS.Workbook();\n  await workbook.xlsx.readFile(filePath);\n\n  const sheet = workbook.worksheets[0]; // first sheet\n  console.log(`Auditing Sheet: [${sheet.name}], Total Rows in Sheet: ${sheet.rowCount}`);\n\n  const rowsBySeq = new Map();\n  sheet.eachRow((row, rowNumber) => {\n    if (rowNumber === 1) return;\n    const seqVal = row.getCell(1).value;\n    if (seqVal !== null && seqVal !== undefined) {\n      const s = String(seqVal).trim();\n      if (!rowsBySeq.has(s)) rowsBySeq.set(s, []);\n      rowsBySeq.get(s).push({\n        rowNumber,\n        seq: s,\n        name: row.getCell(2).value ? String(row.getCell(2).value).trim() : '',\n        ceo: row.getCell(3).value ? String(row.getCell(3).value).trim() : '',\n        status: row.getCell(4).value ? String(row.getCell(4).value).trim() : '',\n        corpType: row.getCell(5).value ? String(row.getCell(5).value).trim() : '',\n        bizNo: row.getCell(6).value ? String(row.getCell(6).value).trim() : '',\n        corpNo: row.getCell(7).value ? String(row.getCell(7).value).trim() : '',\n        industry: row.getCell(8).value ? String(row.getCell(8).value).trim() : '',\n        address: row.getCell(9).value ? String(row.getCell(9).value).trim() : ''\n      });\n    }\n  });\n\n  const auditReport = [];\n  let foundInExcelCount = 0;\n\n  for (let i = 0; i < targets.length; i++) {\n    const t = targets[i];\n    const candidateRows = rowsBySeq.get(t.seq) || [];\n    \n    // Find matching candidate by ceo or name\n    let matchedRow = candidateRows.find(c => c.ceo === t.ceo || c.name.includes(t.name) || t.name.includes(c.name));\n    if (!matchedRow && candidateRows.length > 0) {\n      matchedRow = candidateRows[0];\n    }\n\n    if (matchedRow) {\n      foundInExcelCount++;\n      auditReport.push({\n        index: i + 1,\n        targetSeq: t.seq,\n        targetName: t.name,\n        targetCeo: t.ceo,\n        excelRow: matchedRow.rowNumber,\n        excelName: matchedRow.name,\n        excelCeo: matchedRow.ceo,\n        excelBizNo: matchedRow.bizNo,\n        excelCorpNo: matchedRow.corpNo,\n        excelAddr: matchedRow.address\n      });\n    } else {\n      auditReport.push({\n        index: i + 1,\n        targetSeq: t.seq,\n        targetName: t.name,\n        targetCeo: t.ceo,\n        excelRow: 'NOT FOUND',\n        excelBizNo: ''\n      });\n    }\n  }\n\n  console.log(`\\nMatched Targets in Master Excel: ${foundInExcelCount} / ${targets.length}`);\n\n  // Specifically check key companies\n  console.log('\\n--- KEY COMPANIES AUDIT ---');\n  \n  // 1. 1274 해운대스위트호텔\n  const r1274 = auditReport.find(r => r.targetSeq === '1274');\n  console.log('[1] 연번 1274 (주)해운대스위트호텔:');\n  console.log('    Excel Row:', r1274?.excelRow);\n  console.log('    사업자번호:', `\"${r1274?.excelBizNo}\"`);\n  console.log('    판정:', (r1274?.excelBizNo === '' || r1274?.excelBizNo === '-') ? '★ PASS (정상 공란/미등록 확인)' : `★ FAIL (오매칭 ${r1274?.excelBizNo} 잔존)`);\n\n  // 2. 1482 에스티에스\n  const r1482 = auditReport.find(r => r.targetSeq === '1482');\n  console.log('\\n[2] 연번 1482 (주)에스티에스:');\n  console.log('    Excel Row:', r1482?.excelRow);\n  console.log('    사업자번호:', `\"${r1482?.excelBizNo}\"`);\n  console.log('    판정:', r1482?.excelBizNo === '781-88-01386' ? '★ PASS (정식 법인사업자 781-88-01386 반영 완료)' : `★ FAIL (현재 값: \"${r1482?.excelBizNo}\")`);\n\n  // 3. Other populated companies\n  console.log('\\n--- ALL 77 TARGETS CURRENT BIZ_NO IN MASTER EXCEL ---');\n  let populatedCount = 0;\n  auditReport.forEach(r => {\n    if (r.excelBizNo && r.excelBizNo.trim() !== '') {\n      populatedCount++;\n      console.log(`[${r.index}/77] Row ${r.excelRow} | 연번 ${r.targetSeq} | ${r.targetName} (${r.targetCeo}) -> 사업자번호: \"${r.excelBizNo}\"`);\n    }\n  });\n\n  console.log(`\\nTotal Populated BizNo among 77 targets: ${populatedCount}`);\n\n  // Unpopulated count\n  const unpopulated = auditReport.filter(r => !r.excelBizNo || r.excelBizNo.trim() === '');\n  console.log(`Total Blank (Unregistered) among 77 targets: ${unpopulated.length}`);\n\n  // Also check column alignment of 77 rows\n  const misaligned = auditReport.filter(r => r.excelCorpNo && !r.excelCorpNo.startsWith('1801'));\n  console.log('\\n--- COLUMN ALIGNMENT AUDIT ---');\n  if (misaligned.length === 0) {\n    console.log('★ PASS: All 77 rows have valid corporate registration numbers (180111- / 180114- / 180115-) in Column G (7th col). No column shifts!');\n  } else {\n    console.log(`★ FAIL: ${misaligned.length} rows have misaligned corporate registration numbers:`);\n    misaligned.forEach(m => console.log(`  Row ${m.excelRow} [연번 ${m.targetSeq}]: corpNo=\"${m.excelCorpNo}\"`));\n  }\n}\n\naudit77TargetsInMasterExcel().catch(console.error);\n","Description":"Fix audit_master_excel script and run","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\audit_master_excel.js","toolAction":"Updating audit script","toolSummary":"Update audit_master_excel.js"}}]}
