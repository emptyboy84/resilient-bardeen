const results = [];\n\n  for (let i = 0; i < targets.length; i++) {\n    const t = targets[i];\n    const input = document.querySelector('input.q-field__native');\n    const btn = document.querySelector('button.btn-main-search');\n    if (!input || !btn) {\n      results.push({ ...t, error: 'input or btn missing' });\n      continue;\n    }\n\n    nativeInputValueSetter.call(input, t.corpNo);\n    input.dispatchEvent(new Event('input', { bubbles: true }));\n    input.dispatchEvent(new Event('change', { bubbles: true }));\n    await sleep(150);\n    btn.click();\n    await sleep(1400);\n\n    const items = Array.from(document.querySelectorAll('.q-list > .q-item, .search-result-list > li, li, .q-item')).map(el => el.innerText).filter(text => text.includes('대표자명'));\n\n    results.push({\n      ...t,\n      itemsFound: items.length,\n      rawText: items[0] || '검색결과 없음'\n    });\n  }\n\n  return JSON.stringify(results);\n}"},"ServerName":"playwright","ToolName":"browser_evaluate","toolAction":"Scanning batch 5 part 1","toolSummary":"Scan targets 61-69 in NICE BizINFO"}}]}
