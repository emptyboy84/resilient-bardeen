"  Found header at row {r}: {headers}\")\n                break\n        \n        # Check specific rows or search for targets (1200, 1254, 1274, 1482, etc.)\n        target_seqs = ['1200', '1254', '1274', '1288', '1346', '1465', '1482', '1697', '1852', '2320', '3504', '3661']\n        found_targets = []\n        \n        for r in range(header_row + 1, (sheet.max_row or 5000) + 1):\n            val1 = sheet.cell(row=r, column=1).value\n            if val1 is not None and str(val1).strip() in target_seqs:\n                row_data = [sheet.cell(row=r, column=c).value for c in range(1, 18)]\n                found_targets.append((r, str(val1).strip(), row_data))\n        \n        print(f\"  Matched target rows count: {len(found_targets)}\")\n        for r_idx, seq, r_data in found_targets[:15]:\n            print(f\"    Excel Row {r_idx} [연번 {seq}]: 상호={r_data[1]}, 대표={r_data[2]}, 사업자번호={r_data[5]}, 법인번호={r_data[6]}\")\n\nexcept Exception as e:\n    print(\"Error inspecting Excel:\", e)\n","Description":"Inspect target Excel file without modifying it","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\inspect_target_excel.py","toolAction":"Creating Excel inspector script","toolSummary":"Create inspect_target_excel.py"}}]}
