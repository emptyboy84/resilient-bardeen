wait fetch(url, {\n        headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }\n      });\n      const html = await res.text();\n      const postListIdx = html.indexOf('post-list');\n      if (postListIdx === -1) continue;\n      const snippet = html.substring(postListIdx, postListIdx + 15000);\n\n      // parse single-post\n      const posts = snippet.split('class=\"single-post');\n      for (let i = 1; i < posts.length; i++) {\n        const post = posts[i];\n        const artMatch = post.match(/\\/article\\/(\\d{10})/);\n        const titleMatch = post.match(/<h4>([^<]+)<\\/h4>/);\n        const title = titleMatch ? titleMatch[1].trim() : '';\n        const bizNo = artMatch ? artMatch[1] : '';\n\n        // Check ceo or address match\n        const hasCeo = post.includes(c.ceo.substring(0, 2)) || post.includes(c.ceo[0]);\n        const addrTokens = c.address.split(' ').slice(1, 4); // e.g. [\"기장군\", \"일광면\"] or [\"해운대구\", \"구남로\"]\n        const hasAddr = addrTokens.some(t => post.includes(t));\n\n        if (bizNo && (hasAddr || title.includes(c.cleanName))) {\n          // Verify candidate\n          return { bizNo, matchedTitle: title, method: url.includes('area') ? 'name+area' : 'query' };\n        }\n      }\n    } catch (e) {\n      // ignore\n    }\n    // slight delay\n    await new Promise(r => setTimeout(r, 200));\n  }\n  return null;\n}\n\nasync function run() {\n  console.log(`Starting Bizno search for ${targets.length} companies...`);\n  const results = [];\n  for (let i = 0; i < targets.length; i++) {\n    const c = targets[i];\n    const res = await searchBizno(c);\n    if (res) {\n      console.log(`[${i+1}/${targets.length}] FOUND: ${c.seq} ${c.name} (${c.ceo}) => ${res.bizNo} [${res.matchedTitle}]`);\n      results.push({ ...c, bizNo: res.bizNo, matchedTitle: res.matchedTitle });\n    } else {\n      console.log(`[${i+1}/${targets.length}] NOT FOUND: ${c.seq} ${c.name} (${c.ceo})`);\n      results.push({ ...c, bizNo: null });\n    }\n  }\n  fs.writeFileSync('bizno_crawl_results.json', JSON.stringify(results, null, 2), 'utf8');\n  console.log(`Done. Found ${results.filter(r => r.bizNo).length} / ${targets.length}`);\n}\n\nrun();\n","Description":"Script to batch crawl bizno for target companies","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\parse_company_data\\batch_bizno_search.js","toolAction":"Creating batch search script","toolSummary":"Create batch_bizno_search.js"}}]}
