      const ms = Number((lastTimeBig - 11644473600000000n) / 1000n);\n                date = new Date(ms);\n            }\n            entries.push({ url, title, date });\n        }\n    }\n}\n\nentries.sort((a, b) => (b.date || 0) - (a.date || 0));\n\nconsole.log(`\\n=== 25 Most Recent History Entries from Edge ===`);\nentries.slice(0, 25).forEach((e, idx) => {\n    console.log(`${idx + 1}. [${e.date ? e.date.toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : 'Unknown'}]`);\n    console.log(`   Title: ${e.title}`);\n    console.log(`   URL:   ${e.url}`);\n});\n","Description":"Parse SQLite history records accurately","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\44470555-939d-4160-8744-09bb2f099064\\scratch\\parse_sqlite_hist.js","toolAction":"Writing parse_sqlite_hist.js script","toolSummary":"Parse SQLite history"}}]}
