tern bool PrintWindow(IntPtr hWnd, IntPtr hdcBmp, uint nFlags);\n\n    const uint MOUSEEVENTF_LEFTDOWN = 0x0002;\n    const uint MOUSEEVENTF_LEFTUP   = 0x0004;\n    const uint KEYEVENTF_KEYUP      = 0x0002;\n\n    [StructLayout(LayoutKind.Sequential)]\n    public struct RECT {\n        public int Left;\n        public int Top;\n        public int Right;\n        public int Bottom;\n    }\n\n    public static void Attach() {\n        IntPtr hwinsta = OpenWindowStation(\"WinSta0\", false, 0x037F);\n        if (hwinsta != IntPtr.Zero) SetProcessWindowStation(hwinsta);\n        IntPtr hdesk = OpenDesktop(\"default\", 0, false, 0x01FF);\n        if (hdesk != IntPtr.Zero) SetThreadDesktop(hdesk);\n    }\n\n    public static IntPtr FindWindow() {\n        Attach();\n        IntPtr found = IntPtr.Zero;\n        IntPtr hdesk = OpenDesktop(\"default\", 0, false, 0x01FF);\n        if (hdesk != IntPtr.Zero) {\n            EnumDesktopWindows(hdesk, (hWnd, lParam) => {\n                int len = GetWindowTextLength(hWnd);\n                if (len > 0) {\n                    StringBuilder sb = new StringBuilder(len + 1);\n                    GetWindowText(hWnd, sb, sb.Capacity);\n                    string title = sb.ToString();\n                    if (title.Contains(\"드림캠퍼스\") && IsWindowVisible(hWnd)) {\n                        found = hWnd;\n                        return false;\n                    }\n                }\n                return true;\n            }, IntPtr.Zero);\n        }\n        return found;\n    }\n\n    public static void Click(int x, int y) {\n        Attach();\n        SetCursorPos(x, y);\n        Thread.Sleep(30);\n        mouse_event(MOUSEEVENTF_LEFTDOWN, (uint)x, (uint)y, 0, 0);\n        Thread.Sleep(30);\n        mouse_event(MOUSEEVENTF_LEFTUP, (uint)x, (uint)y, 0, 0);\n    }\n\n    public static void AdvanceNext(string savePath) {\n        Attach();\n        IntPtr hWnd = FindWindow();\n        if (hWnd == IntPtr.Zero) return;\n\n        SetForegroundWindow(hWnd);\n        Thread.Sleep(300);\n\n        RECT rect;\n        GetWindowRect(hWnd, out rect);\n        int w = rect.Right - rect.Left;\n        int h = rect.Bottom - rect.Top;\n\n        // Try exact coordinates for the '>' button\n        Console.WriteLine(\"Clicking '>' button at various points in bottom right...\");\n        Click(rect.Right - 5, rect.Bottom - 14);\n        Thread.Sleep(100);\n        Click(rect.Right - 8, rect.Bottom - 14);\n        Thread.Sleep(100);\n        Click(rect.Right - 12, rect.Bottom - 14);\n        Thread.Sleep(100);\n\n        // Also try F12 -> Console to inject full automation\n        Console.WriteLine(\"Sending F12...\");\n        keybd_event(0x7B, 0, 0, 0); // VK_F12 = 0x7B\n        Thread.Sleep(50);\n        keybd_event(0x7B, 0, KEYEVENTF_KEYUP, 0);\n\n        Thread.Sleep(2000);\n\n        using (Bitmap bmp = new Bitmap(w, h)) {\n            using (Graphics g = Graphics.FromImage(bmp)) {\n                IntPtr hdc = g.GetHdc();\n                PrintWindow(hWnd, hdc, 2);\n                g.ReleaseHdc(hdc);\n            }\n            bmp.Save(savePath, ImageFormat.Png);\n            Console.WriteLine(\"Captured: \" + savePath);\n        }\n    }\n}\n","Description":"Precision clicker and F12 sender","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\44470555-939d-4160-8744-09bb2f099064\\scratch\\PrecisionNav.cs","toolAction":"Writing PrecisionNav.cs","toolSummary":"Precision nav script"}}]}
