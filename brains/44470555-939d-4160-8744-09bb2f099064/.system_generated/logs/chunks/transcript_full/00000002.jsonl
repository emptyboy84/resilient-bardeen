n                }\n                return true;\n            }, IntPtr.Zero);\n        }\n        return found;\n    }\n\n    public static void Click(int x, int y) {\n        Attach();\n        SetCursorPos(x, y);\n        Thread.Sleep(50);\n        mouse_event(MOUSEEVENTF_LEFTDOWN, (uint)x, (uint)y, 0, 0);\n        Thread.Sleep(50);\n        mouse_event(MOUSEEVENTF_LEFTUP, (uint)x, (uint)y, 0, 0);\n    }\n\n    public static void ClickSidebar05AndCapture(string savePath) {\n        Attach();\n        IntPtr hWnd = FindWindow();\n        if (hWnd == IntPtr.Zero) return;\n\n        SetForegroundWindow(hWnd);\n        Thread.Sleep(300);\n\n        RECT rect;\n        GetWindowRect(hWnd, out rect);\n        int w = rect.Right - rect.Left;\n        int h = rect.Bottom - rect.Top;\n\n        // Click sidebar 05 at (Left + 120, Top + 585)\n        int x = rect.Left + 120;\n        int y = rect.Top + 585;\n        Console.WriteLine(\"Clicking sidebar 05 at: \" + x + \", \" + y);\n        Click(x, y);\n\n        Thread.Sleep(1500);\n\n        // Also if needed, click inside player area to start video if paused\n        // Video center is around (Left + 900, Top + 500)\n        Click(rect.Left + 900, rect.Top + 500);\n\n        Thread.Sleep(1000);\n\n        using (Bitmap bmp = new Bitmap(w, h)) {\n            using (Graphics g = Graphics.FromImage(bmp)) {\n                IntPtr hdc = g.GetHdc();\n                PrintWindow(hWnd, hdc, 2);\n                g.ReleaseHdc(hdc);\n            }\n            bmp.Save(savePath, ImageFormat.Png);\n            Console.WriteLine(\"Captured: \" + savePath);\n        }\n    }\n}\n","Description":"Click sidebar item 05 and verify","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\44470555-939d-4160-8744-09bb2f099064\\scratch\\ClickerTest.cs","toolAction":"Writing ClickerTest.cs","toolSummary":"Clicker test script"}}]}
