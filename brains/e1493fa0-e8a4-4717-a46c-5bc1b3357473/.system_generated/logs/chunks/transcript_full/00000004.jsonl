ers17), ...lines17.map(l => toCsvRow(l.split('\\t')))].join('\\r\\n');\nconst csv16 = '\\uFEFF' + [toCsvRow(headers16), ...lines16.map(l => toCsvRow(l.split('\\t')))].join('\\r\\n');\nconst csv18 = '\\uFEFF' + [toCsvRow(headers18), ...lines18.map(l => toCsvRow(l.split('\\t')))].join('\\r\\n');\n\nfs.writeFileSync(path.join(todayDir, '배현명_실사DB_200개기업_17컬럼_검증완료_최신.csv'), csv17, 'utf-8');\nfs.writeFileSync(path.join(todayDir, '배현명_실사DB_200개기업_16컬럼_검증완료_최신.csv'), csv16, 'utf-8');\nfs.writeFileSync(path.join(todayDir, '배현명_실사DB_200개기업_18컬럼_작성자포함_최신.csv'), csv18, 'utf-8');\n\nconsole.log('Saved 3 최신 CSV files to Desktop/오늘');\n","Description":"Save updated CSVs to Desktop/오늘","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\e1493fa0-e8a4-4717-a46c-5bc1b3357473\\scratch\\export_latest_all.js","toolAction":"Creating export script","toolSummary":"Write export_latest_all.js"}}]}
