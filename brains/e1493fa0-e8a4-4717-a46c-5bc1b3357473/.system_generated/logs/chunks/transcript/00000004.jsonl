// 선도\\n  return [test1, test2];\\n}\"}","ServerName":"\"playwright\"","ToolName":"\"browser_evaluate\"","toolAction":"\"Testing clean query mechanism on nicebizinfo\"","toolSummary":"\"Test query mechanism\""}}]}
