{"step_index":1428,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-14T01:55:50Z","content":"Created At: 2026-09-14T10:55:50+09:00\nCompleted At: 2026-09-14T10:55:51+09:00\nFile Path: `file:///C:/Users/lg/.gemini/antigravity/brain/22cde527-6a05-4644-ad41-9385bbc0ffd2/scratch/run_full_verification.js`\nTotal Lines: 354\nTotal Bytes: 13851\nShowing lines 1 to 354\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const fs = require('fs');\n2: const path = require('path');\n3: \n4: const SCRATCH_DIR = 'C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch';\n5: const missingFile = path.join(SCRATCH_DIR, 'missing_421.json');\n6: const resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\n7: \n8: const missing = JSON.parse(fs.readFileSync(missingFile, 'utf8'));\n9: \n10: // 국세청 사업자등록번호 10자리 체크섬\n11: function isValidBizNo(b) {\n12:     if (!b) return false;\n13:     const clean = b.replace(/[^0-9]/g, '');\n14:     if (clean.length !== 10) return false;\n15:     const weights = [1, 3, 7, 1, 3, 7, 1, 3, 5];\n16:     let sum = 0;\n17:     for (let i = 0; i < 8; i++) {\n18:         sum += Number(clean[i]) * weights[i];\n19:     }\n20:     const d9 = Number(clean[8]) * 5;\n21:     sum += Math.floor(d9 / 10) + (d9 % 10);\n22:     const check = (10 - (sum % 10)) % 10;\n23:     return check === Number(clean[9]);\n24: }\n25: \n26: function formatBizNo(b) {\n27:     const clean = b.replace(/[^0-9]/g, '');\n28:     return `${clean.slice(0, 3)}-${clean.slice(3, 5)}-${clean.slice(5)}`;\n29: }\n30: \n31: function cleanCompanyName(name) {\n32:     if (!name) return '';\n33:     return name.replace(/\\(주\\)|주식회사|㈜|\\(유\\)|유한회사|\\(재\\)|재단법인|\\(사\\)|사단법인/g, '')\n34:                .replace(/[\\s\\-_.,\\(\\)\\[\\]]/g, '')\n35:                .toLowerCase();\n36: }\n37: \n38: function extractBusanDistrict(address) {\n39:     if (!address) return '';\n40:     const m = address.match(/(해운대구|부산진구|동래구|남구|북구|사상구|사하구|금정구|연제구|수영구|중구|동구|서구|영도구|강서구|기장군)/);\n41:     return m ? m[1] : '';\n42: }\n43: \n44: function isBusanAddress(addr) {\n45:     if (!addr) return false;\n46:     const nonBusan = /전남|광주|대구|인천|대전|울산|경기|강원|충북|충남|전북|경북|경남|제주|서울/;\n47:     if (addr.includes('부산')) return true;\n48:     if (extractBusanDistrict(addr) && !nonBusan.test(addr)) return true;\n49:     return false;\n50: }\n51: \n52: // Strict CEO match\n53: function ceoMatches(targetCeo, candidateCeo) {\n54:     if (!targetCeo || targetCeo.trim().length === 0) return true; // No target CEO specified in CSV\n55:     if (!candidateCeo || candidateCeo.trim().length === 0) return false; // Target has CEO, candidate has none\n56: \n57:     const tList = targetCeo.split(/[,/]/).map(s => s.trim().replace(/\\s/g, '')).filter(s => s.length > 0);\n58:     const c = candidateCeo.replace(/[\\s]/g, '');\n59: \n60:     for (const t of tList) {\n61:         if (c === t) return true;\n62:         // Masked: e.g. t = \"최장수\", c = \"최장*\"\n63:         if (c.endsWith('*') && c.length > 1) {\n64:             const prefix = c.replace(/\\*/g, '');\n65:             if (prefix.length >= 2 && t.startsWith(prefix)) return true;\n66:         }\n67:         // Masked middle: e.g. t = \"최장수\", c = \"최*수\"\n68:         if (c.length === 3 && c[1] === '*' && t.length === 3 && c[0] === t[0] && c[2] === t[2]) return true;\n69:     }\n70:     return false;\n71: }\n72: \n73: // Fetch Bizno article details\n74: async function fetchBiznoDetail(biznoDigits) {\n75:     try {\n76:         const url = `https://bizno.net/article/${biznoDigits}`;\n77:         const res = await fetch(url, {\n78:             headers: {\n79:                 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n80:             }\n81:         });\n82:         if (!res.ok) return null;\n83:         const html = await res.text();\n84:         const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n85: \n86:         // Title from <title> tag\n87:         const titleMatch = html.match(/<title>([^<]+)<\\/title>/i);\n88:         let title = titleMatch ? titleMatch[1].trim() : '';\n89:         if (title.includes('|')) title = title.split('|')[0].trim();\n90:         if (title.includes('-')) title = title.split('-')[0].trim();\n91: \n92:         if (!title || title.length < 2) return null;\n93: \n94:         let ceo = '';\n95:         const ceoM = text.match(/대표자명\\s*:\\s*([^\\s]+)/);\n96:         if (ceoM) ceo = ceoM[1].trim();\n97: \n98:         let addr = '';\n99:         const addrM = text.match(/주소\\s*:\\s*([^\"]+?)(?=\\s*\\(우|\\s*대표자|\\s*사업자등록번호|\\s*종업원수|\\s*설립일|\\s*$)/);\n100:         if (addrM) addr = addrM[1].trim();\n101: \n102:         let status = '';\n103:         const statM = text.match(/사업자\\s*현재\\s*상태[^\\:]*:\\s*([^\\s]+)/);\n104:         if (statM) status = statM[1].trim();\n105: \n106:         return {\n107:             bizno: formatBizNo(biznoDigits),\n108:             title,\n109:             ceo,\n110:             address: addr,\n111:             status,\n112:             sourceUrl: url\n113:         };\n114:     } catch (e) {\n115:         return null;\n116:     }\n117: }\n118: \n119: // 1. Search Bizno\n120: async function searchBizno(name, targetDistrict, targetCeo) {\n121:     const q = cleanCompanyName(name);\n122:     if (!q || q.length < 2) return null;\n123: \n124:     try {\n125:         const url = 'https://bizno.net/?query=' + encodeURIComponent(q);\n126:         const res = await fetch(url, {\n127:             headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }\n128:         });\n129:         if (!res.ok) return null;\n130:         const html = await res.text();\n131: \n132:         const candidates = [];\n133:         const linkRegex = /<a\\s+href=\"\\/article\\/(\\d{10})\"[^>]*>([\\s\\S]*?)<\\/a>([\\s\\S]*?)(?=<a\\s+href=\"\\/article|\\n\\s*<div class=\"footer|\\$)/gi;\n134:         let lm;\n135:         while ((lm = linkRegex.exec(html)) !== null) {\n136:             const rawBiz = lm[1];\n137:             const itemTitle = lm[2].replace(/<[^>]+>/g, '').trim();\n138:             const snippet = lm[3].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n139:             if (snippet.includes('adsbygoogle') || snippet.includes('실시간 조회기업')) {\n140:                 const cutIdx = snippet.search(/adsbygoogle|실시간 조회기업/);\n141:                 candidates.push({ bizno: rawBiz, title: itemTitle, snippet: snippet.slice(0, cutIdx) });\n142:                 break;\n143:             }\n144:             candidates.push({ bizno: rawBiz, title: itemTitle, snippet });\n145:         }\n146: \n147:         const cleanTarget = cleanCompanyName(name);\n148:         for (const c of candidates) {\n149:             if (!isValidBizNo(c.bizno)) continue;\n150:             const cName = cleanCompanyName(c.title);\n151:             if (!cName || cName.length < 2) continue;\n152: \n153:             const isNameEqual = (cName === cleanTarget);\n154:             const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n155:             if (!isNameEqual && !isSub) continue;\n156:             if (!isNameEqual) {\n157:                 const minLen = Math.min(cName.length, cleanTarget.length);\n158:                 const maxLen = Math.max(cName.length, cleanTarget.length);\n159:                 if (minLen / maxLen < 0.6) continue;\n160:             }\n161: \n162:             const isBusan = isBusanAddress(c.snippet);\n163:             const isDist = targetDistrict && c.snippet.includes(targetDistrict);\n164: \n165:             if (isBusan || isDist) {\n166:                 const full = await fetchBiznoDetail(c.bizno);\n167:                 if (full && isBusanAddress(full.address)) {\n168:                     if (targetDistrict && !full.address.includes(targetDistrict)) {\n169:                         if (!targetCeo || !ceoMatches(targetCeo, full.ceo)) continue;\n170:                     }\n171:                     if (targetCeo && !ceoMatches(targetCeo, full.ceo)) continue;\n172:                     return full;\n173:                 }\n174:             }\n175:         }\n176:     } catch (e) {}\n177:     return null;\n178: }\n179: \n180: // 2. Search Naver\n181: async function searchNaver(name, targetDistrict, targetCeo) {\n182:     const cleanTarget = cleanCompanyName(name);\n183:     if (!cleanTarget || cleanTarget.length < 2) return null;\n184: \n185:     try {\n186:         let q = `${name} 부산`;\n187:         if (targetDistrict) q += ` ${targetDistrict}`;\n188:         if (targetCeo) q += ` ${targetCeo}`;\n189:         q += ' 사업자등록번호';\n190: \n191:         const url = 'https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=' + encodeURIComponent(q);\n192:         const res = await fetch(url, {\n193:             headers: {\n194:                 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n195:             }\n196:         });\n197:         if (!res.ok) return null;\n198:         const html = await res.text();\n199: \n200:         const bizMatches = html.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n201:         if (!bizMatches) return null;\n202: \n203:         const unique = [...new Set(bizMatches)];\n204:         for (const b of unique) {\n205:             if (!isValidBizNo(b)) continue;\n206:             const digits = b.replace(/[^0-9]/g, '');\n207: \n208:             const full = await fetchBiznoDetail(digits);\n209:             if (!full || !full.title || full.title.length < 2) continue;\n210:             if (!isBusanAddress(full.address)) continue;\n211: \n212:             const cName = cleanCompanyName(full.title);\n213:             const isNameEqual = (cName === cleanTarget);\n214:             const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n215:             if (!isNameEqual && !isSub) continue;\n216:             if (!isNameEqual) {\n217:                 const minLen = Math.min(cName.length, cleanTarget.length);\n218:                 const maxLen = Math.max(cName.length, cleanTarget.length);\n219:                 if (minLen / maxLen < 0.6) continue;\n220:             }\n221: \n222:             if (targetDistrict && !full.address.includes(targetDistrict)) {\n223:                 if (!targetCeo || !ceoMatches(targetCeo, full.ceo)) continue;\n224:             }\n225:             if (targetCeo && !ceoMatches(targetCeo, full.ceo)) continue;\n226: \n227:             full.matchedVia = 'NaverSearch+BiznoDetail';\n228:             return full;\n229:         }\n230:     } catch (e) {}\n231:     return null;\n232: }\n233: \n234: // 3. Search DuckDuckGo (Global Index)\n235: async function searchDDG(name, targetDistrict, targetCeo) {\n236:     const cleanTarget = cleanCompanyName(name);\n237:     if (!cleanTarget || cleanTarget.length < 2) return null;\n238: \n239:     try {\n240:         let q = `\"${name}\" 부산`;\n241:         if (targetDistrict) q += ` \"${targetDistrict}\"`;\n242:         if (targetCeo) q += ` \"${targetCeo}\"`;\n243:         q += ' 사업자등록번호';\n244: \n245:         const url = 'https://html.duckduckgo.com/html/?q=' + encodeURIComponent(q);\n246:         const res = await fetch(url, {\n247:             headers: {\n248:                 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n249:             }\n250:         });\n251:         if (!res.ok) return null;\n252:         const html = await res.text();\n253: \n254:         const bizMatches = html.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n255:         if (!bizMatches) return null;\n256: \n257:         const unique = [...new Set(bizMatches)];\n258:         for (const b of unique) {\n259:             if (!isValidBizNo(b)) continue;\n260:             const digits = b.replace(/[^0-9]/g, '');\n261: \n262:             const full = await fetchBiznoDetail(digits);\n263:             if (!full || !full.title || full.title.length < 2) continue;\n264:             if (!isBusanAddress(full.address)) continue;\n265: \n266:             const cName = cleanCompanyName(full.title);\n267:             const isNameEqual = (cName === cleanTarget);\n268:             const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n269:             if (!isNameEqual && !isSub) continue;\n270:             if (!isNameEqual) {\n271:                 const minLen = Math.min(cName.length, cleanTarget.length);\n272:                 const maxLen = Math.max(cName.length, cleanTarget.length);\n273:                 if (minLen / maxLen < 0.6) continue;\n274:             }\n275: \n276:             if (targetDistrict && !full.address.includes(targetDistrict)) {\n277:                 if (!targetCeo || !ceoMatches(targetCeo, full.ceo)) continue;\n278:             }\n279:             if (targetCeo && !ceoMatches(targetCeo, full.ceo)) continue;\n280: \n281:             full.matchedVia = 'DDG+BiznoDetail';\n282:             return full;\n283:         }\n284:     } catch (e) {}\n285:     return null;\n286: }\n287: \n288: async function run() {\n289:     console.log(`Starting STRICT Pass 1 verification for ${missing.length} records...`);\n290:     const progress = {};\n291:     let matchedCount = 0;\n292:     let unverifiableCount = 0;\n293: \n294:     for (let i = 0; i < missing.length; i++) {\n295:         const item = missing[i];\n296:         const key = String(item.rowNumber);\n297:         const district = extractBusanDistrict(item.address);\n298: \n299:         console.log(`[${i + 1}/${missing.length}] Row ${item.rowNumber} | \"${item.name}\" | 대표: \"${item.ceo}\" | 구: \"${district}\"`);\n300: \n301:         // 1. Bizno\n302:         let match = await searchBizno(item.name, district, item.ceo);\n303:         if (match) match.matchedVia = 'BiznoSearch';\n304: \n305:         // 2. Naver\n306:         if (!match) {\n307:             match = await searchNaver(item.name, district, item.ceo);\n308:         }\n309: \n310:         // 3. DDG\n311:         if (!match) {\n312:             match = await searchDDG(item.name, district, item.ceo);\n313:         }\n314: \n315:         if (match) {\n316:             console.log(`  => MATCH CONFIRMED: ${match.bizno} (${match.title}) | 주소: \"${match.address}\" | 대표: \"${match.ceo}\" [${match.status}]`);\n317:             progress[key] = {\n318:                 rowNumber: item.rowNumber,\n319:                 name: item.name,\n320:                 bizno: match.bizno,\n321:                 matchedTitle: match.title,\n322:                 matchedCeo: match.ceo,\n323:                 matchedAddress: match.address,\n324:                 status: match.status,\n325:                 sourceUrl: match.sourceUrl,\n326:                 matchedVia: match.matchedVia\n327:             };\n328:             matchedCount++;\n329:         } else {\n330:             console.log(`  => UNVERIFIED / PENDING PASS 2`);\n331:             progress[key] = {\n332:                 rowNumber: item.rowNumber,\n333:                 name: item.name,\n334:                 bizno: null,\n335:                 reason: '미등록 또는 식별 불명'\n336:             };\n337:             unverifiableCount++;\n338:         }\n339: \n340:         // Save progress every 10 items\n341:         if ((i + 1) % 10 === 0 || i === missing.length - 1) {\n342:             fs.writeFileSync(resultsFile, JSON.stringify(progress, null, 2), 'utf8');\n343:             console.log(`  >>> Progress Saved: ${i + 1}/${missing.length} | Matched: ${matchedCount} | Unverifiable: ${unverifiableCount} <<<`);\n344:         }\n345: \n346:         await new Promise(r => setTimeout(r, 120));\n347:     }\n348: \n349:     console.log('\\n================ PASS 1 COMPLETED ================');\n350:     console.log(`Total: ${missing.length}, Matched: ${matchedCount}, Unverifiable: ${unverifiableCount}`);\n351: }\n352: \n353: run();\n354: \nThe above content shows the entire, complete file contents of the requested file.\n"}
