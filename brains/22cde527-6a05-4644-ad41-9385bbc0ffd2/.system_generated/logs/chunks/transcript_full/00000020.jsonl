재\\)|재단법인|\\(사\\)|사단법인/g, '')\n36:                .replace(/[\\s\\-_.,\\(\\)\\[\\]]/g, '')\n37:                .toLowerCase();\n38: }\n39: \n40: function extractBusanDistrict(address) {\n41:     if (!address) return '';\n42:     const m = address.match(/(해운대구|부산진구|동래구|남구|북구|사상구|사하구|금정구|연제구|수영구|중구|동구|서구|영도구|강서구|기장군)/);\n43:     return m ? m[1] : '';\n44: }\n45: \n46: function isBusanAddress(addr) {\n47:     if (!addr) return false;\n48:     return addr.includes('부산');\n49: }\n50: \n51: function ceoMatches(targetCeo, candidateCeo) {\n52:     if (!targetCeo || targetCeo.trim().length === 0) return true;\n53:     if (!candidateCeo || candidateCeo.trim().length === 0) return false;\n54: \n55:     const tList = targetCeo.split(/[,/]/).map(s => s.trim().replace(/\\s/g, '')).filter(s => s.length > 0);\n56:     const c = candidateCeo.replace(/[\\s]/g, '');\n57: \n58:     for (const t of tList) {\n59:         if (c === t) return true;\n60:         if (c.endsWith('*') && c.length > 1) {\n61:             const prefix = c.replace(/\\*/g, '');\n62:             if (prefix.length >= 2 && t.startsWith(prefix)) return true;\n63:         }\n64:         if (c.length === 3 && c[1] === '*' && t.length === 3 && c[0] === t[0] && c[2] === t[2]) return true;\n65:     }\n66:     return false;\n67: }\n68: \n69: // Check title similarity strictly\n70: function titlesMatch(target, candidate) {\n71:     const t = cleanCompanyName(target);\n72:     const c = cleanCompanyName(candidate);\n73:     if (!t || !c) return false;\n74:     if (t === c) return true;\n75: \n76:     // Substring only if long enough and high ratio\n77:     const minL = Math.min(t.length, c.length);\n78:     const maxL = Math.max(t.length, c.length);\n79:     if (minL >= 3 && (c.includes(t) || t.includes(c)) && (minL / maxL >= 0.75)) {\n80:         return true;\n81:     }\n82:     return false;\n83: }\n84: \n85: async function fetchBiznoDetail(biznoDigits) {\n86:     try {\n87:         const url = `https://bizno.net/article/${biznoDigits}`;\n88:         const res = await fetch(url, {\n89:             headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' },\n90:             signal: AbortSignal.timeout(4000)\n91:         });\n92:         if (!res.ok) return null;\n93:         const html = await res.text();\n94:         const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n95: \n96:         const titleMatch = html.match(/<title>([^<]+)<\\/title>/i);\n97:         let title = titleMatch ? titleMatch[1].trim() : '';\n98:         if (title.includes('|')) title = title.split('|')[0].trim();\n99:         if (title.includes('-')) title = title.split('-')[0].trim();\n100:         if (!title || title.length < 2) return null;\n101: \n102:         let ceo = '';\n103:         const ceoM = text.match(/대표자명\\s*:\\s*([^\\s]+)/);\n104:         if (ceoM) ceo = ceoM[1].trim();\n105: \n106:         let addr = '';\n107:         const addrM = text.match(/회사주소\\s*:\\s*([^\"]+?)(?=\\s*\\(우|\\s*대표자|\\s*사업자등록번호|\\s*종업원수|\\s*설립일|\\s*$)/);\n108:         if (addrM) addr = addrM[1].trim();\n109: \n110:         let status = '';\n111:         const statM = text.match(/사업자\\s*현재\\s*상태[^\\:]*:\\s*([^\\s]+)/);\n112:         if (statM) status = statM[1].trim();\n113: \n114:         return {\n115:             bizno: formatBizNo(biznoDigits),\n116:             title,\n117:             ceo,\n118:             address: addr,\n119:             status,\n120:             sourceUrl: url\n121:         };\n122:     } catch (e) {\n123:         return null;\n124:     }\n125: }\n126: \n127: async function deepInvestigate(item) {\n128:     const cleanTarget = cleanCompanyName(item.name);\n129:     if (!cleanTarget || cleanTarget.length < 2) return null;\n130:     const district = extractBusanDistrict(item.address);\n131: \n132:     // 1. Bizno Search\n133:     try {\n134:         const bUrl = 'https://bizno.net/?query=' + encodeURIComponent(cleanTarget);\n135:         const bRes = await fetch(bUrl, {\n136:             headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' },\n137:             signal: AbortSignal.timeout(3500)\n138:         });\n139:         if (bRes.ok) {\n140:             const bHtml = await bRes.text();\n141:             const linkRegex = /<a\\s+href=\"\\/article\\/([0-9]{10})\"[^>]*>([\\s\\S]*?)<\\/a>/gi;\n142:             let lm;\n143:             const candidateIds = [];\n144:             while ((lm = linkRegex.exec(bHtml)) !== null) {\n145:                 const bId = lm[1];\n146:                 const rawTitle = lm[2].replace(/<[^>]+>/g, '').trim();\n147:                 if (titlesMatch(item.name, rawTitle)) {\n148:                     candidateIds.push(bId);\n149:                 }\n150:             }\n151: \n152:             for (const bId of candidateIds.slice(0, 4)) {\n153:                 if (!isValidBizNo(bId)) continue;\n154:                 const detail = await fetchBiznoDetail(bId);\n155:                 if (detail && isBusanAddress(detail.address)) {\n156:                     if (titlesMatch(item.name, detail.title)) {\n157:                         if (district && !detail.address.includes(district)) {\n158:                             if (!item.ceo || !ceoMatches(item.ceo, detail.ceo)) continue;\n159:                         }\n160:                         if (item.ceo && !ceoMatches(item.ceo, detail.ceo)) continue;\n161: \n162:                         detail.matchedVia = 'Pass2_BiznoDeep';\n163:                         return detail;\n164:                     }\n165:                 }\n166:             }\n167:         }\n168:     } catch (e) {}\n169: \n170:     // 2. Naver Search\n171:     try {\n172:         let q = `${item.name} 부산`;\n173:         if (district) q += ` ${district}`;\n174:         if (item.ceo) q += ` ${item.ceo}`;\n175:         q += ' 사업자등록번호';\n176: \n177:         const nUrl = 'https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=' + encodeURIComponent(q);\n178:         const nRes = await fetch(nUrl, {\n179:             headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' },\n180:             signal: AbortSignal.timeout(3500)\n181:         });\n182:         if (nRes.ok) {\n183:             const nHtml = await nRes.text();\n184:             const bMatches = nHtml.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n185:             if (bMatches) {\n186:                 const unique = [...new Set(bMatches)];\n187:                 for (const b of unique.slice(0, 3)) {\n188:                     if (!isValidBizNo(b)) continue;\n189:                     const digits = b.replace(/[^0-9]/g, '');\n190:                     const detail = await fetchBiznoDetail(digits);\n191:                     if (detail && isBusanAddress(detail.address)) {\n192:                         if (titlesMatch(item.name, detail.title)) {\n193:                             if (district && !detail.address.includes(district)) {\n194:                                 if (!item.ceo || !ceoMatches(item.ceo, detail.ceo)) continue;\n195:                             }\n196:                             if (item.ceo && !ceoMatches(item.ceo, detail.ceo)) continue;\n197:                             detail.matchedVia = 'Pass2_NaverDeep';\n198:                             return detail;\n199:                         }\n200:                     }\n201:                 }\n202:             }\n203:         }\n204:     } catch (e) {}\n205: \n206:     return null;\n207: }\n208: \n209: async function runPass2() {\n210:     console.log('=== Starting Concurrent PASS 2 Deep Grounding ===');\n211:     const results = JSON.parse(fs.readFileSync(resultsFile, 'utf8'));\n212: \n213:     // Remove false positive from Row 547 if it existed\n214:     if (results['547'] && results['547'].bizno === '617-15-99417') {\n215:         results['547'] = { rowNumber: 547, name: '냉이영화', bizno: null, reason: 'False positive pruned' };\n216:     }\n217: \n218:     const unverifiedKeys = Object.keys(results).filter(k => results[k].bizno === null);\n219:     console.log(`Analyzing ${unverifiedKeys.length} unverified records with Concurrency 6...`);\n220: \n221:     let newlyMatched = 0;\n222:     const CONCURRENCY = 6;\n223: \n224:     for (let i = 0; i < unverifiedKeys.length; i += CONCURRENCY) {\n225:         const batchKeys = unverifiedKeys.slice(i, i + CONCURRENCY);\n226:         const promises = batchKeys.map(async (key) => {\n227:             const item = missingMap[key];\n228:             if (!item) return;\n229: \n230:             const match = await deepInvestigate(item);\n231:             if (match) {\n232:                 console.log(`  🎉 [Row ${item.rowNumber}] \"${item.name}\" => ${match.bizno} (${match.title}) [${match.address}]`);\n233:                 results[key] = {\n234:                     rowNumber: item.rowNumber,\n235:                     name: item.name,\n236:                     bizno: match.bizno,\n237:                     matchedTitle: match.title,\n238:                     matchedCeo: match.ceo,\n239:                     matchedAddress: match.address,\n240:                     status: match.status,\n241:                     sourceUrl: match.sourceUrl,\n242:                     matchedVia: match.matchedVia\n243:                 };\n244:                 newlyMatched++;\n245:             }\n246:         });\n247: \n248:         await Promise.all(promises);\n249:         console.log(`Progress: ${Math.min(i + CONCURRENCY, unverifiedKeys.length)} / ${unverifiedKeys.length} (Recovered: ${newlyMatched})`);\n250:         fs.writeFileSync(resultsFile, JSON.stringify(results, null, 2), 'utf8');\n251:         await new Promise(r => setTimeout(r, 100));\n252:     }\n253: \n254:     console.log(`\\n=== PASS 2 FINISHED ===`);\n255:     console.log(`Newly recovered in Pass 2: ${newlyMatched}`);\n256:     const totalMatched = Object.values(results).filter(r => r.bizno !== null).length;\n257:     console.log(`Total verified business numbers: ${totalMatched} / 421`);\n258: }\n259: \n260: runPass2();\n261: \nThe above content shows the entire, complete file contents of the requested file.\n"}
