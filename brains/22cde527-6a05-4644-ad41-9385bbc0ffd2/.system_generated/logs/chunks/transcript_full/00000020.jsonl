ntigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\check_unverified.js\",\"LineNumber\":6,\"LineContent\":\"const results = JSON.parse(fs.readFileSync(path.join(SCRATCH_DIR, 'verified_results.json'), 'utf8'));\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\consolidate_master_194.js\",\"LineNumber\":7,\"LineContent\":\"const verifiedResults = JSON.parse(fs.readFileSync(path.join(SCRATCH_DIR, 'verified_results.json'), 'utf8'));\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\generate_final_deliverables.js\",\"LineNumber\":14,\"LineContent\":\"const verifiedResultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\generate_detailed_audit_report.js\",\"LineNumber\":6,\"LineContent\":\"const v = JSON.parse(fs.readFileSync(path.join(SCRATCH_DIR, 'verified_results.json'), 'utf8'));\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\fill_all_columns_and_export.js\",\"LineNumber\":10,\"LineContent\":\"const verifiedResultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\target_recovery.js\",\"LineNumber\":5,\"LineContent\":\"const resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\run_full_verification.js\",\"LineNumber\":6,\"LineContent\":\"const resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\save_final_excel.js\",\"LineNumber\":13,\"LineContent\":\"const verifiedResultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\run_pass2_deep_search.js\",\"LineNumber\":6,\"LineContent\":\"const resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}\n{\"File\":\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\populate_all_missing_fields.js\",\"LineNumber\":14,\"LineContent\":\"const verifiedResultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\"}"}
