     \n78:       // Col 15: 비고\n79:       if (!row.getCell(15).value && verified.status === '폐업자') setRed(15, '폐업');\n80:       \n81:       // Col 16: 종사자수(명) 25년 기준\n82:       if (!row.getCell(16).value && verified.emp) setRed(16, verified.emp);\n83:       \n84:       // Col 17: 24년 매출액(원)\n85:       if (r === 2307 && !row.getCell(17).value) {\n86:         // 피커스튜디오 saramin (NICE평가정보) 192만원\n87:         setRed(17, '1,920,000');\n88:       }\n89:       \n90:       // Col 19: 데이터 출처\n91:       setRed(19, verified.source);\n92:     }\n93:   }\n94:   \n95:   // Set freeze pane on row 1\n96:   ws.views = [{ state: 'frozen', xSplit: 0, ySplit: 1, activeCell: 'A2' }];\n97:   \n98:   // Set auto filter\n99:   ws.autoFilter = {\n100:     from: { row: 1, column: 1 },\n101:     to: { row: 1, column: 19 }\n102:   };\n103:   \n104:   console.log(`Updated ${filledRowsCount} rows with ${filledCellsCount} red bold cells.`);\n105:   \n106:   // Save Excel\n107:   try {\n108:     await wb.xlsx.writeFile(targetXlsxPath);\n109:     console.log('Saved updated Excel to:', targetXlsxPath);\n110:   } catch (err) {\n111:     if (err.code === 'EBUSY') {\n112:       const fallbackPath = 'C:/Users/lg/Desktop/오늘/(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_최종.xlsx';\n113:       console.log('Warning: Original Excel is currently open in Excel application! Saving to fallback:', fallbackPath);\n114:       await wb.xlsx.writeFile(fallbackPath);\n115:       console.log('Successfully saved to fallback:', fallbackPath);\n116:     } else {\n117:       throw err;\n118:     }\n119:   }\n120:   \n121:   // Save CSV (UTF-8 BOM)\n122:   const csvRows = [];\n123:   for (let r = 1; r <= ws.rowCount; r++) {\n124:     const row = ws.getRow(r);\n125:     const rowVals = [];\n126:     for (let c = 1; c <= 19; c++) {\n127:       let v = row.getCell(c).value;\n128:       if (v === null || v === undefined) v = '';\n129:       else v = String(v).trim();\n130:       \n131:       if (v.includes(',') || v.includes('\"') || v.includes('\\n')) {\n132:         v = `\"${v.replace(/\"/g, '\"\"')}\"`;\n133:       }\n134:       rowVals.push(v);\n135:     }\n136:     csvRows.push(rowVals.join(','));\n137:   }\n138:   \n139:   const csvContent = '\\uFEFF' + csvRows.join('\\r\\n');\n140:   try {\n141:     fs.writeFileSync(targetCsvPath, csvContent, 'utf8');\n142:     console.log('Saved updated CSV to:', targetCsvPath);\n143:   } catch (err) {\n144:     if (err.code === 'EBUSY') {\n145:       const fallbackCsv = 'C:/Users/lg/Desktop/오늘/(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_최종.csv';\n146:       fs.writeFileSync(fallbackCsv, csvContent, 'utf8');\n147:       console.log('Saved fallback CSV to:', fallbackCsv);\n148:     } else {\n149:       throw err;\n150:     }\n151:   }\n152: }\n153: \n154: updateFiles();\n155: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
