= desc.match(/설립일\\(신고\\/인허가일\\)\\s*:\\s*([^;]+?)(?=\\s+(?:대표자명|전화번호|회사주소|$))/i);\n57:   if (mEst) estDate = mEst[1].trim();\n58:   \n59:   const mEmp = desc.match(/종업원수\\s*:\\s*(\\d+)명/i);\n60:   if (mEmp) emp = mEmp[1].trim();\n61:   \n62:   if (desc.includes('폐업') || html.includes('폐업')) {\n63:     status = '폐업자';\n64:     const mClose = html.match(/폐업일자\\s*[:：]?\\s*(\\d{4}[-.]\\d{2}[-.]\\d{2})/i) || html.match(/(\\d{4}[-.]\\d{2}[-.]\\d{2})\\s*폐업/i);\n65:     if (mClose) closeDate = mClose[1].replace(/\\./g, '-');\n66:   }\n67:   \n68:   return { rep, addr, tel, estDate, emp, status, closeDate, url };\n69: }\n70: \n71: async function searchNaverSnippet(q) {\n72:   const url = `https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=${encodeURIComponent(q)}`;\n73:   const html = await fetchUrl(url);\n74:   if (!html) return [];\n75:   \n76:   const matches = html.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g) || [];\n77:   const valid = [];\n78:   for (const m of matches) {\n79:     if (isValidBizNo(m) && !valid.includes(m)) valid.push(m);\n80:   }\n81:   return valid;\n82: }\n83: \n84: function normalize(s) {\n85:   if (!s) return '';\n86:   return s.replace(/[^a-zA-Z0-9가-힣]/g, '').toLowerCase();\n87: }\n88: \n89: async function processCompany(comp) {\n90:   // Build 3 queries\n91:   const queries = [];\n92:   if (comp.name) {\n93:     queries.push(`\"${comp.name}\" \"사업자등록번호\"`);\n94:     if (comp.ceo) queries.push(`\"${comp.name}\" \"${comp.ceo}\"`);\n95:     if (comp.phone) queries.push(`\"${comp.name}\" \"${comp.phone}\"`);\n96:   }\n97:   \n98:   for (const q of queries) {\n99:     const candidateBiznos = await searchNaverSnippet(q);\n100:     for (const cand of candidateBiznos) {\n101:       const details = await searchBiznoArticle(cand);\n102:       if (!details) continue;\n103:       \n104:       // Check if location is Busan\n105:       const inBusan = details.addr.includes('부산') || /강서구|금정구|기장군|남구|동구|동래구|부산진구|북구|사상구|사하구|서구|수영구|연제구|영도구|