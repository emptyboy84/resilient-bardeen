단체';\r\n17:   return '기타';\r\n18: }\r\n19: \r\n20: function isValidCorpNo(corpNo) {\r\n21:   if (!corpNo) return false;\r\n22:   const clean = corpNo.replace(/[^0-9]/g, '');\r\n23:   if (clean.length !== 13) return false;\r\n24:   const weights = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2];\r\n25:   let sum = 0;\r\n26:   for (let i = 0; i < 12; i++) {\r\n27:     sum += Number(clean[i]) * weights[i];\r\n28:   }\r\n29:   const remainder = sum % 10;\r\n30:   const checkDigit = (10 - remainder) % 10;\r\n31:   return Number(clean[12]) === checkDigit;\r\n32: }\r\n33: \r\n34: const audit = lines.map((l, idx) => {\r\n35:   const p = l.split('\\t');\r\n36:   const company = (p[2] || '').trim();\r\n37:   const bizno = (p[3] || '').trim();\r\n38:   const corpNo = (p[13] || '').trim();\r\n39:   const bizType = getBizType(bizno);\r\n40:   const isCorpEntity = ['영리법인본점', '영리법인지점', '비영리법인'].includes(bizType) || company.includes('(주)') || company.includes('주식회사') || company.includes('㈜');\r\n41:   \r\n42:   return {\r\n43:     no: idx + 1,\r\n44:     company,\r\n45:     bizno,\r\n46:     corpNo,\r\n47:     bizType,\r\n48:     isCorpEntity,\r\n49:     hasCorpNo: !!corpNo,\r\n50:     validCheckDigit: isValidCorpNo(corpNo)\r\n51:   };\r\n52: });\r\n53: \r\n54: console.log('=== 74개 기업 법인번호 전수 분석 ===');\r\n55: const withCorpNo = audit.filter(a => a.hasCorpNo);\r\n56: const missingCorpNo = audit.filter(a => a.isCorpEntity && !a.hasCorpNo);\r\n57: const individualWithCorpNo = audit.filter(a => !a.isCorpEntity && a.hasCorpNo);\r\n58: const checkDigitFailed = audit.filter(a => a.hasCorpNo && !a.validCheckDigit);\r\n59: const valid = audit.filter(a => a.hasCorpNo && a.validCheckDigit);\r\n60: \r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
