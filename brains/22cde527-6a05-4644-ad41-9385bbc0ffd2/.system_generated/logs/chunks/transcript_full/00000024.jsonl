(val).trim() !== '') {\n96:           const cell = row.getCell(colIdx);\n97:           cell.value = String(val).trim();\n98:           cell.font = {\n99:             name: '맑은 고딕',\n100:             size: 10,\n101:             color: { argb: 'FFFF0000' },\n102:             bold: true\n103:           };\n104:           filledRedCells++;\n105:         }\n106:       }\n107: \n108:       // Col 4: 사업자번호 (Originally missing in all 421 rows -> always RED BOLD)\n109:       fillNewRed(4, verified.bizno);\n110: \n111:       // Col 5: 설립연도(연도)\n112:       // If origMissing had no year, but verified has year -> RED BOLD\n113:       if (verified.year) {\n114:         if (!origMissing || !origMissing.year || String(origMissing.year).trim() === '') {\n115:           fillNewRed(5, verified.year);\n116:         } else {\n117:           row.getCell(5).value = String(verified.year).trim();\n118:         }\n119:       }\n120: \n121:       // Col 6: 설립연도(월)\n122:       if (verified.month) {\n123:         if (!origMissing || !origMissing.month || String(origMissing.month).trim() === '') {\n124:           fillNewRed(6, verified.month);\n125:         } else {\n126:           row.getCell(6).value = String(verified.month).trim();\n127:         }\n128:       }\n129: \n130:       // Col 7: 대표자 성함\n131:       if (verified.ceo) {\n132:         if (!origMissing || !origMissing.ceo || String(origMissing.ceo).trim() === '') {\n133:           fillNewRed(7, verified.ceo);\n134:         } else {\n135:           row.getCell(7).value = String(verified.ceo).trim();\n136:         }\n137:       }\n138: \n139:       // Col 8: 연락처\n140:       if (verified.tel) {\n141:         if (!origMissing || !origMissing.phone || String(origMissing.phone).trim() === '') {\n142:           fillNewRed(8, verified.tel);\n143:         } else {\n144:           row.getCell(8).value = String(verified.tel).trim();\n145:         }\n146:       }\n147: \n148:       // Col 9: 팩스번호\n149:       if (verified.fax) {\n150:         if (!origMissing || !origMissing.fax || String(origMissing.fax).trim() === '') {\n151:           fillNewRed(9, verified.fax);\n152:         } else {\n153:           row.getCell(9).value = String(verified.fax).trim();\n154:         }\n155:       }\n156: \n157:       // Col 14: 폐업 날짜\n158:       if (verified.closeDate) {\n159:         fillNewRed(14, verified.closeDate);\n160:       }\n161: \n162:       // Col 15: 비고 ('폐업')\n163:       if (verified.status === '폐업자') {\n164:         fillNewRed(15, '폐업');\n165:       }\n166: \n167:       // Col 16: 종사자수(명) 25년 기준 (Originally missing in all 421 rows -> always RED BOLD)\n168:       if (verified.emp) {\n169:         fillNewRed(16, verified.emp);\n170:       }\n171: \n172:       // Col 17: 24년 매출액(원) - Row 2307 피커스튜디오\n173:       if (r === 2307) {\n174:         fillNewRed(17, '1,920,000');\n175:       }\n176: \n177:       // Col 19: 데이터 출처 (New column -> always RED BOLD)\n178:       if (verified.source) {\n179:         fillNewRed(19, verified.source);\n180:       }\n181:     }\n182:   }\n183: \n184:   // Remove any ghost rows after 2314\n185:   if (ws.rowCount > 2314) {\n186:     ws.spliceRows(2315, ws.rowCount - 2314);\n187:   }\n188: \n189:   // Set freeze pane on row 1\n190:   ws.views = [{ state: 'frozen', xSplit: 0, ySplit: 1, activeCell: 'A2' }];\n191: \n192:   // Auto filter\n193:   ws.autoFilter = {\n194:     from: { row: 1, column: 1 },\n195:     to: { row: 1, column: 19 }\n196:   };\n197: \n198:   console.log(`\\n=== EXECUTION SUMMARY ===`);\n199:   console.log(`Total verified rows updated: ${filledRowsCount}`);\n200:   console.log(`Total newly filled blank cells set to RED BOLD: ${filledRedCells}`);\n201:   console.log(`Total rows: ${ws.rowCount}`);\n202: \n203:   // Write directly to target original Excel\n204:   console.log(`\\nWriting directly to: ${targetXlsxPath}...`);\n205:   await wb.xlsx.writeFile(targetXlsxPath);\n206:   console.log('SUCCESS: Written directly to target Excel!');\n207: \n208:   // Export CSV (UT