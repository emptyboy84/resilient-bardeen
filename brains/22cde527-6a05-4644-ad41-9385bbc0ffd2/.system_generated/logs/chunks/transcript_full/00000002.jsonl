{"step_index":184,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-14T00:20:14Z","thinking":"Planning to create a script to perform a deep search based on business numbers from the verified results. The script's core logic will iterate through the data. It will perform a deep Google-based search for any business number found, aiming to determine its validity.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Pass 2 Deep Search and homepage footer grounding engine","UserFacing":false},"CodeContent":"const fs = require('fs');\nconst path = require('path');\n\nconst SCRATCH_DIR = 'C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch';\nconst missingFile = path.join(SCRATCH_DIR, 'missing_421.json');\nconst resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\n\nconst missing = JSON.parse(fs.readFileSync(missingFile, 'utf8'));\n\n// Checksum\nfunction isValidBizNo(b) {\n    if (!b) return false;\n    const clean = b.replace(/[^0-9]/g, '');\n    if (clean.length !== 10) return false;\n    const weights = [1, 3, 7, 1, 3, 7, 1, 3, 5];\n    let sum = 0;\n    for (let i = 0; i < 8; i++) {\n        sum += Number(clean[i]) * weights[i];\n    }\n    const d9 = Number(clean[8]) * 5;\n    sum += Math.floor(d9 / 10) + (d9 % 10);\n    const check = (10 - (sum % 10)) % 10;\n    return check === Number(clean[9]);\n}\n\nfunction formatBizNo(b) {\n    const clean = b.replace(/[^0-9]/g, '');\n    return `${clean.slice(0, 3)}-${clean.slice(3, 5)}-${clean.slice(5)}`;\n}\n\nfunction cleanCompanyName(name) {\n    if (!name) return '';\n    return name.replace(/\\(주\\)|주식회사|㈜|\\(유\\)|유한회사|\\(재\\)|재단법인|\\(사\\)|사단법인/g, '')\n               .replace(/[\\s\\-_.,\\(\\)\\[\\]]/g, '')\n               .toLowerCase();\n}\n\nfunction extractBusanDistrict(address) {\n    if (!address) return '';\n    const m = address.match(/(해운대구|부산진구|동래구|남구|북구|사상구|사하구|금정구|연제구|수영구|중구|동구|서구|영도구|강서구|기장군)/);\n    return m ? m[1] : '';\n}\n\nfunction isBusanAddress(addr) {\n    if (!addr) return false;\n    const nonBusan = /전남|광주|대구|인천|대전|울산|경기|강원|충북|충남|전북|경북|경남|제주|서울/;\n    if (addr.includes('부산')) return true;\n    if (extractBusanDistrict(addr) && !nonBusan.test(addr)) return true;\n    return false;\n}\n\nfunction ceoMatches(targetCeo, candidateCeo) {\n    if (!targetCeo || targetCeo.trim().length === 0) return true;\n    if (!candidateCeo || candidateCeo.trim().length === 0) return false;\n\n    const tList = targetCeo.split(/[,/]/).map(s => s.trim().replace(/\\s/g, '')).filter(s => s.length > 0);\n    const c = candidateCeo.replace(/[\\s]/g, '');\n\n    for (const t of tList) {\n        if (c === t) return true;\n        if (c.endsWith('*') && c.length > 1) {\n            const prefix = c.replace(/\\*/g, '');\n            if (prefix.length >= 2 && t.startsWith(prefix)) return true;\n        }\n        if (c.length === 3 && c[1] === '*' && t.length === 3 && c[0] === t[0] && c[2] === t[2]) return true;\n    }\n    return false;\n}\n\nasync function fetchBiznoDetail(biznoDigits) {\n    try {\n        const url = `https://bizno.net/article/${biznoDigits}`;\n        const res = await fetch(url, {\n            headers: {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n            }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n        const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n\n        const titleMatch = html.match(/<title>([^<]+)<\\/title>/i);\n        let title = titleMatch ? titleMatch[1].trim() : '';\n        if (title.includes('|')) title = title.split('|')[0].trim();\n        if (title.includes('-')) title = title.split('-')[0].trim();\n        if (!title || title.length < 2) return null;\n\n        let ceo = '';\n        const ceoM = text.match(/대표자명\\s*:\\s*([^\\s]+)/);\n        if (ceoM) ceo = ceoM[1].trim();\n\n        let addr = '';\n        const addrM = text.match(/주소\\s*:\\s*([^\"]+?)(?=\\s*\\(우|\\s*대표자|\\s*사업자등록번호|\\s*종업원수|\\s*설립일|\\s*$)/);\n        if (addrM) addr = addrM[1].trim();\n\n        let status = '';\n        const statM = text.match(/사업자\\s*현재\\s*상태[^\\:]*:\\s*([^\\s]+)/);\n        if (statM) status = statM[1].trim();\n\n        return {\n            bizno: formatBizNo(biznoDigits),\n            title,\n            ceo,\n            address: addr,\n            status,\n            sourceUrl: url\n        };\n    } catch (e) {\n        return null;\n    }\n}\n\n// Deep query engines\nasync function deepSearch(item) {\n    const cleanTarget = cleanCompanyName(item.name);\n    const district = extractBusanDistrict(item.address);\n    const addressWords = (item.address || '').split(' ').filter(w => w.length > 1);\n    const specificLoc = addressWords.slice(1, 3).join(' '); // e.g. \"센텀스카이비즈\" or \"모라동\"\n\n    // Set of candidate numbers found\n    const candidates = new Set();\n\n    // Query 1: Name + specific location\n    const queries = [\n        `\"${item.name}\" 부산`,\n        `\"${item.name}\" ${item.ceo ? '\"' + item.ceo + '\"' : ''}`,\n        `\"${item.name}\" \"${specificLoc}\"`\n    ].filter(q => q.trim().length > 3);\n\n    for (const q of queries) {\n        try {\n            // Naver\n            const nUrl = 'https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=' + encodeURIComponent(q + ' 사업자등록번호');\n            const nRes = await fetch(nUrl, {\n                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' }\n            });\n            if (nRes.ok) {\n                const nHtml = await nRes.text();\n                const bMatches = nHtml.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n                if (bMatches) bMatches.forEach(b => candidates.add(b));\n            }\n        } catch (e) {}\n\n        try {\n            // DDG\n            const dUrl = 'https://html.duckduckgo.com/html/?q=' + encodeURIComponent(q + ' 사업자등록번호');\n            const dRes = await fetch(dUrl, {\n                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' }\n            });\n            if (dRes.ok) {\n                const dHtml = await dRes.text();\n                const bMatches = dHtml.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n                if (bMatches) bMatches.forEach(b => candidates.add(b));\n            }\n        } catch (e) {}\n\n        await new Promise(r => setTimeout(r, 100));\n    }\n\n    // Verify candidates\n    for (const b of candidates) {\n        if (!isValidBizNo(b)) continue;\n        const digits = b.replace(/[^0-9]/g, '');\n        const full = await fetchBiznoDetail(digits);\n        if (!full || !full.title || full.title.length < 2) continue;\n        if (!isBusanAddress(full.address)) continue;\n\n        const cName = cleanCompanyName(full.title);\n        const isNameEqual = (cName === cleanTarget);\n        const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n        if (!isNameEqual && !isSub) continue;\n        if (!isNameEqual) {\n            const minLen = Math.min(cName.length, cleanTarget.length);\n            const maxLen = Math.max(cName.length, cleanTarget.length);\n            if (minLen / maxLen < 0.6) continue;\n        }\n\n        if (district && !full.address.includes(district)) {\n            if (!item.ceo || !ceoMatches(item.ceo, full.ceo)) continue;\n        }\n        if (item.ceo && !ceoMatches(item.ceo, full.ceo)) continue;\n\n        full.matchedVia = 'Pass2_DeepGrounding';\n        return full;\n    }\n\n    return null;\n}\n\nasync function runPass2() {\n    console.log('=== Starting PASS 2 Deep Grounding & Reasoning ===');\n    let results = {};\n    if (fs.existsSync(resultsFile)) {\n        results = JSON.parse(fs.readFileSync(resultsFile, 'utf8'));\n    }\n\n    const unverifiedKeys = Object.keys(results).filter(k => results[k].bizno === null);\n    console.log(`Found ${unverifiedKeys.length} unverified records to deep-search.`);\n\n    let newlyMatched = 0;\n    for (let i = 0; i < unverifiedKeys.length; i++) {\n        const key = unverifiedKeys[i];\n        const rowNum = Number(key);\n        const item = missing.find(m => m.rowNumber === rowNum);\n        if (!item) continue;\n\n        console.log(`[Pass 2: ${i + 1}/${unverifiedKeys.length}] Row ${item.rowNumber} | \"${item.name}\" | \"${item.ceo}\" | \"${item.address}\"`);\n\n        const match = await deepSearch(item);\n        if (match) {\n            console.log(`  🎉 PASS 2 RECOVERY: ${match.bizno} (${match.title}) | 주소: \"${match.address}\" | 대표: \"${match.ceo}\"`);\n            results[key] = {\n                rowNumber: item.rowNumber,\n                name: item.name,\n                bizno: match.bizno,\n                matchedTitle: match.title,\n                matchedCeo: match.ceo,\n                matchedAddress: match.address,\n                status: match.status,\n                sourceUrl: match.sourceUrl,\n                matchedVia: match.matchedVia\n            };\n            newlyMatched++;\n            fs.writeFileSync(resultsFile, JSON.stringify(results, null, 2), 'utf8');\n        } else {\n            console.log(`  -> Still unverified.`);\n        }\n        await new Promise(r => setTimeout(r, 150));\n    }\n\n    console.log(`\\n=== PASS 2 FINISHED ===`);\n    console.log(`Newly recovered via deep search: ${newlyMatched}`);\n    const totalMatched = Object.values(results).filter(r => r.bizno !== null).length;\n    console.log(`Total verified business numbers: ${totalMatched} / ${missing.length}`);\n}\n\nmodule.exports = { runPass2 };\nif (require.main === module) {\n    runPass2();\n}\n","Description":"Pass 2 Deep Search script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\scratch\\run_pass2_deep_search.js","toolAction":"Create Pass 2 deep search script","toolSummary":"Create Pass 2 deep search script"}}]}
