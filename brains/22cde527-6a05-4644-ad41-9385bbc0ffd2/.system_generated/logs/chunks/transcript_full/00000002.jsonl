LowerCase();\n}\n\nfunction extractDistrict(address) {\n    if (!address) return '';\n    const m = address.match(/([가-힣]+(?:구|군))/);\n    return m ? m[1] : '';\n}\n\n// 2. Fetch Bizno article details to verify\nasync function verifyBiznoArticle(biznoDigits) {\n    try {\n        const url = `https://bizno.net/article/${biznoDigits}`;\n        const res = await fetch(url, {\n            headers: {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n            }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n        const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n\n        // Extract company name, CEO, address, status\n        const titleMatch = html.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i) || html.match(/<title>([^<]+)<\\/title>/i);\n        const title = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : '';\n        \n        let ceo = '';\n        const ceoM = text.match(/대표자명\\s*:\\s*([^\\s]+)/);\n        if (ceoM) ceo = ceoM[1];\n\n        let addr = '';\n        const addrM = text.match(/주소\\s*:\\s*([^\"]+?)(?=\\s*\\(우|\\s*대표자|\\s*사업자등록번호|\\s*$)/);\n        if (addrM) addr = addrM[1].trim();\n\n        let status = '';\n        const statM = text.match(/사업자\\s*현재\\s*상태[^\\:]*:\\s*([^\\s]+)/);\n        if (statM) status = statM[1];\n\n        return {\n            bizno: formatBizNo(biznoDigits),\n            title,\n            ceo,\n            address: addr,\n            status,\n            sourceUrl: url\n        };\n    } catch (e) {\n        return null;\n    }\n}\n\n// 3. Bizno Search\nasync function searchBizno(name, targetDistrict, targetCeo) {\n    try {\n        const q = cleanName(name);\n        if (!q || q.length < 2) return null;\n        const url = 'https://bizno.net/?query=' + encodeURIComponent(q);\n        const res = await fetch(url, {\n            headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n\n        const candidates = [];\n        const linkRegex = /<a\\s+href=\"\\/article\\/(\\d{10})\"[^>]*>([\\s\\S]*?)<\\/a>([\\s\\S]*?)(?=<a\\s+href=\"\\/article|\\n\\s*<div class=\"footer|\\$)/gi;\n        let lm;\n        while ((lm = linkRegex.exec(html)) !== null) {\n            const rawBiz = lm[1];\n            const itemTitle = lm[2].replace(/<[^>]+>/g, '').trim();\n            const snippet = lm[3].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n            if (snippet.includes('adsbygoogle') || snippet.includes('실시간 조회기업')) {\n                const cutIdx = snippet.search(/adsbygoogle|실시간 조회기업/);\n                candidates.push({ bizno: rawBiz, title: itemTitle, snippet: snippet.slice(0, cutIdx) });\n                break;\n            }\n            candidates.push({ bizno: rawBiz, title: itemTitle, snippet });\n        }\n\n        const cleanTarget = cleanName(name);\n        for (const c of candidates) {\n            if (!isValidBizNo(c.bizno)) continue;\n            const cName = cleanName(c.title);\n            // Must have high name similarity\n            const nameMatch = cName === cleanTarget || cName.includes(cleanTarget) || cleanTarget.includes(cName);\n            if (!nameMatch) continue;\n\n            const isBusan = c.snippet.includes('부산') || (targetDistrict && c.snippet.includes(targetDistrict));\n            const ceoMatch = targetCeo && targetCeo.trim().length > 0 && c.snippet.includes(targetCeo.trim()[0]);\n\n            if (isBusan || (ceoMatch && cName === cleanTarget)) {\n                // Verify by fetching full article\n                const full = await verifyBiznoArticle(c.bizno);\n                if (full) {\n                    const fullAddrIsBusan = full.address.includes('부산') || (targetDistrict && full.address.includes(targetDistrict));\n                    if (fullAddrIsBusan || (targetCeo && full.ceo.includes(targetCeo[0]))) {\n                        return full;\n                    }\n                }\n            }\n        }\n    } catch (e) {}\n    return null;\n}\n\n// 4. Naver Search\nasync function searchNaver(name, targetDistrict, targetCeo, targetAddr) {\n    try {\n        let queryParts = [name];\n        if (targetCeo && targetCeo.trim().length > 0) queryParts.push(targetCeo.trim());\n        if (targetDistrict) queryParts.push(targetDistrict);\n        else queryParts.push('부산');\n        queryParts.push('사업자등록번호');\n\n        const query = queryParts.join(' ');\n        const url = 'https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=' + encodeURIComponent(query);\n        const res = await fetch(url, {\n            headers: {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n            }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n\n        const bizMatches = html.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n        if (!bizMatches) return null;\n\n        const uniqueBiz = [...new Set(bizMatches)];\n        const cleanTarget = cleanName(name);\n\n        for (const b of uniqueBiz) {\n            if (!isValidBizNo(b)) continue;\n            const digits = b.replace(/[^0-9]/g, '');\n\n            // Cross check with Bizno article\n            const full = await verifyBiznoArticle(digits);\n            if (full) {\n                const cName = cleanName(full.title);\n                const nameMatch = cName === cleanTarget || cName.includes(cleanTarget) || cleanTarget.includes(cName);\n                const isBusan = full.address.includes('부산') || (targetDistrict && full.address.includes(targetDistrict));\n                const ceoMatch = targetCeo && targetCeo.trim().length > 0 && full.ceo.includes(targetCeo.trim()[0]);\n\n                if (nameMatch && (isBusan || (ceoMatch && cName === cleanTarget))) {\n                    full.matchedVia = 'NaverSearch+BiznoVerify';\n                    return full;\n                }\n            }\n        }\n    } catch (e) {}\n    return null;\n}\n\nasync function run() {\n    console.log(`Starting verification for ${missing.length} records...`);\n    let matchedCount = 0;\n    let unverifiableCount = 0;\n\n    for (let i = 0; i < missing.length; i++) {\n        const item = missing[i];\n        const key = String(item.rowNumber);\n\n        // If already processed and matched, skip\n        if (progress[key] && progress[key].bizno) {\n            matchedCount++;\n            continue;\n        }\n\n        const district = extractDistrict(item.address);\n        console.log(`[${i + 1}/${missing.length}] Row ${item.rowNumber} | \"${item.name}\" | 대표: \"${item.ceo}\" | 구: \"${district}\"`);\n\n        let match = null;\n\n        // Try Bizno first\n        match = await searchBizno(item.name, district, item.ceo);\n        if (match) {\n            match.matchedVia = 'Bizno';\n        }\n\n        // If not found, try Naver search\n        if (!match) {\n            match = await searchNaver(item.name, district, item.ceo, item.address);\n        }\n\n        if (match) {\n            console.log(`  => SUCCESS: ${match.bizno} (${match.title}) [${match.address || '주소확인'}] [상태: ${match.status || '계속'}]`);\n            progress[key] = {\n                rowNumber: item.rowNumber,\n                name: item.name,\n                bizno: match.bizno,\n                matchedTitle: match.title,\n                matchedCeo: match.ceo,\n                matchedAddress: match.address,\n                status: match.status,\n                sourceUrl: match.sourceUrl,\n                matchedVia: match.matchedVia\n            };\n            matchedCount++;\n        } else {\n            console.log(`  => UNVERIFIED / NOT FOUND`);\n            progress[key] = {\n                rowNumber: item.rowNumber,\n                name: item.name,\n                bizno: null,\n                reason: '미등록 또는 식별 불명'\n            };\n            unverifiableCount++;\n        }\n\n        // Save progress every 10 items\n        if ((i + 1) % 10 === 0 || i === missing.length - 1) {\n            fs.writeFileSync(resultsFile, JSON.stringify(progress, null, 2), 'utf8');\n            console.log(`  [Progress Saved: ${Object.keys(progress).length}/${missing.length} processed | Matched: ${matchedCount}]`);\n        }\n\n        // Delay between requests\n        await new Promise(r => setTimeout(r, 200));\n    }\n\n    console.log('\\n================ VERIFICATION FINISHED ================');\n    console.log(`Total: ${missing.length}, Matched: ${matchedCount}, Unverifiable: ${unverifiableCount}`);\n}\n\nrun();\n","Description":"Create run_full_verification.js for full batch processing of 421 missing rows","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\scratch\\run_full_verification.js","toolAction":"Create full verification engine","toolSummary":"Create full verification engine"}}]}
