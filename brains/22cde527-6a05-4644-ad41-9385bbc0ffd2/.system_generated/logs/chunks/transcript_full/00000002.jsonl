{"step_index":153,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-14T00:16:24Z","thinking":"Initial match of \"LINC\" to `743-04-00686` requires verification, specifically checking Row 3 in the data. Row 508, also named \"LINC,\" has empty address data. The previous match's justification stems from a \"LINC\" search on another source, which identified a Busan-based company with \"LINC\" in its English name, suggesting a potential linkage.\n\n\nRevised the matching criteria to be more rigorous. Company title matching now demands an exact base name match after removing common prefixes/suffixes, or that the target name is the exact base name. Strict location matching is now enforced, requiring all companies to be in Busan, and addresses must match the provided Busan district if one exists in the data.\n\n\nRefining the matching algorithm, the CEO and address data will now be critical for verification. Naver Search will be the primary data source, followed by `Bizno.net` for detailed validation of business numbers. A business number checksum validation, exact name match, and Busan location check will be required prior to acceptance.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Strict verification engine with 100% Busan location check and CEO validation","UserFacing":false},"CodeContent":"const fs = require('fs');\nconst path = require('path');\n\nconst SCRATCH_DIR = 'C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch';\nconst missingFile = path.join(SCRATCH_DIR, 'missing_421.json');\nconst resultsFile = path.join(SCRATCH_DIR, 'verified_results.json');\n\nconst missing = JSON.parse(fs.readFileSync(missingFile, 'utf8'));\n\n// 국세청 사업자등록번호 10자리 가중치 체크섬 공식\nfunction isValidBizNo(b) {\n    if (!b) return false;\n    const clean = b.replace(/[^0-9]/g, '');\n    if (clean.length !== 10) return false;\n    const weights = [1, 3, 7, 1, 3, 7, 1, 3, 5];\n    let sum = 0;\n    for (let i = 0; i < 8; i++) {\n        sum += Number(clean[i]) * weights[i];\n    }\n    const d9 = Number(clean[8]) * 5;\n    sum += Math.floor(d9 / 10) + (d9 % 10);\n    const check = (10 - (sum % 10)) % 10;\n    return check === Number(clean[9]);\n}\n\nfunction formatBizNo(b) {\n    const clean = b.replace(/[^0-9]/g, '');\n    return `${clean.slice(0, 3)}-${clean.slice(3, 5)}-${clean.slice(5)}`;\n}\n\nfunction cleanCompanyName(name) {\n    if (!name) return '';\n    return name.replace(/\\(주\\)|주식회사|㈜|\\(유\\)|유한회사|\\(재\\)|재단법인|\\(사\\)|사단법인/g, '')\n               .replace(/[\\s\\-_.,\\(\\)\\[\\]]/g, '')\n               .toLowerCase();\n}\n\nfunction extractBusanDistrict(address) {\n    if (!address) return '';\n    const m = address.match(/(해운대구|부산진구|동래구|남구|북구|사상구|사하구|금정구|연제구|수영구|중구|동구|서구|영도구|강서구|기장군)/);\n    return m ? m[1] : '';\n}\n\nfunction extractDongOrRoad(address) {\n    if (!address) return '';\n    const m = address.match(/([가-힣0-9]+(?:동|로|길))/);\n    return m ? m[1] : '';\n}\n\nfunction isBusanAddress(addr) {\n    if (!addr) return false;\n    // Must contain 부산 or a Busan district AND not contain other regions\n    const nonBusan = /전남|광주|대구|인천|대전|울산|경기|강원|충북|충남|전북|경북|경남|제주|서울/;\n    // If it mentions 광주 남구 or 대구 남구, reject\n    if (addr.includes('부산')) return true;\n    if (extractBusanDistrict(addr) && !nonBusan.test(addr)) return true;\n    return false;\n}\n\nfunction ceoMatches(targetCeo, candidateCeo) {\n    if (!targetCeo || targetCeo.trim().length === 0) return true; // No target CEO to conflict\n    if (!candidateCeo || candidateCeo.trim().length === 0) return false; // Target has CEO, but candidate has none\n    const t = targetCeo.replace(/[\\s,]/g, '');\n    const c = candidateCeo.replace(/[\\s*]/g, '');\n    // If target has multiple CEOs (e.g. 한석정, 정갑두)\n    const tList = targetCeo.split(/[,/]/).map(s => s.trim().replace(/\\s/g, ''));\n    for (const tName of tList) {\n        if (c.startsWith(tName.slice(0, 1)) && (c.length <= 1 || tName.includes(c))) return true;\n        if (tName === c) return true;\n    }\n    return false;\n}\n\n// Fetch Bizno article details\nasync function fetchBiznoDetail(biznoDigits) {\n    try {\n        const url = `https://bizno.net/article/${biznoDigits}`;\n        const res = await fetch(url, {\n            headers: {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n            }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n        const text = html.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ');\n\n        const titleMatch = html.match(/<h1[^>]*>([\\s\\S]*?)<\\/h1>/i) || html.match(/<title>([^<]+)<\\/title>/i);\n        let title = titleMatch ? titleMatch[1].replace(/<[^>]+>/g, '').trim() : '';\n        // Clean title\n        if (title.includes('|')) title = title.split('|')[0].trim();\n\n        let ceo = '';\n        const ceoM = text.match(/대표자명\\s*:\\s*([^\\s]+)/);\n        if (ceoM) ceo = ceoM[1].trim();\n\n        let addr = '';\n        const addrM = text.match(/주소\\s*:\\s*([^\"]+?)(?=\\s*\\(우|\\s*대표자|\\s*사업자등록번호|\\s*종업원수|\\s*설립일|\\s*$)/);\n        if (addrM) addr = addrM[1].trim();\n\n        let status = '';\n        const statM = text.match(/사업자\\s*현재\\s*상태[^\\:]*:\\s*([^\\s]+)/);\n        if (statM) status = statM[1].trim();\n\n        return {\n            bizno: formatBizNo(biznoDigits),\n            title,\n            ceo,\n            address: addr,\n            status,\n            sourceUrl: url\n        };\n    } catch (e) {\n        return null;\n    }\n}\n\n// Search Bizno\nasync function searchBizno(name, targetDistrict, targetCeo, targetAddr) {\n    const q = cleanCompanyName(name);\n    if (!q || q.length < 2) return null;\n\n    try {\n        const url = 'https://bizno.net/?query=' + encodeURIComponent(q);\n        const res = await fetch(url, {\n            headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n\n        const candidates = [];\n        const linkRegex = /<a\\s+href=\"\\/article\\/(\\d{10})\"[^>]*>([\\s\\S]*?)<\\/a>([\\s\\S]*?)(?=<a\\s+href=\"\\/article|\\n\\s*<div class=\"footer|\\$)/gi;\n        let lm;\n        while ((lm = linkRegex.exec(html)) !== null) {\n            const rawBiz = lm[1];\n            const itemTitle = lm[2].replace(/<[^>]+>/g, '').trim();\n            const snippet = lm[3].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n            if (snippet.includes('adsbygoogle') || snippet.includes('실시간 조회기업')) {\n                const cutIdx = snippet.search(/adsbygoogle|실시간 조회기업/);\n                candidates.push({ bizno: rawBiz, title: itemTitle, snippet: snippet.slice(0, cutIdx) });\n                break;\n            }\n            candidates.push({ bizno: rawBiz, title: itemTitle, snippet });\n        }\n\n        const cleanTarget = cleanCompanyName(name);\n        for (const c of candidates) {\n            if (!isValidBizNo(c.bizno)) continue;\n            const cName = cleanCompanyName(c.title);\n\n            // Name must match closely\n            const isNameEqual = (cName === cleanTarget);\n            const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n            if (!isNameEqual && !isSub) continue;\n            // If sub, require at least 70% length overlap so short tokens don't falsely match\n            if (!isNameEqual) {\n                const minLen = Math.min(cName.length, cleanTarget.length);\n                const maxLen = Math.max(cName.length, cleanTarget.length);\n                if (minLen / maxLen < 0.6) continue;\n            }\n\n            // Must be in Busan!\n            const snippetHasBusan = isBusanAddress(c.snippet);\n            const snippetHasDistrict = targetDistrict && c.snippet.includes(targetDistrict);\n            \n            if (snippetHasBusan || snippetHasDistrict) {\n                // Fetch full detail to confirm 100%\n                const full = await fetchBiznoDetail(c.bizno);\n                if (full && isBusanAddress(full.address)) {\n                    // Check district\n                    if (targetDistrict && !full.address.includes(targetDistrict)) {\n                        // District doesn't match; only allow if CEO matches exactly\n                        if (!targetCeo || !ceoMatches(targetCeo, full.ceo)) continue;\n                    }\n                    // Check CEO\n                    if (targetCeo && !ceoMatches(targetCeo, full.ceo)) continue;\n\n                    return full;\n                }\n            }\n        }\n    } catch (e) {}\n    return null;\n}\n\n// Search Naver\nasync function searchNaver(name, targetDistrict, targetCeo, targetAddr) {\n    const cleanTarget = cleanCompanyName(name);\n    if (!cleanTarget || cleanTarget.length < 2) return null;\n\n    try {\n        let q = `${name} 부산`;\n        if (targetDistrict) q += ` ${targetDistrict}`;\n        if (targetCeo) q += ` ${targetCeo}`;\n        q += ' 사업자등록번호';\n\n        const url = 'https://search.naver.com/search.naver?where=nexearch&sm=top_hty&fbm=0&ie=utf8&query=' + encodeURIComponent(q);\n        const res = await fetch(url, {\n            headers: {\n                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n            }\n        });\n        if (!res.ok) return null;\n        const html = await res.text();\n\n        const bizMatches = html.match(/\\b\\d{3}-\\d{2}-\\d{5}\\b/g);\n        if (!bizMatches) return null;\n\n        const unique = [...new Set(bizMatches)];\n        for (const b of unique) {\n            if (!isValidBizNo(b)) continue;\n            const digits = b.replace(/[^0-9]/g, '');\n\n            const full = await fetchBiznoDetail(digits);\n            if (!full) continue;\n\n            // Must be in Busan!\n            if (!isBusanAddress(full.address)) continue;\n\n            const cName = cleanCompanyName(full.title);\n            const isNameEqual = (cName === cleanTarget);\n            const isSub = (cName.includes(cleanTarget) || cleanTarget.includes(cName));\n            if (!isNameEqual && !isSub) continue;\n            if (!isNameEqual) {\n                const minLen = Math.min(cName.length, cleanTarget.length);\n                const maxLen = Math.max(cName.length, cleanTarget.length);\n                if (minLen / maxLen < 0.6) continue;\n            }\n\n            if (targetDistrict && !full.address.includes(targetDistrict)) {\n                if (!targetCeo || !ceoMatches(targetCeo, full.ceo)) continue;\n            }\n            if (targetCeo && !ceoMatches(targetCeo, full.ceo)) continue;\n\n            full.matchedVia = 'NaverSearch+BiznoDetail';\n            return full;\n        }\n    } catch (e) {}\n    return null;\n}\n\nasync function run() {\n    console.log(`Starting STRICT verification for ${missing.length} records...`);\n    const progress = {};\n    let matchedCount = 0;\n    let unverifiableCount = 0;\n\n    for (let i = 0; i < missing.length; i++) {\n        const item = missing[i];\n        const key = String(item.rowNumber);\n        const district = extractBusanDistrict(item.address);\n\n        console.log(`[${i + 1}/${missing.length}] Row ${item.rowNumber} | \"${item.name}\" | 대표: \"${item.ceo}\" | 구: \"${district}\"`);\n\n        let match = await searchBizno(item.name, district, item.ceo, item.address);\n        if (match) {\n            match.matchedVia = 'BiznoSearch';\n        } else {\n            match = await searchNaver(item.name, district, item.ceo, item.address);\n        }\n\n        if (match) {\n            console.log(`  => MATCH CONFIRMED: ${match.bizno} (${match.title}) | 주소: \"${match.address}\" | 대표: \"${match.ceo}\" [${match.status}]`);\n            progress[key] = {\n                rowNumber: item.rowNumber,\n                name: item.name,\n                bizno: match.bizno,\n                matchedTitle: match.title,\n                matchedCeo: match.ceo,\n                matchedAddress: match.address,\n                status: match.status,\n                sourceUrl: match.sourceUrl,\n                matchedVia: match.matchedVia\n            };\n            matchedCount++;\n        } else {\n            console.log(`  => UNVERIFIABLE / EMPTY`);\n            progress[key] = {\n                rowNumber: item.rowNumber,\n                name: item.name,\n                bizno: null,\n                reason: '미등록 또는 식별 불명(공란 유지)'\n            };\n            unverifiableCount++;\n        }\n\n        // Save progress every 10 items\n        if ((i + 1) % 10 === 0 || i === missing.length - 1) {\n            fs.writeFileSync(resultsFile, JSON.stringify(progress, null, 2), 'utf8');\n            console.log(`  >>> Progress Saved: ${i + 1}/${missing.length} | Matched: ${matchedCount} | Unverifiable: ${unverifiableCount} <<<`);\n        }\n\n        // Delay\n        await new Promise(r => setTimeout(r, 150));\n    }\n\n    console.log('\\n================ VERIFICATION COMPLETED ================');\n    console.log(`Total checked: ${missing.length}`);\n    console.log(`Verified & Matched: ${matchedCount}`);\n    console.log(`Unverifiable (Kept Blank): ${unverifiableCount}`);\n}\n\nrun();\n","Description":"Update verification engine with strict Busan address and name matching","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\scratch\\run_full_verification.js","toolAction":"Update verification engine","toolSummary":"Update verification engine"}}]}
