{"step_index":1891,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-14T02:40:19Z","thinking":"Daum search proved unfruitful for revenue data, prompting a shift to Saramin due to prior verification of its direct access to revenue information. Two examples, 피커스튜디오 and 주식회사 브이드림, confirm Saramin's revenue data presence. The strategy now centers on testing other verified companies for matching pages within Saramin.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Comprehensive Saramin revenue search across all 192 verified companies","UserFacing":false},"CodeContent":"const fs = require('fs');\nconst path = require('path');\nconst https = require('https');\n\nconst SCRATCH = 'C:/Users/lg/.gemini/antigravity/brain/22cde527-6a05-4644-ad41-9385bbc0ffd2/scratch';\nconst masterFile = path.join(SCRATCH, 'master_verified_194.json');\nconst masterList = JSON.parse(fs.readFileSync(masterFile, 'utf8'));\n\nfunction fetchUrl(url) {\n  return new Promise((resolve) => {\n    const req = https.get(url, {\n      headers: {\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',\n        'Accept': 'text/html,application/xhtml+xml',\n        'Accept-Language': 'ko-KR,ko;q=0.9',\n        'Referer': 'https://www.saramin.co.kr/'\n      }\n    }, res => {\n      let d = '';\n      res.on('data', chunk => d += chunk);\n      res.on('end', () => resolve({ status: res.statusCode, data: d }));\n    });\n    req.on('error', err => resolve({ status: 500, error: err.message, data: '' }));\n    req.setTimeout(8000, () => {\n      req.destroy();\n      resolve({ status: 408, error: 'timeout', data: '' });\n    });\n  });\n}\n\nfunction parseRevenue(text) {\n  if (!text) return null;\n  text = text.trim();\n  let totalWon = 0;\n  const eokMatch = text.match(/([\\d,.]+)\\s*억/);\n  const manMatch = text.match(/([\\d,.]+)\\s*만\\s*원?/);\n  const wonMatch = text.match(/([\\d,]+)\\s*원/);\n\n  if (eokMatch) {\n    const eokVal = parseFloat(eokMatch[1].replace(/,/g, ''));\n    totalWon += eokVal * 100000000;\n  }\n  if (manMatch) {\n    const manVal = parseFloat(manMatch[1].replace(/,/g, ''));\n    totalWon += manVal * 10000;\n  }\n  if (!eokMatch && !manMatch && wonMatch) {\n    totalWon += parseInt(wonMatch[1].replace(/,/g, ''), 10);\n  }\n\n  if (totalWon > 0) {\n    return {\n      rawText: text,\n      won: totalWon,\n      formattedWon: totalWon.toLocaleString('ko-KR')\n    };\n  }\n  return { rawText: text, won: null, formattedWon: text };\n}\n\nfunction cleanCompanyName(name) {\n  return name\n    .replace(/\\([^)]*\\)/g, '')\n    .replace(/주식회사|\\(주\\)|\\(유\\)|유한회사|사단법인|합자회사|합명회사/g, '')\n    .replace(/(롯데동래점|사직동지점|수정중앙지국|센텀점|서면점|부산점)/g, '')\n    .trim();\n}\n\nasync function searchSaraminForCompany(item) {\n  const cleanName = cleanCompanyName(item.name);\n  if (!cleanName || cleanName.length < 2) return null;\n\n  const searchUrl = `https://www.saramin.co.kr/zf_user/search/company?searchword=${encodeURIComponent(cleanName)}`;\n  const searchRes = await fetchUrl(searchUrl);\n  if (searchRes.status !== 200 || !searchRes.data) return null;\n\n  const items = searchRes.data.split('class=\"item_corp\"');\n  if (items.length <= 1) return null;\n\n  // Check top candidates (up to 5)\n  for (let i = 1; i < Math.min(items.length, 6); i++) {\n    const chunk = items[i].substring(0, 2000);\n    const linkMatch = chunk.match(/href=\"([^\"]+csn=[^\"]+)\"/);\n    if (!linkMatch) continue;\n\n    let detailUrl = linkMatch[1];\n    if (!detailUrl.startsWith('http')) detailUrl = 'https://www.saramin.co.kr' + detailUrl;\n\n    const detailRes = await fetchUrl(detailUrl);\n    if (detailRes.status !== 200 || !detailRes.data) continue;\n\n    const html = detailRes.data;\n\n    // Matching criteria\n    let isMatch = false;\n    let matchReasons = [];\n\n    // 1. CEO match\n    if (item.ceo && item.ceo.length >= 2 && html.includes(item.ceo)) {\n      isMatch = true;\n      matchReasons.push(`CEO(${item.ceo})`);\n    }\n\n    // 2. Address / District match\n    if (html.includes('부산')) {\n      if (item.address) {\n        const guMatch = item.address.match(/([가-힣]+[구|군])/);\n        if (guMatch && html.includes(guMatch[1])) {\n          isMatch = true;\n          matchReasons.push(`지역(부산 ${guMatch[1]})`);\n        }\n      }\n    }\n\n    // 3. Telephone match\n    if (item.tel && item.tel.length >= 7) {\n      const cleanTel = item.tel.replace(/[^0-9]/g, '');\n      if (cleanTel.length >= 7 && html.replace(/[^0-9]/g, '').includes(cleanTel)) {\n        isMatch = true;\n        matchReasons.push(`전화(${item.tel})`);\n      }\n    }\n\n    // If no criteria matched, reject this candidate\n    if (!isMatch) continue;\n\n    // Extract revenue\n    const revRegex = /<strong class=\"company_summary_tit\">\\s*([^<]+)\\s*<\\/strong>[\\s\\S]*?<p class=\"company_summary_desc\">\\s*매출액\\s*<\\/p>/;\n    const revMatch = html.match(revRegex);\n\n    // Extract employee count\n    const empRegex = /<strong class=\"company_summary_tit\">\\s*([^<]+)\\s*<\\/strong>[\\s\\S]*?<p class=\"company_summary_desc\">\\s*사원수\\s*<\\/p>/;\n    const empMatch = html.match(empRegex);\n\n    const result = {\n      rowNumber: item.rowNumber,\n      name: item.name,\n      bizno: item.bizno,\n      ceo: item.ceo,\n      matchedName: (chunk.match(/title=\"([^\"]+)\"/) || [])[1] || cleanName,\n      matchReason: matchReasons.join(', '),\n      saraminUrl: detailUrl,\n      emp: empMatch ? empMatch[1].trim() : null\n    };\n\n    if (revMatch) {\n      const parsed = parseRevenue(revMatch[1]);\n      result.hasRevenue = true;\n      result.rawRevenue = revMatch[1].trim();\n      result.won = parsed ? parsed.won : null;\n      result.formattedWon = parsed ? parsed.formattedWon : revMatch[1].trim();\n    } else {\n      result.hasRevenue = false;\n      result.rawRevenue = null;\n      result.won = null;\n      result.formattedWon = null;\n    }\n\n    return result;\n  }\n\n  return null;\n}\n\nasync function run() {\n  console.log(`Starting revenue search for ${masterList.length} companies...`);\n  const results = [];\n  let foundRevCount = 0;\n  let matchedCount = 0;\n\n  for (let i = 0; i < masterList.length; i++) {\n    const item = masterList[i];\n    const res = await searchSaraminForCompany(item);\n    if (res) {\n      matchedCount++;\n      if (res.hasRevenue) {\n        foundRevCount++;\n        console.log(`[${i + 1}/${masterList.length}] Row ${res.rowNumber} [${res.name}]: REVENUE = ${res.rawRevenue} (${res.formattedWon}원) [${res.matchReason}]`);\n      } else {\n        // Matched on Saramin, but revenue not disclosed\n        // console.log(`[${i + 1}/${masterList.length}] Row ${res.rowNumber} [${res.name}]: Matched (${res.matchReason}), but no revenue`);\n      }\n      results.push(res);\n    }\n    // Delay to prevent rate limiting\n    await new Promise(r => setTimeout(r, 150));\n  }\n\n  console.log('\\n========================================');\n  console.log(`Finished search!`);\n  console.log(`Total companies checked: ${masterList.length}`);\n  console.log(`Matched on Saramin/NICE: ${matchedCount}`);\n  console.log(`Companies with confirmed REVENUE: ${foundRevCount}`);\n\n  const withRev = results.filter(r => r.hasRevenue);\n  fs.writeFileSync(path.join(SCRATCH, 'revenue_found_saramin.json'), JSON.stringify(withRev, null, 2), 'utf8');\n  console.log(`Saved revenue results to ${path.join(SCRATCH, 'revenue_found_saramin.json')}`);\n}\n\nrun().catch(console.error);\n","Description":"Comprehensive revenue search on Saramin across 192 companies","Overwrite":true,"TargetFile":"C:/Users/lg/.gemini/antigravity/brain/22cde527-6a05-4644-ad41-9385bbc0ffd2/scratch/search_all_saramin_rev.js","toolAction":"Creating Saramin revenue search script","toolSummary":"Create Saramin revenue script"}}]}
