${tit.trim()}`);\n        }\n      }\n    }\n  }\n\n  extractItems(html1, '브이드림');\n  extractItems(html2, '피커스튜디오');\n}\n\ntest();\n","Description":"Test exact item extraction per li block","Overwrite":true,"TargetFile":"C:/Users/lg/.gemini/antigravity/brain/22cde527-6a05-4644-ad41-9385bbc0ffd2/scratch/test_li_extract.js","toolAction":"Testing exact li extraction","toolSummary":"Test exact li extraction"}}]}
