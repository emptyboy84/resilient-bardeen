aders);\nconst bizNoIdx = headers.indexOf('사업자번호');\nconst nameIdx = headers.indexOf('사업체명');\nconst ceoIdx = headers.indexOf('대표자 성함');\nconst addrIdx = headers.indexOf('주소');\nconst seqIdx = headers.indexOf('순번');\n\nconsole.log('BizNo index:', bizNoIdx);\n\nconst missing = [];\nfor (let i = 1; i < lines.length; i++) {\n    const cols = parseCSVLine(lines[i]);\n    const bizNo = cols[bizNoIdx] ? cols[bizNoIdx].replace(/[\\\"']/g, '').trim() : '';\n    if (!bizNo || bizNo === '-' || bizNo === '') {\n        missing.push({\n            lineNum: i + 1,\n            seq: cols[seqIdx],\n            name: cols[nameIdx],\n            ceo: cols[ceoIdx],\n            addr: cols[addrIdx],\n            rawBiz: cols[bizNoIdx]\n        });\n    }\n}\n\nconsole.log('Count of missing biz numbers:', missing.length);\nconsole.log('Missing list:', JSON.stringify(missing, null, 2));\n\"","Cwd":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\fill_missing_business_numbers","IsDaemon":false,"WaitMsBeforeAsync":5000,"toolAction":"Analyze CSV file and find missing business registration numbers","toolSummary":"Find missing business numbers in CSV"}}]}
