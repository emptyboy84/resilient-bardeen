}`);\\n    }\\n  }\\n}\\n\\ntest();\\n\"","Description":"\"Investigate Moneypin endpoints\"","Overwrite":"true","TargetFile":"\"C:/Users/lg/.gemini/antigravity/brain/22cde527-6a05-4644-ad41-9385bbc0ffd2/scratch/test_moneypin.js\"","toolAction":"\"Testing Moneypin endpoints\"","toolSummary":"\"Test Moneypin endpoints\""}}]}
