 = await res.text();\\n        console.log('Google status:', res.status, 'length:', html.length);\\n        const biz = html.match(/\\\\b\\\\d{3}-\\\\d{2}-\\\\d{5}\\\\b/g);\\n        console.log('Google biz matches:', biz);\\n    } catch (e) {\\n        console.log('Google error:', e.message);\\n    }\\n}\\n\\ntestSearchEngines('토탈소프트뱅크 최장수 사업자등록번호');\\n\"","Description":"\"Test search engines\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\test_search_engines.js\"","toolAction":"\"Test search engines\"","toolSummary":"\"Test search engines\""}}]}
