(currentCell.trim());\\n        if (currentRow.some(c => c.length > 0)) rows.push(currentRow);\\n    }\\n    return rows;\\n}\\n\\nconst rows = parseCSV(text);\\nconst header = rows[0];\\n\\nconsole.log('=== Column-by-Column Format Analysis ===\\\\n');\\n\\nheader.forEach((h, colIdx) => {\\n    if (!h) return;\\n    const values = [];\\n    for (let i = 1; i < rows.length; i++) {\\n        const val = (rows[i][colIdx] || '').trim();\\n        if (val) values.push(val);\\n    }\\n\\n    // Sample distinct patterns\\n    const sampleSet = [...new Set(values)].slice(0, 15);\\n    console.log(`[Col ${colIdx}] \\\"${h}\\\": Non-empty ${values.length}/${rows.length - 1}`);\\n    c\n<truncated 1327 bytes>","Description":"\"Analyze format of each column in existing CSV\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\analyze_existing_formats.js\"","toolAction":"\"Analyze existing formats\"","toolSummary":"\"Analyze existing formats\""}}],"truncated_fields":["tool_calls"]}
