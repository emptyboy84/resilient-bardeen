'정지후' },\\n    { target: '녹생광고연합그린하우징 박명섭', q: '박명섭' },\\n    { target: '블루호텔레코딩스튜디오 김현', q: '010-3568-1004' },\\n    { target: '단디콤', q: '051-313-3449' }\\n  ];\\n\\n  for (const item of queries) {\\n    const html = await searchBizno(item.q);\\n    const res = extractBiznoResults(html);\\n    console.log(`=== [${item.target}] query: \\\"${item.q}\\\" ===`);\\n    res.slice(0, 4).forEach(r => console.log(`  Bizno: ${r.bizno} | Title: ${r.title}`));\\n  }\\n}\\n\\ntest();\\n\"","Description":"\"Test address and CEO search on Bizno\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\22cde527-6a05-4644-ad41-9385bbc0ffd2\\\\scratch\\\\test_bizno_addr_search.js\"","toolAction":"\"Creating test_bizno_addr_search.js\"","toolSummary":"\"Test address and CEO queries\""}}]}
