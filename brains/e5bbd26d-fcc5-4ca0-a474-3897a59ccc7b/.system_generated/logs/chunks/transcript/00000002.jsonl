2:     except Exception:\n33:         return []\n34: \n35: def get_detail(bno):\n36:     url = f\"https://bizno.net/article/{bno}\"\n37:     req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\n38:     try:\n39:         with urllib.request.urlopen(req, timeout=5) as resp:\n40:             html = resp.read().decode('utf-8', errors='ignore')\n41:             lines = [clean_title(l) for l in html.splitlines() if clean_title(l)]\n42:             text = \" \".join(lines)\n43:             info = {\"bno\": bno}\n44:             if \"폐업자\" in text:\n45:                 info[\"status\"] = \"폐업자\"\n46:                 m_close = re.search(r'폐업일자[:\\s]*(\\d{4}[-.]\\d{2}[-.]\\d{2})', text)\n47:                 if not m_close:\n48:                     m_close = re.search(r'(\\d{4}-\\d{2}-\\d{2})\\s*폐업', text)\n49:                 if m_close:\n50:                     info[\"close_date\"] = m_close.group(1)\n51:             elif \"계속사업자\" in text:\n52:                 info[\"status\"] = \"계속사업자\"\n53:                 \n54:             m_rep = re.search(r'대표자명?[:\\s]*([^\\s,]+)', text)\n55:             if m_rep:\n56:                 info[\"rep\"] = m_rep.group(1)\n57:             m_est = re.search(r'개업일자[:\\s]*(\\d{4}[-.]\\d{2}[-.]\\d{2})', text)\n58:             if not m_est:\n59:                 m_est = re.search(r'설립일자[:\\s]*(\\d{4}[-.]\\d{2}[-.]\\d{2})', text)\n60:             if m_est:\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
