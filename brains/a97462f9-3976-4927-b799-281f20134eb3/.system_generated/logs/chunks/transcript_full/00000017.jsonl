: \n40: function toCSVLine(fields) {\n41:   return fields.map(f => {\n42:     if (f === null || f === undefined) return '';\n43:     const str = String(f);\n44:     if (str.includes(',') || str.includes('\"') || str.includes('\\n') || str.includes('\\r')) {\n45:       return `\"${str.replace(/\"/g, '\"\"')}\"`;\n46:     }\n47:     return str;\n48:   }).join(',');\n49: }\n50: \n51: async function applyBrownFillsAndClean() {\n52:   const dir = 'C:/Users/lg/Desktop/Today';\n53:   const targetXlsx = path.join(dir, '(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_배현명_최종제출본.xlsx');\n54:   const targetCsv = path.join(dir, '(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_배현명_최종제출본.csv');\n55:   const primaryCsv = path.join(dir, '(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_배현명.csv');\n56: \n57:   console.log('Reading final master Excel...');\n58:   const wb = new xlsx.Workbook();\n59:   await wb.xlsx.readFile(targetXlsx);\n60:   const wsCorp = wb.getWorksheet('기업체 리스트');\n61: \n62:   // Brown fill definition: Theme 5 (Accent 2, Brown/Orange) tint 0.6 (Soft Warm Brown / Tan #F8CBAD)\n63:   const brownFill = {\n64:     type: 'pattern',\n65:     pattern: 'solid',\n66:     fgColor: { argb: 'FFF8CBAD' } // Soft Warm Tan / Brown\n67:   };\n68: \n69:   const brownBorder = {\n70:     top: { style: 'thin', color: { argb: 'FFED7D31' } },\n71:     bottom: { style: 'thin', color: { argb: 'FFED7D31' } },\n72:     left: { style: 'thin', color: { argb: 'FFED7D31' } },\n73:     right: { style: 'thin', color: { argb: 'FFED7D31' } }\n74:   };\n75: \n76:   let phoneBrownCount = 0;\n77:   let bizBrownCount = 0;\n78:   let ceoBrownCount = 0;\n79:   let addrBrownCount = 0;\n80:   let salesHyphenClearedCount = 0;\n81: \n82:   for (let r = 2; r <= wsCorp.rowCount; r++) {\n83:     const row = wsCorp.getRow(r);\n84: \n85:     // 1. Phone (Col 8 in Excel: 연락처)\n86:     const phoneCell = row.getCell(8);\n87:     const phoneVal = phoneCell.value ? String(phoneCell.value).trim() : '';\n88:     if (!phoneVal || phoneVal === '-' || phoneVal === '없음') {\n89:       phoneCell.value = '';\n90:       phoneCell.fill = brownFill;\n91:       phoneCell.border = brownBorder;\n92:       phoneBrownCount++;\n93:     }\n94: \n95:     // 2. Biz Number (Col 4 in Excel: 사업자번호)\n96:     const bizCell = row.getCell(4);\n97:     const bizVal = bizCell.value ? String(bizCell.value).trim() : '';\n98:     if (!bizVal || bizVal === '-' || bizVal === '없음') {\n99:       bizCell.value = '';\n100:       bizCell.fill = brownFill;\n101:       bizCell.border = brownBorder;\n102:       bizBrownCount++;\n103:     }\n104: \n105:     // 3. CEO (Col 7 in Excel: 대표자 성함)\n106:     const ceoCell = row.getCell(7);\n107:     const ceoVal = ceoCell.value ? String(ceoCell.value).trim() : '';\n108:     if (!ceoVal || ceoVal === '-' || ceoVal === '없음') {\n109:       ceoCell.value = '';\n110:       ceoCell.fill = brownFill;\n111:       ceoCell.border = brownBorder;\n112:       ceoBrownCount++;\n113:     }\n114: \n115:     // 4. Address (Col 11 in Excel: 주소)\n116:     const addrCell = row.getCell(11);\n117:     const addrVal = addrCell.value ? String(addrCell.value).trim() : '';\n118:     if (!addrVal || addrVal === '-' || addrVal === '없음') {\n119:       addrCell.value = '';\n120:       addrCell.fill = brownFill;\n121:       addrCell.border = brownBorder;\n122:       addrBrownCount++;\n123:     }\n124: \n125:     // 5. Sales 24 (Col 17) and Sales 25 (Col 18) - Clean hyphens '[-]'\n126:     [17, 18].forEach(colIdx => {\n127:       const salesCell = row.getCell(colIdx);\n128:       const sVal = salesCell.value ? String(salesCell.value).trim() : '';\n129:       if (sVal === '-' || sVal === '--') {\n130:         salesCell.value = '';\n131:         salesCell.fill = brownFill;\n132:         salesCell.border = brownBorder;\n133:         salesHyphenClearedCount++;\n134:       }\n135:     });\n136:   }\n137: \n138:   console.log('=== BROWN FILL & CLEANING APPLIED ===');\n139:   console.log(`1. 전화번호 없는 셀 갈색 채우기: ${phoneBrownCount}개`);\n140:   console.log(`2. 사업자번호 없는 셀 갈색 채우기: ${bizBrownCount}개`);\n141:   console.log(`3. 대표자명 없는 셀 갈색 채우기: ${ceoBrownCount}개`);\n142:   console.log(`4. 주소 없는 셀 갈색 채우기: ${addrBrownCount}개`);\n143:   console.log(`5. 매출액 결측치[-] 제거 및 갈색 채우기: ${salesHyphenClearedCount}개`);\n144:   const totalBrownCells = phoneBrownCount + bizBrownCount + ceoBrownCount + addrBrownCount + salesHyphenClearedCount;\n145:   console.log(`총 갈색 음영 채우기 완료 셀: ${totalBrownCells}개`);\n146: \n147:   // Save updated Excel file\n148:   await wb.xlsx.writeFile(targetXlsx);\n149:   console.log(`Saved updated Excel to: ${targetXlsx}`);\n150: \n151:   // Also update CSV to clear the '[-]' placeholders so data is 100% clean\n152:   const csvContent = fs.readFileSync(targetCsv, 'utf8');\n153:   const cleanCsvContent = csvContent.charCodeAt(0) === 0xFEFF ? csvContent.slice(1) : csvContent;\n154:   const csvRows = parseCSV(cleanCsvContent);\n155:   const updatedCsvData = csvRows.slice(1).map(r => {\n156:     // Col 16 & Col 17: if '-', set to ''\n157:     if (r[16] && r[16].trim() === '-') r[16] = '';\n158:     if (r[17] && r[17].trim() === '-') r[17] = '';\n159:     return r;\n160:   });\n161: \n162:   const finalCsvLines = [\n163:     toCSVLine(csvRows[0]),\n164:     ...updatedCsvData.map(r => toCSVLine(r))\n165:   ];\n166:   const finalCsvStr = '\\uFEFF' + finalCsvLines.join('\\r\\n') + '\\r\\n';\n167:   fs.writeFileSync(targetCsv, finalCsvStr, 'utf8');\n168:   fs.writeFileSync(primaryCsv, finalCsvStr, 'utf8');\n169:   console.log('Synchronized updated CSVs.');\n170: }\n171: \n172: applyBrownFillsAndClean().catch(console.error);\n173: \nThe above content shows the entire, complete file contents of the requested file.\n"}
