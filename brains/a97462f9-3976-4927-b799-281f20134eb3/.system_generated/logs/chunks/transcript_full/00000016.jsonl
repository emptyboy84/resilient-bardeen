;\n  }\n  return rows;\n}\n\nconst csvPath = 'C:/Users/lg/Desktop/Today/(안상숙)(STI)_(모집단현행화)_부산정보산업진흥원_2026_부산_CT산업_실태조사_260910_크레탑_배현명_최종제출본.csv';\nconst content = fs.readFileSync(csvPath, 'utf8');\nconst rows = parseCSV(content);\n\nconsole.log('=== INSPECTING PHONE VALUES ===');\nconst phones = {};\nconst weirdPhones = [];\n\nrows.slice(1).forEach((r, idx) => {\n  const rowNum = idx + 2;\n  const p = r[7] ? r[7].trim() : '';\n  if (!p) {\n    phones['(EMPTY)'] = (phones['(EMPTY)'] || 0) + 1;\n  } else {\n    // Check if normal phone format: e.g. 051-XXX-XXXX, 010-XXXX-XXXX, 070-XXXX-XXXX, 02-XXX-XXXX\n    if (!/^\\d{2,4}-\\d{3,4}-\\d{4}$/.test(p) && !/^\\d{2,4}-\\d{3,4}-\\d{4}\\s*\\/\\s*\\d{2,4}-\\d{3,4}-\\d{4}$/.test(p)) {\n      weirdPhones.push({ rowNum, name: r[2], phone: p });\n    }\n  }\n});\n\nconsole.log('Empty phones count:', phones['(EMPTY)']);\nconsole.log('Non-standard phones count:', weirdPhones.length);\nif (weirdPhones.length > 0) {\n  console.log('Weird phones:', weirdPhones);\n}\n","Description":"Inspect phone numbers for any non-standard or dummy values","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\a97462f9-3976-4927-b799-281f20134eb3\\scratch\\inspect_phone_values.js","toolAction":"Write inspect_phone_values.js","toolSummary":"Write inspect_phone_values.js"}}]}
