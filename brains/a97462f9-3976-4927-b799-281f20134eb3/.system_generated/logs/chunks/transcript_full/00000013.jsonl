3:             const rowStr = JSON.stringify(r.values);\n34:             targetNames.forEach(tn => {\n35:               if (rowStr.includes(tn)) {\n36:                 console.log(`[XLSX ${f} | ${ws.name} R${rNum}] ${rowStr.substring(0, 120)}`);\n37:               }\n38:             });\n39:           });\n40:         });\n41:       }\n42:     } catch(e) {\n43:       // ignore\n44:     }\n45:   }\n46: }\n47: \n48: searchInOldFiles().catch(console.error);\n49: \nThe above content shows the entire, complete file contents of the requested file.\n"}
