th, 'utf8');\n40: const cleanContent = content.charCodeAt(0) === 0xFEFF ? content.slice(1) : content;\n41: const rows = parseFullCSV(cleanContent);\n42: const header = rows[0];\n43: const data = rows.slice(1);\n44: \n45: console.log('=== DEEP AUDIT: Header & Columns ===');\n46: console.log('Header length:', header.length);\n47: header.forEach((h, idx) => console.log(`Col ${idx}: [${h}]`));\n48: \n49: const issues = {\n50:   columnCountMismatch: [],\n51:   nameMissing: [],\n52:   bizFormatWeird: [],\n53:   bizDuplicates: {},\n54:   estYearWeird: [],\n55:   estMonthWeird: [],\n56:   closedDateWeird: [],\n57:   salesFormatWeird: [],\n58:   empFormatWeird: [],\n59:   categoryMissing: [],\n60:   newlineInFields: [],\n61:   contactResultStats: {},\n62:   categoryStats: {}\n63: };\n64: \n65: const bizMap = {};\n66: \n67: data.forEach((r, idx) => {\n68:   const rowNum = idx + 2;\n69:   const seq = r[1];\n70:   const name = r[2] ? r[2].trim() : '';\n71:   const biz = r[3] ? r[3].trim() : '';\n72:   const estY = r[4] ? r[4].trim() : '';\n73:   const estM = r[5] ? r[5].trim() : '';\n74:   const ceo = r[6] ? r[6].trim() : '';\n75:   const phone = r[7] ? r[7].trim() : '';\n76:   const fax = r[8] ? r[8].trim() : '';\n77:   const sigungu = r[9] ? r[9].trim() : '';\n78:   const addr = r[10] ? r[10].trim() : '';\n79:   const cat = r[11] ? r[11].trim() : '';\n80:   const contact = r[12] ? r[12].trim() : '';\n81:   const closedDate = r[13] ? r[13].trim() : '';\n82:   const note = r[14] ? r[14].trim() : '';\n83:   const emp = r[15] ? r[15].trim() : '';\n84:   const s24 = r[16] ? r[16].trim() : '';\n85:   const s25 = r[17] ? r[17].trim() : '';\n86: \n87:   // 1. Column count\n88:   if (r.length !== 19) {\n89:     issues.columnCountMismatch.push({ rowNum, length: r.length });\n90:   }\n91: \n92:   // 2. Name check\n93:   if (!name) {\n94:     issues.nameMissing.push({ rowNum, seq });\n95:   }\n96: \n97:   // 3. Biz check\n98:   if (biz) {\n99:     const cleanBiz = biz.replace(/-/g, '');\n100:     if (!/^\\d{10}$/.test(cleanBiz)) {\n101:       issues.bizFormatWeird.push({ rowNum, seq, name, biz });\n102:     }\n103:     // Check duplicates\n104:     if (!bizMap[cleanBiz]) bizMap[cleanBiz] = [];\n105:     bizMap[cleanBiz].push({ rowNum, seq, name });\n106:   }\n107: \n108:   // 4. Est Year/Month\n109:   if (estY && (!/^\\d{4}$/.test(estY) || parseInt(estY) < 1900 || parseInt(estY) > 2026)) {\n110:     issues.estYearWeird.push({ rowNum, seq, name, estY });\n111:   }\n112:   if (estM && (!/^\\d{1,2}$/.test(estM) || parseInt(estM) < 1 || parseInt(estM) > 12)) {\n113:     issues.estMonthWeird.push({ rowNum, seq, name, estM });\n114:   }\n115: \n116:   // 5. Closed Date\n117:   if (closedDate) {\n118:     // Expected: YYYY-MM-DD or standard date format, or '폐업자'\n119:     if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(closedDate) && closedDate !== '폐업자' && closedDate !== '폐업') {\n120:       issues.closedDateWeird.push({ rowNum, seq, name, closedDate });\n121:     }\n122:   }\n123: \n124:   // 6. Sales format\n125:   [s24, s25].forEach((s, sIdx) => {\n126:     if (s) {\n127:       const cleanS = s.replace(/,/g, '').trim();\n128:       if (isNaN(cleanS) && s !== '-' && s !== '0') {\n129:         issues.salesFormatWeird.push({ rowNum, seq, name, col: sIdx === 0 ? 's24' : 's25', val: s });\n130:       }\n131:     }\n132:   });\n133: \n134:   // 7. Emp format\n135:   if (emp) {\n136:     const cleanEmp = emp.replace(/,/g, '').trim();\n137:     if (isNaN(cleanEmp)) {\n138:       issues.empFormatWeird.push({ rowNum, seq, name, emp });\n139:     }\n140:   }\n141: \n142:   // 8. Category\n143:   if (!cat) {\n144:     issues.categoryMissing.push({ rowNum, seq, name });\n145:   } else {\n146:     issues.categoryStats[cat] = (issues.categoryStats[cat] || 0) + 1;\n147:   }\n148: \n149:   // 9. Newline in any field\n150:   r.forEach((f, fIdx) => {\n151:     if (typeof f === 'string' && (f.includes('\\n') || f.includes('\\r'))) {\n152:       issues.newlineInFields.push({ rowNum, se