            for (const name of targetNames) {\n              if (rowStr && rowStr.includes(name)) {\n                console.log(`[XLSX ${file} | ${ws.name} R${rowNumber}] Found ${name}: ${rowStr}`);\n              }\n            }\n          });\n        });\n      } catch (e) {\n        // ignore read errors\n      }\n    }\n  }\n}\n\nsearch();\n","Description":"Search for truncated business numbers in all Today files","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\a97462f9-3976-4927-b799-281f20134eb3\\scratch\\search_truncated_biz.js","toolAction":"Write search_truncated_biz.js","toolSummary":"Write search_truncated_biz.js"}}]}
