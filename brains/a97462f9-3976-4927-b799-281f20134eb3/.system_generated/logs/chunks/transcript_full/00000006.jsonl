ows.length);\n  if (blueRows.length > 0) {\n    console.log('Sample blue rows (first 10):', blueRows.slice(0, 10));\n  }\n}\n\ncheckColors().catch(console.error);\n","Description":"Check cell colors in Excel file","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\a97462f9-3976-4927-b799-281f20134eb3\\scratch\\check_colors.js","toolAction":"Writing script to check cell colors","toolSummary":"Check cell colors in Excel"}}]}
