10]: 이메일, p[11]: 종업원수, p[12]: 업종, p[13]: 법인번호, p[14]: 결산월, p[15]: 대, p[16]: 중, p[17]: 소\\n    \\n    const biznoClean = p[3] ? p[3].replace(/[^0-9]/g, '') : '';\\n    const biznoUrl = biznoClean ? 'https://bizno.net/article/' + biznoClean : '';\\n    \\n    const newValues = {\\n      1: p[0] || '배현명',\\n      2: p[1] || null,\\n      3: p[2] || null,\\n      4: p[3] ? (biznoUrl ? { text: p[3], hyperlink: biznoUrl } : (isNaN(p[3]) ? p[3] : Number(p[3]))) : null,\\n      5: p[4] || null,\\n      6: p[5] ? (isNaN(p[5]) ? p[5] : Number(p[5])) : null,\\n      7: p[6] || null,\\n      8: p[7] || null,\\n      9: p[8] || null,\\n      10: p[9] || null,\\n      11: p[10] || null,\\n      15: p[11] ? (isNaN(p[11]) ? p[11] : Number(p[11])) : null,\\n      18: p[12] || null,\\n      25: p[13] || null,\\n      31: p[14] || null,\\n      48: p[15] || null,\\n      49: p[16] || null,\\n      50: p[17] || null\\n    };\\n    \\n    for (const [colStr, newVal] of Object.entries(newValues)) {\\n      const col = Number(colStr);\\n      const origCell = row.getCell(col);\\n      const normNew = newVal === null || newVal === undefined ? '' : String(typeof newVal === 'object' && newVal.text ? newVal.text : newVal).trim();\\n      \\n      origCell.value = newVal;\\n      \\n      if (normNew !== '') {\\n        origCell.fill = orangeFill;\\n        modifiedCellCount++;\\n      }\\n    }\\n    \\n    row.commit();\\n  }\\n  \\n  console.log('Total cells formatted & styled orange across 500 rows:', modifiedCellCount);\\n  console.log('Writing file to temp...');\\n  const tempPath = filePath + '.tmp';\\n  await workbook.xlsx.writeFile(tempPath);\\n  \\n  console.log('Overwriting target file...');\\n  if (fs.existsSync(filePath)) {\\n    fs.unlinkSync(filePath);\\n  }\\n  fs.renameSync(tempPath, filePath);\\n  \\n  console.log('Final Fact Check Excel save complete! File size:', fs.statSync(filePath).size);\\n}\\n\\nupdateFactCheckedExcelWithZip().catch(console.error);\\n\\\"\",\"Cwd\":\"c