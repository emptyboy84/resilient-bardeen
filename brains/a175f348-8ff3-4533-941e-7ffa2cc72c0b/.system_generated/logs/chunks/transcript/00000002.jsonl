ine(lines[i]);\\n  if (cols[0] === '배현명') {\\n    bhmRows.push(cols);\\n  } else {\\n    otherRows.push(cols);\\n  }\\n}\\n\\nconsole.log(`Total 배현명 rows: ${bhmRows.length}`);\\nconsole.log(`Total other authors rows: ${otherRows.length}`);\\n\\nconsole.log('\\\\n--- All 58 Columns Status Analysis ---');\\n\\nconst colStats = [];\\n\\nheader.forEach((h, idx) => {\\n  let bhmFilled = 0;\\n  let otherFilled = 0;\\n\\n  bhmRows.forEach(r => {\\n    if (r[idx] && r[idx].trim()) bhmFilled++;\\n  });\\n\\n  otherRows.forEach(r => {\\n    if (r[idx] && r[idx].trim()) otherFilled++;\\n  });\\n\\n  const bhmPct = ((bhmFilled / bhmRows.length) * 100).toFixed(1);\\n  const otherPct = otherRows.length > 0 ? ((otherFilled / otherRows.length) * 100).toFixed(1) : 0;\\n\\n  colStats.push({\\n    idx,\\n    name: h || `(빈열_${idx})`,\\n    bhmFilled,\\n    bhmPct,\\n    otherFilled,\\n    otherPct\\n  });\\n});\\n\\nconsole.log(JSON.stringify(colStats, null, 2));\\n\"","Description":"\"Inspect all 58 columns stats\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\a175f348-8ff3-4533-941e-7ffa2cc72c0b\\\\scratch\\\\all_58_cols_stats.js\"","toolAction":"\"Writing all_58_cols_stats.js\"","toolSummary":"\"Write all_58_cols_stats.js\""}}]}
