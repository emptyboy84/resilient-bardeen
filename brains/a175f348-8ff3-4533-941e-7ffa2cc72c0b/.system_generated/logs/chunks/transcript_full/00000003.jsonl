      result.push(cur);\n      cur = '';\n    } else {\n      cur += char;\n    }\n  }\n  result.push(cur);\n  return result;\n}\n\nconst filePath = 'C:\\\\Users\\\\lg\\\\Desktop\\\\오늘\\\\(데이터검증팀)실사 DB 취합_전달용_260720_배현명.csv';\nconst content = fs.readFileSync(filePath, 'utf8');\nconst lines = content.split(/\\r?\\n/);\nconst header = parseCSVLine(lines[0]);\n\n// Let's check how many 배현명 rows have 설립일자 and 형태\nlet estCount = 0;\nlet typeCount = 0;\nfor (let i = 1; i < lines.length; i++) {\n  if (!lines[i].trim()) continue;\n  const cols = parseCSVLine(lines[i]);\n  if (cols[0] === '배현명') {\n    if (cols[12] && cols[12].trim()) estCount++;\n    if (cols[11] && cols[11].trim()) typeCount++;\n  }\n}\n\nconsole.log(`Current 배현명 설립일자: ${estCount}/1000, 형태: ${typeCount}/1000`);\n","Description":"Check additional columns status","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\a175f348-8ff3-4533-941e-7ffa2cc72c0b\\scratch\\check_extra_cols.js","toolAction":"Writing check_extra_cols.js","toolSummary":"Write check_extra_cols.js"}}]}
