argetLine = i + 1;\n    currentCols = parseCSVLine(lines[i]);\n    break;\n  }\n}\n\nconsole.log(`Target in CSV: Line ${targetLine}`);\nconsole.log('Current CSV Row:', currentCols);\n\n// Fetch Bizno info\nconst url = 'https://bizno.net/article/6052724221';\nhttps.get(url, {\n  headers: {\n    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n  }\n}, (res) => {\n  let data = '';\n  res.on('data', chunk => data += chunk);\n  res.on('end', () => {\n    console.log(`\\nBizno Fetch Status: ${res.statusCode}`);\n    const descMatch = data.match(/<meta\\s+name=[\"']description[\"']\\s+content=[\"'](.*?)[\"']/i);\n    if (descMatch) {\n      console.log('Meta Description:', descMatch[1]);\n    }\n  });\n});\n","Description":"Locate and fetch info for 양석엔지니어링","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\a175f348-8ff3-4533-941e-7ffa2cc72c0b\\scratch\\check_yangseok.js","toolAction":"Writing check_yangseok.js","toolSummary":"Write check_yangseok.js"}}]}
