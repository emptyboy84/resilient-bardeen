{"step_index":422,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-21T00:15:28Z","thinking":"Planning the `master_search_pipeline.py` script, the primary search query will use the cleaned company name (`c_name`) first, without appending \"부산\" to the query on Bizno. If the target name differs from the cleaned name, try the target name directly. If a phone number is available, include `clean_tel` in the query as well.\n\nThe script's candidate selection criteria will require each candidate's title to match the target name, confirming that the title contains the clean company name or target company name.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import json\nimport urllib.request\nimport urllib.parse\nimport re\nimport time\nimport os\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport threading\n\nHEADERS = {\n    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n}\n\nprogress_lock = threading.Lock()\n\ndef clean_company_name(name):\n    if not name: return \"\"\n    clean = re.sub(r'\\(주\\)|주식회사|\\(유\\)|\\(사\\)|\\(재\\)|\\(합\\)|\\(주식회사\\)', '', name).strip()\n    return clean\n\ndef parse_search_page(query):\n    if not query or len(query.strip()) < 2:\n        return []\n    url = f\"https://bizno.net/?query={urllib.parse.quote(query.strip())}\"\n    req = urllib.request.Request(url, headers=HEADERS)\n    try:\n        with urllib.request.urlopen(req, timeout=6) as resp:\n            html = resp.read().decode('utf-8', errors='ignore')\n    except:\n        return []\n        \n    if '<div class=\"col-lg-4 sidebar\">' in html:\n        main_content = html.split('<div class=\"col-lg-4 sidebar\">')[0]\n    else:\n        main_content = html\n        \n    posts = re.findall(r'<div class=\"single-post[\\s\\S]*?(?=<div class=\"single-post|<hr>|$)', main_content)\n    results = []\n    seen = set()\n    for p in posts:\n        art_match = re.search(r'href=[\"\\']/article/(\\d{10})[\"\\']', p)\n        if not art_match: continue\n        art_id = art_match.group(1)\n        if art_id in seen: continue\n        seen.add(art_id)\n        \n        title_match = re.search(r'<h[34][^>]*>(.*?)</h[34]>', p)\n        title = re.sub(r'<[^>]+>', '', title_match.group(1)).strip() if title_match else \"\"\n        \n        p_match = re.search(r'<p>([\\s\\S]*?)</p>', p)\n        addr_snip = re.sub(r'\\s+', ' ', re.sub(r'<[^>]+>', '', p_match.group(1))).strip() if p_match else \"\"\n        \n        results.append({\n            \"biz_no_10\": art_id,\n            \"title\": title,\n            \"addr_snip\": addr_snip\n        })\n    return results\n\ndef get_bizno_detail(biz_no_10):\n    url = f\"https://bizno.net/article/{biz_no_10}\"\n    req = urllib.request.Request(url, headers=HEADERS)\n    try:\n        with urllib.request.urlopen(req, timeout=6) as resp:\n            html = resp.read().decode('utf-8', errors='ignore')\n            \n            desc_match = re.search(r'<meta\\s+name=[\"\\']description[\"\\']\\s+content=[\"\\'](.*?)[\"\\']', html)\n            desc = desc_match.group(1) if desc_match else \"\"\n            \n            title_match = re.search(r'<title>(.*?)</title>', html)\n            title = title_match.group(1).replace(\"- 비즈노\", \"\").strip() if title_match else \"\"\n            \n            ceo_match = re.search(r'대표자명\\s*:\\s*([^\\s<]+)', desc)\n            ceo = ceo_match.group(1).strip() if ceo_match else \"\"\n            \n            est_match = re.search(r'설립일[^\\:]*:\\s*(\\d{4})-(\\d{2})-(\\d{2})', desc)\n            est_year = int(est_match.group(1)) if est_match else \"\"\n            est_month = int(est_match.group(2)) if est_match else \"\"\n            \n            emp_match = re.search(r'종업원수\\s*:\\s*(\\d+)명', desc)\n            emp_cnt = int(emp_match.group(1)) if emp_match else \"\"\n            \n            biz_match = re.search(r'사업자등록번호\\s*:\\s*(\\d{3}-\\d{2}-\\d{5})', desc)\n            biz_no = biz_match.group(1) if biz_match else f\"{biz_no_10[:3]}-{biz_no_10[3:5]}-{biz_no_10[5:]}\"\n            \n            tel_match = re.search(r'전화번호\\s*:\\s*([0-9\\-]+)', desc)\n            tel = tel_match.group(1).strip() if tel_match else \"\"\n            \n            fax_match = re.search(r'팩스번호\\s*:\\s*([0-9\\-]+)', desc)\n            fax = fax_match.group(1).strip() if fax_match else \"\"\n            \n            addr_match = re.search(r'회사주소\\s*:\\s*(.*?)(?=\\s+(?:종업원수|사업자등록번호|법인등록번호|홈페이지|통신판매업번호|$))', desc)\n            if not addr_match:\n                addr_match = re.search(r'소재지\\s*</th>\\s*<td[^>]*>(.*?)</td>', html)\n            addr = addr_match.group(1).strip() if addr_match else \"\"\n            addr = re.sub(r'<[^>]+>', ' ', addr).strip()\n            \n            status_match = re.search(r'사업자 현재 상태[^\\:]*:\\s*([^\\s<]+)', desc)\n            status = status_match.group(1) if status_match else \"\"\n            \n            closed_match = re.search(r'폐업일자\\s*:\\s*(\\d{4}-\\d{2}-\\d{2})', html) or re.search(r'폐업일자\\s*:\\s*(\\d{4}-\\d{2}-\\d{2})', desc)\n            closed_date = closed_match.group(1) if closed_match else \"\"\n            \n            return {\n                \"biz_no_10\": biz_no_10,\n                \"biz_no\": biz_no,\n                \"title\": title,\n                \"ceo\": ceo,\n                \"est_year\": est_year,\n                \"est_month\": est_month,\n                \"emp_cnt\": emp_cnt,\n                \"tel\": tel,\n                \"fax\": fax,\n                \"addr\": addr,\n                \"status\": status,\n                \"closed_date\": closed_date\n            }\n    except:\n        return None\n\ndef score_detail(target, cand):\n    cand_addr = cand.get('addr', '')\n    is_busan = \"부산\" in cand_addr\n    \n    t_addr = target.get('addr', '')\n    t_sigungu = target.get('sigungu', '')\n    \n    # Must have connection to Busan\n    # If candidate address is in other province without Busan, reject\n    other_provinces = [\"서울특별시\", \"서울시\", \"경기도\", \"인천광역시\", \"대구광역시\", \"대전광역시\", \"광주광역시\", \"울산광역시\", \"세종특별자치시\", \"강원도\", \"충청북도\", \"충청남도\", \"전라북도\", \"전라남도\", \"경상북도\", \"제주\"]\n    if any(p in cand_addr for p in other_provinces) and \"부산\" not in cand_addr:\n        return -100\n        \n    score = 0\n    t_name = clean_company_name(target['name']).lower().replace(\" \", \"\")\n    c_name = clean_company_name(cand['title']).lower().replace(\" \", \"\")\n    \n    if t_name == c_name:\n        score += 50\n    elif t_name in c_name or c_name in t_name:\n        score += 30\n    else:\n        return 0\n        \n    if is_busan:\n        score += 30\n    elif not cand_addr:\n        # If address is hidden in Bizno, check other clues\n        score += 10\n        \n    if t_sigungu and t_sigungu in cand_addr:\n        score += 20\n        \n    # Check street/dong/building match\n    for part in re.findall(r'[가-힣0-9]{2,}', t_addr):\n        if part in [\"부산\", \"부산광역시\", \"센텀\", \"빌딩\", \"타워\"]:\n            continue\n        if part in cand_addr:\n            score += 20\n            break\n            \n    # Tel match\n    t_tel = re.sub(r'[^0-9]', '', target.get('tel', ''))\n    c_tel = re.sub(r'[^0-9]', '', cand.get('tel', ''))\n    if t_tel and c_tel and (t_tel == c_tel or t_tel.endswith(c_tel[-7:]) or c_tel.endswith(t_tel[-7:])):\n        score += 40\n        \n    # CEO match\n    t_ceo = target.get('ceo', '').strip()\n    c_ceo = cand.get('ceo', '').strip()\n    if t_ceo and c_ceo and (t_ceo == c_ceo or t_ceo in c_ceo or c_ceo in t_ceo):\n        score += 35\n        \n    return score\n\ndef scan_target(t):\n    c_name = clean_company_name(t['name'])\n    \n    # Try clean name first\n    queries = [c_name]\n    if t['name'] != c_name:\n        queries.append(t['name'])\n        \n    clean_tel = re.sub(r'[^0-9]', '', t.get('tel', ''))\n    if clean_tel and len(clean_tel) >= 7:\n        queries.append(clean_tel)\n        \n    candidates = []\n    seen = set()\n    for q in queries:\n        items = parse_search_page(q)\n        for it in items:\n            if it[\"biz_no_10\"] not in seen:\n                seen.add(it[\"biz_no_10\"])\n                candidates.append(it)\n        if candidates:\n            # If we found candidates matching name, don't need further queries\n            break\n            \n    # Check matching candidates\n    t_clean = c_name.lower().replace(\" \", \"\")\n    matching_cands = []\n    for c in candidates:\n        c_clean = clean_company_name(c['title']).lower().replace(\" \", \"\")\n        if t_clean in c_clean or c_clean in t_clean:\n            # check addr_snip\n            addr = c.get('addr_snip', '')\n            if not addr or \"부산\" in addr or t.get('sigungu', '') in addr:\n                matching_cands.append(c)\n            elif not any(prov in addr for prov in [\"서울\", \"경기\", \"인천\", \"대구\", \"대전\", \"광주\", \"울산\", \"세종\", \"강원\", \"충북\", \"충남\", \"전북\", \"전남\", \"경북\", \"제주\"]):\n                matching_cands.append(c)\n                \n    best_cand = None\n    best_score = 0\n    \n    for c in matching_cands[:4]:\n        detail = get_bizno_detail(c['biz_no_10'])\n        if not detail: continue\n        s = score_detail(t, detail)\n        if s > best_score:\n            best_score = s\n            best_cand = detail\n        if s >= 80:\n            break\n            \n    if best_cand and best_score >= 40:\n        return {\n            \"row\": t['row'],\n            \"name\": t['name'],\n            \"status\": \"matched\",\n            \"score\": best_score,\n            \"biz_no\": best_cand['biz_no'],\n            \"emp_cnt\": best_cand['emp_cnt'], # ONLY from Bizno!\n            \"ceo\": best_cand['ceo'] if best_cand['ceo'] else t.get('ceo', ''),\n            \"est_year\": best_cand['est_year'] if best_cand['est_year'] else t.get('est_year', ''),\n            \"est_month\": best_cand['est_month'] if best_cand['est_month'] else t.get('est_month', ''),\n            \"tel\": best_cand['tel'] if best_cand['tel'] else t.get('tel', ''),\n            \"fax\": best_cand['fax'] if best_cand['fax'] else t.get('fax', ''),\n            \"addr\": best_cand['addr'] if best_cand['addr'] else t.get('addr', ''),\n            \"cand_status\": best_cand['status'],\n            \"closed_date\": best_cand['closed_date'],\n            \"source\": \"bizno\"\n        }\n    else:\n        return {\n            \"row\": t['row'],\n            \"name\": t['name'],\n            \"status\": \"unmatched_bizno\",\n            \"score\": best_score,\n            \"candidates_found\": len(candidates)\n        }\n\ndef run_master():\n    target_file = r\"C:\\Users\\lg\\.gemini\\antigravity\\brain\\cc5f8116-f40f-4d66-a990-d85efe7bc64f\\scratch\\target_318_companies.json\"\n    with open(target_file, \"r\", encoding=\"utf-8\") as f:\n        targets = json.load(f)\n        \n    out_file = r\"C:\\Users\\lg\\.gemini\\antigravity\\brain\\cc5f8116-f40f-4d66-a990-d85efe7bc64f\\scratch\\master_matches.json\"\n    progress = {}\n    \n    print(f\"Starting master pipeline on {len(targets)} targets with 8 workers...\", flush=True)\n    matched_count = 0\n    completed = 0\n    \n    with ThreadPoolExecutor(max_workers=8) as executor:\n        futures = {executor.submit(scan_target, t): t for t in targets}\n        for fut in as_completed(futures):\n            t = futures[fut]\n            try:\n                res = fut.result()\n                with progress_lock:\n                    progress[str(res['row'])] = res\n                    completed += 1\n                    if res.get('status') == 'matched':\n                        matched_count += 1\n                        print(f\"[{completed}/{len(targets)}] MATCHED: {res['name']} -> {res['biz_no']} (Emp: {res['emp_cnt']}, CEO: {res['ceo']}, Addr: {res['addr'][:30]})\", flush=True)\n                    else:\n                        if completed % 15 == 0:\n                            print(f\"[{completed}/{len(targets)}] In progress... (Matched so far: {matched_count})\", flush=True)\n                            \n                    if completed % 20 == 0 or completed == len(targets):\n                        with open(out_file, \"w\", encoding=\"utf-8\") as f:\n                            json.dump(progress, f, ensure_ascii=False, indent=2)\n            except Exception as e:\n                print(f\"Error {t['name']}: {e}\", flush=True)\n                \n    with open(out_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(progress, f, ensure_ascii=False, indent=2)\n    print(f\"\\nMASTER PIPELINE COMPLETE! Matched: {matched_count} / {len(targets)}\", flush=True)\n\nif __name__ == \"__main__\":\n    run_master()\n","Description":"Master search pipeline for all 318 target companies","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\cc5f8116-f40f-4d66-a990-d85efe7bc64f\\scratch\\master_search_pipeline.py","toolAction":"Writing master search pipeline","toolSummary":"Write master_search_pipeline.py"}}]}
