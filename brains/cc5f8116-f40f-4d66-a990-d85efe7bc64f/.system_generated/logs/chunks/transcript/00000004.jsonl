= []\\n    seen = set()\\n    for p in posts:\\n        art_match = re.search(r'href=[\\\"\\\\']/article/(\\\\d{10})[\\\"\\\\']', p)\\n        if not art_match: continue\\n        art_id = art_match.group(1)\\n        if art_id in seen: continue\\n        seen.add(art_id)\\n        \\n        title_match = re.search(r'<h[34][^>]*>(.*?)</h[34]>', p)\\n        title = re.sub(r'<[^>]+>', '', title_match.group(1)).strip() if title_match else \\\"\\\"\\n        \\n        p_match = re.search(r'<p>([\\\\s\\\\S]*?)</p>', p)\\n        addr_snip = re.sub(r'\\\\s+', ' ', re.sub(r'<[^>]+>', '', p_match.group(1))).strip() if p_match else \\\"\\\"\\n        \\n        results.append({\\n            \\\"biz_no_10\\\": art_id,\\n            \\\"title\\\": title,\\n            \\\"addr_snip\\\": \n<truncated 9349 bytes>","Description":"\"Secondary pass to resolve unmatched targets via phone and variations\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\cc5f8116-f40f-4d66-a990-d85efe7bc64f\\\\scratch\\\\resolve_unmatched.py\"","toolAction":"\"Writing secondary resolver\"","toolSummary":"\"Write resolve_unmatched.py\""}}],"truncated_fields":["tool_calls"]}
