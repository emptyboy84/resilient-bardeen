 phone:', hasPhone, `(${(hasPhone/totalData*100).toFixed(1)}%)`);\\n  console.log('Missing phone:', missingPhone.length, `(${(missingPhone.length/totalData*100).toFixed(1)}%)`);\\n\\n  fs.writeFileSync('cretap_missing_phone_targets.json', JSON.stringify(missingPhone, null, 2), 'utf8');\\n}\\nanalyze();\\n\\\"\"","Cwd":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\worktrees\\\\resilient-bardeen\\\\find_company_phone_numbers\"","WaitMsBeforeAsync":"10000","toolAction":"\"Analyzing full dataset\"","toolSummary":"\"Analyze cretop 3978 companies\""}}]}
