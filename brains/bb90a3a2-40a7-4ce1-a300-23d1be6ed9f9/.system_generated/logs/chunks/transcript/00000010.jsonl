| p === '010-0000-0000') return null;\\n\\n  // Tax office check\\n  if (TAX_OFFICE_NUMBERS.has(p)) return null;\\n  if (/^051-[0-9]{3}-(?:0200|2200|6200|7200|9200)$/.test(p)) return null;\\n\\n  // If context explicitly mentions 세무서 around the phone, reject\\n  if (contextText) {\\n    const idx = contextText.indexOf(raw);\\n    if (idx !== -1) {\\n      const near = contextText.substring(Math.max(0, idx - 80), Math.min(contextText.length, idx + 80));\\n      if (near.includes('세무서') || near.includes('국세청') || near.includes('관할')) return null;\\n    }\\n  }\\n\\n  // Exclude invalid CS & portal numbers\\n  const invalidCS = [\\n    '02-15\n<truncated 8812 bytes>","Description":"\"Upgraded full multi-platform scanner with tax office blacklist and context cleaning\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\worktrees\\\\resilient-bardeen\\\\find_company_phone_numbers\\\\run_stage4_full_scan.js\"","toolAction":"\"Updating full scan script\"","toolSummary":"\"Update run_stage4_full_scan.js with tax office filters\""}}],"truncated_fields":["tool_calls"]}
