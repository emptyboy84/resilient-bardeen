{"step_index":201,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-14T00:41:42Z","content":"Created At: 2026-10-14T09:41:42+09:00\nCompleted At: 2026-10-14T09:41:42+09:00\nFile Path: `file:///C:/Users/lg/.gemini/antigravity/worktrees/resilient-bardeen/find_company_phone_numbers/full_cretap_batch.js`\nTotal Lines: 115\nTotal Bytes: 3922\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: const fs = require('fs');\n2: \n3: function isValidKoreanPhone(phone) {\n4:   if (!phone) return false;\n5:   const p = phone.trim().replace(/[^0-9\\-]/g, '');\n6:   \n7:   const regex = /^(02|03[1-3]|04[1-4]|05[1-5]|06[1-4]|070|01[016789])-[0-9]{3,4}-[0-9]{4}$|^(15[0-9]{2}|16[0-9]{2}|18[0-9]{2})-[0-9]{4}$|^(050[0-9]?)-[0-9]{3,4}-[0-9]{4}$/;\n8:   if (!regex.test(p)) return false;\n9: \n10:   // 사업자번호 패턴(3-2-5 형식) 방지\n11:   if (/^[0-9]{3}-[0-9]{2}-[0-9]{5}$/.test(p)) return false;\n12:   if (p === '02-1577-0000' || p === '1577-0000') return false;\n13:   \n14:   return true;\n15: }\n16: \n17: function cleanPhonePrefix(phone) {\n18:   if (!phone) return '';\n19:   // 02-15xx, 02-16xx, 051-16xx\n20:   const m = phone.match(/^(?:02|051|031)-(1[568][0-9]{2}-[0-9]{4})$/);\n21:   if (m) return m[1];\n22:   return phone;\n23: }\n24: \n25: async function fetchBizno(bizNo) {\n26:   const clean = bizNo.replace(/[^0-9]/g, '');\n27:   if (clean.length !== 10) return null;\n28: \n29:   const url = 'https://bizno.net/article/' + clean;\n30:   try {\n31:     const res = await fetch(url, {\n32:       headers: {\n33:         'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n34:       }\n35:     });\n36:     if (!res.ok) return null;\n37:     const html = await res.text();\n38: \n39:     const thMatch = html.match(/<th>전화번호<\\/th>\\s*<td[^>]*>([\\s\\S]*?)<\\/td>/i);\n40:     if (thMatch) {\n41:       const inner = thMatch[1];\n42:       if (inner.includes('세무서')) return null;\n43: \n44:       const telMatch = inner.match(/<a href=['\"]tel:([^'\"]+)['\"]/) || inner.match(/([0-9]{2,4}-[0-9]{3,4}-[0-9]{4}|1[0-9]{3}-[0-9]{4})/);\n45:       if (telMatch) {\n46:         let candidate = telMatch[1].trim();\n47:         candidate = cleanPhonePrefix(candidate);\n48:         if (isValidKoreanPhone(candidate)) {\n49:           return candidate;\n50:         }\n51:       }\n52:     }\n53:   } catch (e) {\n54:     // network error\n55:   }\n56:   return null;\n57: }\n58: \n59: async function runFullBatch() {\n60:   const targets = JSON.parse(fs.readFileSync('cretap_missing_phone_targets.json', 'utf8'));\n61:   console.log(`Starting Full Batch check for ${targets.length} missing companies...`);\n62: \n63:   const results = {};\n64:   // Load existing step1 if available\n65:   if (fs.existsSync('step1_results.json')) {\n66:     const prev = JSON.parse(fs.readFileSync('step1_results.json', 'utf8'));\n67:     for (const [k, v] of Object.entries(prev)) {\n68:       if (v.bizNo && v.phone) {\n69:         const cleanBiz = v.bizNo.replace(/[^0-9]/g, '');\n70:         results[cleanBiz] = v.phone;\n71:       }\n72:     }\n73:   }\n74:   // Load progress file if exists\n75:   if (fs.existsSync('full_cretap_results.json')) {\n76:     Object.assign(results, JSON.parse(fs.readFileSync('full_cretap_results.json', 'utf8')));\n77:   }\n78: \n79:   console.log(`Initial cached phones available: ${Object.keys(results).length}`);\n80: \n81:   const batchSize = 6;\n82:   let newFoundCount = 0;\n83: \n84:   for (let i = 0; i < targets.length; i += batchSize) {\n85:     const batch = targets.slice(i, i + batchSize);\n86:     await Promise.all(batch.map(async (item) => {\n87:       const cleanBiz = item.bizNo.replace(/[^0-9]/g, '');\n88:       if (cleanBiz.length !== 10) return;\n89:       if (results[cleanBiz]) return; // already found\n90: \n91:       const phone = await fetchBizno(item.bizNo);\n92:       if (phone) {\n93:         results[cleanBiz] = phone;\n94:         newFoundCount++;\n95:         if (newFoundCount <= 20 || newFoundCount % 50 === 0) {\n96:           console.log(`[FOUND ${newFoundCount}] Seq ${item.seq} ${item.name} -> ${phone}`);\n97:         }\n98:       }\n99:     }));\n100: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
