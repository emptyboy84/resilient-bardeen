?/i);\n    console.log('Seller ID match:', sellerInfoId ? sellerInfoId[1] : 'NONE');\n    // find popup\n    const popupUrls = html.match(/https?:\\/\\/[^\"'\\s]+seller[^\"'\\s]+/gi);\n    console.log('Popup URLs:', popupUrls);\n  } catch(e) {\n    console.log('SSG err:', e.message);\n  }\n}\n\ntestGrb();\n","Description":"Test GRB details across Bizno, Saramin, and SSG","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\find_company_phone_numbers\\test_grb.js","toolAction":"Creating test_grb.js","toolSummary":"Create test_grb.js"}}]}
