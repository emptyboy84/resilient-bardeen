n table for top newly found\nconsole.log('| 순번 | 기업명 | 대표자명 | 사업자번호 | 검증 전화번호 | 주소 |');\nconsole.log('| :---: | :--- | :---: | :---: | :---: | :--- |');\nnewlyFound.forEach(item => {\n  console.log(`| ${item.seq} | ${item.name} | ${item.ceo} | ${item.bizNo} | **${item.phone}** | ${item.address} |`);\n});\n","Description":"Extract newly found phone list","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\worktrees\\resilient-bardeen\\find_company_phone_numbers\\extract_newly_found.js","toolAction":"Extracting newly found items","toolSummary":"Write extract_newly_found.js"}}]}
