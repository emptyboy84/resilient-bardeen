8802742');\n  console.log('Bizno status:', res.status);\n  const desc = res.body.match(/<meta name=\"description\" content=\"([^\"]+)\"/);\n  console.log('Bizno description:', desc ? desc[1] : 'No desc');\n  \n  const lines = res.body.split('\\n');\n  lines.forEach(l => {\n    if (l.includes('종업원') || l.includes('대표자') || l.includes('회사주소') || l.includes('업태') || l.includes('업종')) {\n      console.log('Bizno line:', l.trim());\n    }\n  });\n}\n\nasync function main() {\n  await checkExcel();\n  await checkBizno();\n}\n\nmain().catch(console.error);\n","Description":"Check Excel and Bizno for 케이안전기술원","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\0206a2db-975c-4d12-aa6b-790955bb4219\\scratch\\check_k_safety.js","toolAction":"Writing check script","toolSummary":"Write script to check 케이안전기술원"}}]}
