e, \"유효\"\n    else:\n        return False, f\"체크섬 불일치 (기대값:{chk}, 입력값:{digits[9]})\"\n\ndef validate_corp_no(val):\n    clean = re.sub(r'[^0-9]', '', val)\n    if not clean:\n        return True, \"미기재\"\n    if len(clean) != 13:\n        return False, f\"자릿수 오류 ({len(clean)}자리)\"\n    weights = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2]\n    digits = [int(c) for c in clean]\n    s = sum(digits[i] * weights[i] for i in range(12))\n    chk = (10 - (s % 10)) % 10\n    if digits[12] == chk:\n        return True, \"유효\"\n    el