rint(f\"법인번호 오류: [행 {item['row']}] {item['name']} -> {item['corp_no']} ({item['reason']})\")\n\n","Description":"Generate detailed validation printout","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\6849e270-cdbb-4526-97ab-99f7d77523f7\\scratch\\print_details.py","toolAction":"Generating details","toolSummary":"Print detailed validation summary"}}]}
