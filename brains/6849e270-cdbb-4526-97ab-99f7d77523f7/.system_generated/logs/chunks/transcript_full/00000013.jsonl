       'ceo': row_vals[4],\n            'zip_c': row_vals[5],\n            'addr': row_vals[6],\n            'phone': row_vals[7],\n            'fax': row_vals[8],\n            'homepage': row_vals[9],\n            'email': row_vals[10],\n            'emp': row_vals[11],\n            'nice_ind': row_vals[12],\n            'corp_no': row_vals[13],\n            'settle': row_vals[14],\n            'ind_l': row_vals[15],\n            'ind_m': row_vals[16],\n            'ind_s': row_vals[17]\n        })\n\nprint(f\"Total extracted rows for 배현명: {len(bhm_rows)}\")\nwith open(r'C:\\Users\\lg\\.gemini\\antigravity\\brain\\6849e270-cdbb-4526-97ab-99f7d77523f7\\scratch\\bhm_1000_raw.json', 'w', encoding='utf-8') as f:\n    json.dump(bhm_rows, f, ensure_ascii=False, indent=2)\n\nprint(\"Saved bhm_1000_raw.json successfully.\")\n","Description":"Extract all 1,000 rows for 배현명","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\6849e270-cdbb-4526-97ab-99f7d77523f7\\scratch\\extract_bhm_1000.py","toolAction":"Extracting 1,000 rows","toolSummary":"Run extract_bhm_1000.py"}}]}
