{"step_index":105,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-08-31T01:09:55Z","thinking":"Observed discrepancies between table data and summary fields: masking is inconsistent. The table masks certain data like phone number, representative name, and address, yet the `summaryFields` presents this data unmasked, and also includes additional unmasked information. This suggests a potential data processing error during the summary generation phase, where masking was either bypassed or applied inconsistently.\n\n\nAnalyzing field mapping for TSV output. Determined the logic for '상태' based on Bizno data ('폐업자', '계속사업자', '휴업'). Established priorities for '상호명 / 기업명' using Bizno data if original is missing. Confirmed 사업자등록번호 is 10 digits. Defined logic to extract representative name by prioritizing unmasked values from Bizno, table, and summary, explicitly excluding masked data.\n\n\nFocusing on data cleaning and priority. Considering the handling of masked data, aiming to exclude all values containing asterisks or double asterisks and prioritizing Bizno data when available and unmasked. Planning to apply these rules to various fields, including representative name, address, phone number, fax, website, email, and industry type, to ensure data accuracy.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Script to test and validate full data enrichment","UserFacing":false},"CodeContent":"const fs = require('fs');\nconst path = require('path');\n\nconst rawFile = 'C:/Users/lg/.gemini/antigravity/brain/fc47ed12-b523-4d84-9421-40e6756ddcef/scratch/input_raw.txt';\nconst cacheDir = 'C:/Users/lg/.gemini/antigravity/brain/fc47ed12-b523-4d84-9421-40e6756ddcef/scratch/cache';\n\nconst lines = fs.readFileSync(rawFile, 'utf8').split(/\\r?\\n/).filter(l => l.trim().length > 0);\n\nfunction cleanText(txt) {\n  if (!txt) return '';\n  return txt.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\n}\n\nfunction parseSummary(summary) {\n  const result = {};\n  if (!summary) return result;\n\n  const keys = [\n    '회사명(영문)', '영문회사명', '주요제품', '기업규모', '과세유형', '법인형태', '본사/지사',\n    '홈페이지', 'IR홈페이지', '업종분류', '업태', '업종', '사업자 현재 상태(※국세청 홈택스 실시간 정보제공)',\n    '사업자 현재 상태', '설립일(신고/인허가일)', '설립일', '등록일', '대표자명', '전화번호', '팩스번호',\n    '회사주소', '종업원수', '사업자등록번호', '법인등록번호', '관할세무서', '결산월', '회사이메일', '이메일'\n  ];\n\n  const keyPattern = new RegExp(`(${keys.map(k => k.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('|')})\\\\s*:`, 'g');\n  \n  let matches = [];\n  let m;\n  while ((m = keyPattern.exec(summary)) !== null) {\n    matches.push({ key: m[1], index: m.index, length: m[0].length });\n  }\n\n  for (let i = 0; i < matches.length; i++) {\n    const current = matches[i];\n    const valStart = current.index + current.length;\n    const valEnd = (i + 1 < matches.length) ? matches[i + 1].index : summary.length;\n    const val = summary.substring(valStart, valEnd).trim();\n    result[current.key] = val;\n  }\n\n  return result;\n}\n\nfunction parseBiznoHtml(html) {\n  if (!html || html.includes('사업자 정보가 없습니다')) {\n    return null;\n  }\n\n  const result = {\n    tableFields: {},\n    summaryFields: {},\n    industryNts: {}\n  };\n\n  const h1Match = html.match(/<div class=\"titles\">[\\s\\S]*?<h[1-4]>([\\s\\S]*?)<\\/h[1-4]>/i);\n  if (h1Match) {\n    result.companyName = cleanText(h1Match[1]);\n  }\n\n  const summaryMatch = html.match(/summary=\"([^\"]+)\"/i);\n  if (summaryMatch) {\n    result.summaryRaw = summaryMatch[1];\n    result.summaryFields = parseSummary(summaryMatch[1]);\n  }\n\n  const rowRegex = /<tr[^>]*>\\s*<th[^>]*>([\\s\\S]*?)<\\/th>\\s*<td[^>]*>([\\s\\S]*?)<\\/td>\\s*<\\/tr>/gi;\n  let rm;\n  while ((rm = rowRegex.exec(html)) !== null) {\n    const key = cleanText(rm[1]);\n    const rawTd = rm[2];\n    \n    if (key.includes('국세청산업분류')) {\n      const pMatches = rawTd.match(/<p>([\\s\\S]*?)<\\/p>/gi);\n      if (pMatches) {\n        pMatches.forEach(p => {\n          const txt = cleanText(p);\n          const parts = txt.split(':');\n          if (parts.length === 2) {\n            result.industryNts[parts[0].trim()] = parts[1].trim();\n          }\n        });\n      }\n    }\n\n    let tdText = rawTd.replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n                      .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n                      .replace(/<br\\s*\\/?>/gi, ' ')\n                      .replace(/<\\/p>/gi, ' ')\n                      .replace(/<[^>]+>/g, ' ')\n                      .replace(/&nbsp;/g, ' ')\n                      .replace(/\\s+/g, ' ')\n                      .trim();\n    result.tableFields[key] = tdText;\n  }\n\n  const hpAnchor = html.match(/<th>홈페이지<\\/th>\\s*<td>[\\s\\S]*?<a\\s+href=\"([^\"]+)\"[^>]*>/i);\n  if (hpAnchor && hpAnchor[1] && !hpAnchor[1].startsWith('/') && !hpAnchor[1].startsWith('#')) {\n    result.homepageUrl = hpAnchor[1].trim();\n  }\n\n  return result;\n}\n\nfunction isValid(str) {\n  if (!str) return false;\n  str = str.trim();\n  if (str === '' || str === '-' || str === '*' || str === '.' || str === '폐업') return false;\n  if (str.includes('*')) return false; // reject masked data\n  return true;\n}\n\nfunction cleanVal(str) {\n  if (!str) return '';\n  str = str.trim();\n  if (str === '-' || str === '*' || str === '.') return '';\n  if (str.includes('*')) return ''; // reject masked data\n  return str;\n}\n\nfunction cleanPhone(str) {\n  if (!str) return '';\n  let cleaned = str.replace(/\\(※[^\\)]*\\)/g, '').replace(/[^0-9\\-~,\\s]/g, '').trim();\n  if (cleaned.includes('*') || cleaned === '-' || cleaned === '.' || cleaned.length < 7) return '';\n  return cleaned;\n}\n\nfunction cleanEmpCount(str) {\n  if (!str) return '';\n  if (str.includes('*') || str === '-') return '';\n  str = str.replace(/명/g, '').trim();\n  return str;\n}\n\nfunction cleanUrl(str) {\n  if (!str) return '';\n  if (str === '-' || str.includes('*')) return '';\n  let url = str.trim();\n  if (!url.startsWith('http://') && !url.startsWith('https://')) {\n    url = 'http://' + url;\n  }\n  return url;\n}\n\nfunction cleanAddr(addr) {\n  if (!addr || addr.includes('*') || addr === '-') return '';\n  // sometimes Bizno appends english address or lot address\n  // e.g. \"경상북도 구미시 신시로 80-1 (송정동)\"\n  // or \"부산광역시 사하구 을숙도대로 559 559, Eulsukdo-daero...\"\n  let cleaned = addr.replace(/\\(폐업자는 주소 일부가 \\*\\* 표시됩니다\\)/g, '').trim();\n  if (cleaned.includes('*')) return '';\n  return cleaned;\n}\n\n// Process all rows\nconst outputRows = [];\nlet enrichedCount = 0;\n\nlines.forEach((line, idx) => {\n  const p = line.split('\\t');\n  while (p.length < 18) p.push('');\n  \n  const bno = (p[3] || '').replace(/[^0-9]/g, '');\n  const cachePath = path.join(cacheDir, `${bno}.html`);\n  let biz = null;\n  if (fs.existsSync(cachePath)) {\n    biz = parseBiznoHtml(fs.readFileSync(cachePath, 'utf8'));\n  }\n\n  const out = [...p]; // clone original 18 columns\n\n  // Column 0: 담당자 (배현명)\n  out[0] = p[0] || '배현명';\n\n  if (biz) {\n    enrichedCount++;\n    const t = biz.tableFields || {};\n    const s = biz.summaryFields || {};\n    const ind = biz.industryNts || {};\n\n    // Column 1: 상태 (폐업 여부)\n    const bizStatus = s['사업자 현재 상태(※국세청 홈택스 실시간 정보제공)'] || t['사업자 현재 상태'] || '';\n    if (bizStatus.includes('폐업')) {\n      out[1] = '폐업';\n    } else if (bizStatus.includes('휴업')) {\n      out[1] = '휴업';\n    } else if (bizStatus.includes('계속사업자') || bizStatus.includes('정상')) {\n      if (out[1] === '폐업' && !bizStatus.includes('폐업')) {\n        // If Bizno says 계속사업자, clear 폐업\n        out[1] = '';\n      }\n    }\n\n    // Column 2: 상호명\n    // Keep original unless empty\n    if (!out[2] && biz.companyName) {\n      out[2] = biz.companyName;\n    }\n\n    // Column 3: 사업자등록번호\n    out[3] = bno;\n\n    // Column 4: 대표자명 (unmasked only)\n    const repCandidate = s['대표자명'] || t['대표자명'] || '';\n    if (isValid(repCandidate)) {\n      out[4] = cleanVal(repCandidate);\n    } else if (!isValid(out[4])) {\n      out[4] = ''; // if original also masked, clear\n    }\n\n    // Column 5: 우편번호\n    const zipCandidate = t['우편번호'] || s['우편번호'] || '';\n    if (isValid(zipCandidate) && /^[0-9]{5}$/.test(zipCandidate.trim())) {\n      out[5] = zipCandidate.trim();\n    }\n\n    // Column 6: 주소 (unmasked only)\n    const addrCandidate = s['회사주소'] || t['회사주소'] || '';\n    const cleanA = cleanAddr(addrCandidate);\n    if (cleanA) {\n      out[6] = cleanA;\n    } else if (!isValid(out[6])) {\n      out[6] = '';\n    }\n\n    // Column 7: 전화번호 (unmasked only)\n    const telCandidate = cleanPhone(s['전화번호']) || cleanPhone(t['전화번호']) || cleanPhone(t['회사 전화번호']);\n    if (telCandidate) {\n      out[7] = telCandidate;\n    } else if (!isValid(out[7])) {\n      out[7] = '';\n    }\n\n    // Column 8: 팩스번호\n    const faxCandidate = cleanPhone(s['팩스번호']) || cleanPhone(t['팩스번호']) || cleanPhone(t['회사 팩스번호']);\n    if (faxCandidate) {\n      out[8] = faxCandidate;\n    } else if (!isValid(out[8])) {\n      out[8] = '';\n    }\n\n    // Column 9: 홈페이지\n    const hpCandidate = biz.homepageUrl || s['홈페이지'] || t['홈페이지'] || '';\n    if (isValid(hpCandidate) && hpCandidate !== '-') {\n      out[9] = cleanUrl(hpCandidate);\n    } else if (!isValid(out[9])) {\n      out[9] = '';\n    }\n\n    // Column 10: 회사이메일\n    const emailCandidate = s['회사이메일'] || s['이메일'] || t['회사이메일'] || t['이메일'] || '';\n    if (isValid(emailCandidate) && emailCandidate.includes('@')) {\n      out[10] = emailCandidate.trim();\n    } else if (!isValid(out[10])) {\n      out[10] = '';\n    }\n\n    // Column 11: 종업원수\n    const empCandidate = cleanEmpCount(s['종업원수']) || cleanEmpCount(t['종업원수']) || cleanEmpCount(t['상용근로자']);\n    if (empCandidate) {\n      out[11] = empCandidate;\n    }\n\n    // Column 12: 업종/종목 (NICE BizINFO / 종목 / 업종)\n    // Preference: s['업종'] / t['종 목'] / t['종목']\n    const bizItemCandidate = s['업종'] || t['종 목'] || t['종목'] || '';\n    if (isValid(bizItemCandidate) && !bizItemCandidate.includes('통신판매업번호')) {\n      out[12] = bizItemCandidate.trim();\n    } else if (bizItemCandidate.includes('통신판매업번호')) {\n      out[12] = bizItemCandidate.split('통신판매업번호')[0].trim();\n    }\n\n    // Column 13: 법인등록번호\n    const corpCandidate = s['법인등록번호'] || t['법인등록번호'] || '';\n    if (isValid(corpCandidate) && corpCandidate !== '-' && corpCandidate.length >= 13) {\n      out[13] = corpCandidate.trim();\n    }\n\n    // Column 14: 결산월\n    const settleCandidate = s['결산월'] || t['결산월'] || '';\n    if (isValid(settleCandidate) && settleCandidate !== '-') {\n      out[14] = settleCandidate.trim();\n    }\n\n    // Column 15: 대분류\n    if (ind['대분류']) {\n      out[15] = ind['대분류'];\n    }\n\n    // Column 16: 중분류\n    if (ind['중분류']) {\n      out[16] = ind['중분류'];\n    }\n\n    // Column 17: 소분류 / 비즈인포산업명\n    if (ind['소분류']) {\n      out[17] = ind['소분류'];\n    }\n  } else {\n    // If not found in bizno, clean any masked fields from original input\n    for (let c = 0; c < 18; c++) {\n      if (out[c] && out[c].includes('*')) {\n        out[c] = '';\n      }\n    }\n  }\n\n  // Final check: assure no '*' exists anywhere in any column\n  for (let c = 0; c < 18; c++) {\n    if (typeof out[c] === 'string' && out[c].includes('*')) {\n      out[c] = '';\n    }\n  }\n\n  outputRows.push(out.join('\\t'));\n});\n\nfs.writeFileSync('C:/Users/lg/.gemini/antigravity/brain/fc47ed12-b523-4d84-9421-40e6756ddcef/scratch/output.tsv', outputRows.join('\\n'), 'utf8');\n\nconsole.log(`Finished processing. Total rows: ${outputRows.length}, Enriched from Bizno: ${enrichedCount}`);\n","Description":"Enrichment and validation script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\fc47ed12-b523-4d84-9421-40e6756ddcef\\scratch\\process_all.js","toolAction":"Writing full processing script","toolSummary":"Create full processing script"}}]}
