leanPhone(s['팩스번호']) || cleanPhone(t['팩스번호']) || cleanPhone(t['회사 팩스번호']);\n    if (faxCandidate) {\n      out[8] = faxCandidate;\n    } else if (!isValid(out[8])) {\n      out[8] = '';\n    }\n\n    // Column 9: 홈페이지\n    const hpCandidate = biz.homepageUrl || s['홈페이지'] || t['홈페이지'] || '';\n    const cleanHp = cleanUrl(hpCandidate);\n    if (cleanHp) {\n      out[9] = cleanHp;\n    } else {\n      out[9] = cleanUrl(out[9]);\n    }\n\n    // Column 10: 회사이메일\n    const emailCandidate = s['회사이메일'] || s['이메일'] || t['회사이메일'] || t['이메일'] || '';\n    const cleanEm = cleanEmail(emailCandidate);\n    if (cleanEm) {\n      out[10] = cleanEm;\n    } else {\n      out[10] = cleanEmail(out[10]);\n    }\n\n    // Column 11: 종업원수\n    const empCandidate = cleanEmpCount(s['종업원수']) || cleanEmpCount(t['종업원수']) || cleanEmpCount(t['상용근로자']);\n    if (empCandidate) {\n      out[11] = empCandidate;\n    }\n\n    // Column 12: 업종/종목 (NICE BizINFO / 종목 / 업종)\n    const bizItemCandidate = s['업종'] || t['종 목'] || t['종목'] || '';\n    if (isValid(bizItemCandidate) && !bizItemCandidate.includes('통신판매업번호')) {\n      out[12] = bizItemCandidate.trim();\n    } else if (bizItemCandidate.includes('통신판매업번호')) {\n      out[12] = bizItemCandidate.split('통신판매업번호')[0].trim();\n    }\n\n    // Column 13: 법인등록번호\n    const corpCandidate = s['법인등록번호'] || t['법인등록번호'] || '';\n    if (isValid(corpCandidate) && corpCandidate !== '-' && corpCandidate.length >= 13) {\n      out[13] = corpCandidate.trim();\n    }\n\n    // Column 14: 결산월\n    const settleCandidate = s['결산월'] || t['결산월'] || '';\n    if (isValid(settleCandidate) && settleCandidate !== '-') {\n      out[14] = settleCandidate.trim();\n    }\n\n    // Column 15: 대분류\n    if (ind['대분류']) {\n      out[15] = ind['대분류'];\n    }\n\n    // Column 16: 중분류\n    if (ind['중분류']) {\n      out[16] = ind['중분류'];\n    }\n\n    // Column 17: 소분류 / 비즈인포산업명\n    if (ind['소분류']) {\n      out[17] = ind['소분류'];\n    }\n  } else {\n    for (let c = 0; c < 18; c++) {\n     