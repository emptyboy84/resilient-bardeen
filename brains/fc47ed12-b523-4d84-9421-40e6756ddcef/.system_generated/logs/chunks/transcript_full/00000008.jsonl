01M03Get.nice?srchNm=${bno}&srchkwrd=ALL&prn_cnt=10&pge_no=1&useOrgTotal=false`;\n    const res = await fetch(url, {\n      headers: {\n        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',\n        'Referer': 'https://www.nicebizinfo.com/ep/EP0100M001GE.nice?keyword=' + bno,\n        'Accept': 'application/json, text/plain, */*'\n      }\n    });\n    const json = await res.json();\n    const decrypted = decryptNice(json.encryptedResponse);\n    console.log(`=== BNO ${bno} ===`);\n    console.log(`Name: ${decrypted.data?.items?.[0]?.korentrnm}`);\n    console.log(`Industry (sanupscd_kor): ${decrypted.data?.items?.[0]?.sanupscd_kor}`);\n    console.log(`Representative: ${decrypted.data?.items?.[0]?.korreprnm}`);\n  }\n}\n\ntestDecryption();\n","Description":"Fixed EVP bytes to key and decryptor script","Overwrite":true,"TargetFile":"C:\\Users\\lg\\.gemini\\antigravity\\brain\\fc47ed12-b523-4d84-9421-40e6756ddcef\\scratch\\test_decrypt.js","toolAction":"Writing fixed decryptor test","toolSummary":"Create fixed test_decrypt.js"}}]}
