aned: ', cleanAddr(a));\\n  console.log('---');\\n});\\n\"","Description":"\"Address cleaning test script\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\lg\\\\.gemini\\\\antigravity\\\\brain\\\\fc47ed12-b523-4d84-9421-40e6756ddcef\\\\scratch\\\\test_clean_addr.js\"","toolAction":"\"Writing address cleaning test\"","toolSummary":"\"Create address cleaning test\""}}]}
