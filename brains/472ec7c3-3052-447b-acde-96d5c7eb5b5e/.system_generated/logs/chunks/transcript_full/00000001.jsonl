    return true;\n        }, IntPtr.Zero);\n    }\n}\n\"@\n[WindowFinder]::FindWindows(516)\n","Cwd":"c:\\Users\\lg\\fix","IsDaemon":false,"WaitMsBeforeAsync":5000,"toolAction":"Checking windows for PID 516","toolSummary":"Find Win32 windows for Antigravity process"}}]}
