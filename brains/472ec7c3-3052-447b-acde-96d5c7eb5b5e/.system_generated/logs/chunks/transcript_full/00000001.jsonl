oardAPI {\n30:     [DllImport(\"user32.dll\", SetLastError = true)]\n31:     public static extern bool OpenClipboard(IntPtr hWndNewOwner);\n32:     [DllImport(\"user32.dll\", SetLastError = true)]\n33:     public static extern bool EmptyClipboard();\n34:     [DllImport(\"user32.dll\", SetLastError = true)]\n35:     public static extern bool CloseClipboard();\n36: }\n37: \"@\n38: if ([ClipboardAPI]::OpenClipboard([IntPtr]::Zero)) {\n39:     [ClipboardAPI]::EmptyClipboard() | Out-Null\n40:     [ClipboardAPI]::CloseClipboard() | Out-Null\n41:     Write-Output \"Clipboard successfully cleared.\"\n42: } else {\n43:     Write-Output \"Failed to open clipboard to clear it.\"\n44: }\n45: \n46: Write-Output \"\"\n47: Write-Output \"==========================================\"\n48: Write-Output \"Fix completed! Please try copying in Excel.\"\n49: Write-Output \"==========================================\"\n50: Write-Output \"\"\n51: Start-Sleep -Seconds 3\n52: \nThe above content shows the entire, complete file contents of the requested file.\n"}
