:', err.message));\\n  socket.on('timeout', () => {\\n    console.log('Socket timeout');\\n    socket.destroy();\\n  });\\n});\\n\\\"\"","Cwd":"\"C:\\\\Users\\\\lg\\\\resilient-bardeen\"","WaitMsBeforeAsync":"10000","toolAction":"\"Testing SMTP deliverability for jin@srj-trade.com\"","toolSummary":"\"Verify jin@srj-trade.com\""}}]}
