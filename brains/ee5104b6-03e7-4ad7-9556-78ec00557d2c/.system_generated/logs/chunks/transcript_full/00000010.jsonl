{"step_index":424,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-01T03:48:06Z","tool_calls":[{"name":"run_command","args":{"CommandLine":"node -e \"\nconst fs = require('fs');\nconst filePath = 'C:\\\\\\\\Users\\\\\\\\lg\\\\\\\\.gemini\\\\\\\\antigravity\\\\\\\\brain\\\\\\\\ee5104b6-03e7-4ad7-9556-78ec00557d2c\\\\\\\\scratch\\\\\\\\check_74.tsv';\nconst lines = fs.readFileSync(filePath, 'utf-8').split('\\n').filter(l => l.trim().length > 0);\n\nfunction getBizType(bizno) {\n  const clean = bizno.replace(/[^0-9]/g, '');\n  if (clean.length !== 10) return 'UNKNOWN';\n  const mid = clean.substring(3, 5);\n  const midNum = Number(mid);\n  if ((midNum >= 1 && midNum <= 79) || (midNum >= 90 && midNum <= 99)) return '개인사업자';\n  if (['81', '86', '87', '88'].includes(mid)) return '영리법인본점';\n  if (mid === '85') return '영리법인지점';\n  if (mid === '82') return '비영리법인';\n  if (mid === '33') return '사내근로복지기금/협동조합/단체';\n  return '기타';\n}\n\nfunction isValidCorpNo(corpNo) {\n  if (!corpNo) return false;\n  const clean = corpNo.replace(/[^0-9]/g, '');\n  if (clean.length !== 13) return false;\n  const weights = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2];\n  let sum = 0;\n  for (let i = 0; i < 12; i++) {\n    sum += Number(clean[i]) * weights[i];\n  }\n  const remainder = sum % 10;\n  const checkDigit = (10 - remainder) % 10;\n  return Number(clean[12]) === checkDigit;\n}\n\nconst audit = lines.map((l, idx) => {\n  const p = l.split('\\t');\n  const company = (p[2] || '').trim();\n  const bizno = (p[3] || '').trim();\n  const corpNo = (p[13] || '').trim();\n  const bizType = getBizType(bizno);\n  const isCorpEntity = ['영리법인본점', '영리법인지점', '비영리법인'].includes(bizType) || company.includes('(주)') || company.includes('주식회사') || company.includes('㈜');\n  \n  return {\n    no: idx + 1,\n    company,\n    bizno,\n    corpNo,\n    bizType,\n    isCorpEntity,\n    hasCorpNo: !!corpNo,\n    validCheckDigit: isValidCorpNo(corpNo)\n  };\n});\n\nconsole.log('=== 74개 기업 법인번호 전수 분석 ===');\nconst withCorpNo = audit.filter(a => a.hasCorpNo);\nconst missingCorpNo = audit.filter(a => a.isCorpEntity && !a.hasCorpNo);\nconst individualWithCorpNo = audit.filter(a => !a.isCorpEntity && a.hasCorpNo);\nconst checkDigitFailed = audit.filter(a => a.hasCorpNo && !a.validCheckDigit);\nconst valid = audit.filter(a => a.hasCorpNo && a.validCheckDigit);\n\nconsole.log('총 기업 수:', audit.length);\nconsole.log('법인번호 기재:', withCorpNo.length, '개');\nconsole.log('정상 유효 번호:', valid.length, '개');\nconsole.log('법인인데 법인번호 누락(빈값):', missingCorpNo.length, '개');\nconsole.log('개인사업자인데 법인번호 기재:', individualWithCorpNo.length, '개');\nconsole.log('체크섬 불일치:', checkDigitFailed.length, '개');\n\nconsole.log('\\\\n[1. 법인인데 법인번호가 누락된 목록]:');\nmissingCorpNo.forEach(m => console.log(\\`[\\${m.no}번] \\${m.company} (사업자: \\${m.bizno}, 유형: \\${m.bizType})\\`));\n\nconsole.log('\\\\n[2. 개인사업자인데 법인번호 기재된 목록]:');\nindividualWithCorpNo.forEach(m => console.log(\\`[\\${m.no}번] \\${m.company} (사업자: \\${m.bizno}, 기재번호: \\${m.corpNo})\\`));\n\nconsole.log('\\\\n[3. 기재된 법인번호 전체 목록 (유효성 체크)]:');\nwithCorpNo.forEach(m => {\n  console.log(\\`[\\${m.no}번] \\${m.company} | \\${m.bizno} | \\${m.corpNo} | \\${m.validCheckDigit ? '✅ 정상' : '⚠️ 확인필요'}\\`);\n});\n\"","Cwd":"c:\\Users\\lg\\resilient-bardeen","WaitMsBeforeAsync":3000,"toolAction":"Auditing 74 companies numbers","toolSummary":"Audit corporate numbers from check_74.tsv"}}]}
