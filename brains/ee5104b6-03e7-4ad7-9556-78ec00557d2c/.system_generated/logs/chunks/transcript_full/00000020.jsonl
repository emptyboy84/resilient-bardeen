니다.\"}},{\"@type\":\"Question\",\"name\":\"디아트워크 주소가 어떻게 되나요?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"디아트워크의 주소는 부산광역시 해운대구 센텀중앙로 90 (센텀) 입니다. 부산광역시 해운대구 재송동 지역에 위치해 있습니다.\"}},{\"@type\":\"Question\",\"name\":\"디아트워크 오시는 길을 알려주세요\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"디아트워크는 부산광역시 해운대구 센텀중앙로 90에 위치해 있습니다. 해운대구 지역이며, 정확한 위치는 지도를 참고하시거나, 네비게이션에 '디아트워크'를 검색하시면 됩니다.\"}}]}</script>\n338: \n339:     <link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" media=\"print\" onload=\"this.media='all'\">\n340:     <script defer src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n341: \n342:     <!-- 댓글 첨부 영상 플레이어 CSS/JS는 footer.php에서 공용 로드 -->\n343:         <script defer src=\"https://cdn.udanax.org/js/place-core_v36.min.js\"></script>\n344:             <script defer src=\"https://cdn.udanax.org/js/semantic-profile_v7.min.js\"></script>\n345:     \n346:     <style>\n347: @media (min-width: 1025px) {\n348:     /* 탭 네비게이션 숨김 */\n349:     .place-tab-nav {\n350:         display: none !important;\n351:     }\n352: \n353:     /* 모든 탭 패널 표시 */\n354:     .place-tab-panel {\n355:         display: block !important;\n356:         opacity: 1 !important;\n357:         visibility: visible !important;\n358:     }\n359: \n360:     /* FAB 버튼 숨김 (이미 있지만 명시적으로) */\n361:     #global-fab-wrapper {\n362:         display: none !important;\n363:     }\n364: }\n365: @media (min-width: 1025px) {\n366:     /* 스토리 탭 패널 데스크탑에서는 숨김 (모바일 전용) */\n367:     #tab-panel-story {\n368:         display: none !important;\n369:     }\n370:     .story-banner-desktop { display: block; }\n371:     .story-banner-mobile  { display: none; }\n372: }\n373: @media (max-width: 1024px) {\n374:     .story-banner-desktop { display: none; }\n375:     .story-banner-mobile  { display: block; }\n376: }\n377: \n378: @keyframes sophisticated-shimmer {\n379:     0% {\n380:         left: -150%;\n381:         opacity: 0;\n382:     }\n383:     10% {\n384:         opacity