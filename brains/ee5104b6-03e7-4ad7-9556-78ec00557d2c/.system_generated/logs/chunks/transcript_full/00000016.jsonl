ill;\n    }\n    if (p[17]) {\n      row.getCell(50).value = p[17];\n      row.getCell(50).fill = orangeFill;\n    }\n    \n    row.commit();\n    updatedCount++;\n  }\n  \n  console.log('Successfully committed ' + updatedCount + ' rows to worksheet.');\n  \n  console.log('Writing to temporary file...');\n  const tempPath = filePath + '.tmp';\n  await workbook.xlsx.writeFile(tempPath);\n  \n  if (fs.existsSync(filePath)) {\n    fs.unlinkSync(filePath);\n  }\n  fs.renameSync(tempPath, filePath);\n  console.log('File successfully updated and replaced at:', filePath);\n  \n  // Also copy to repo\n  const repoCopy = 'c:/Users/lg/resilient-bardeen/data/(데이터검증팀)실사 DB 취합_전달용_260720_배현명.xlsx';\n  fs.copyFileSync(filePath, repoCopy);\n  console.log('Synced to git repo data directory.');\n}\n\napplyPerfectMergedData().catch(console.error);\n\"","Cwd":"c:\\Users\\lg\\resilient-bardeen","WaitMsBeforeAsync":5000,"toolAction":"Applying perfect merged data to Excel","toolSummary":"Update Excel with merged_500_perfect.tsv"}}]}
